00851A E0                MOVX     A,@DPTR
00851B 4408              ORL      A,#08H
00851D F0                MOVX     @DPTR,A
  674: 
  675: 
  676:     /***************************************************************************
  677:     * The wake count defines the number of Bus Clock cycles it takes for the
  678:     * flash or EEPROM to wake up from a low power mode independent of the chip
  679:     * power mode. Wake up time for these blocks is 5 us.
  680:     * The granularity of this register is 2 Bus Clock cycles, so a value of 0x1E
  681:     * (30d) defines the wake up time as 60 cycles of the Bus Clock.
  682:     * This register needs to be written with a value dependent on the Bus Clock
  683:     * frequency so that the duration of the cycles is equal to or greater than
  684:     * the 5 us delay required.
  685:     ***************************************************************************/
  686:     CY_FLASH_SPC_FM_EE_WAKE_CNT_REG = CY_FLASH_SPC_FM_EE_WAKE_CNT_80MHZ;
00851E 904701            MOV      DPTR,#04701H
008521 74C8              MOV      A,#0C8H
008523 F0                MOVX     @DPTR,A
  687: 
  688: 
  689:     /***************************************************************************
  690:     * Enable EEPROM. Re-enabling an EEPROM macro takes 5us. During this time,
  691:     * the EE will not acknowledge a PHUB request.
  692:     ***************************************************************************/
  693:     CY_FLASH_PM_ACT_CFG12_REG    |= CY_FLASH_PM_ACT_CFG12_EN_EE;
008524 9043AC            MOV      DPTR,#043ACH
008527 E0                MOVX     A,@DPTR
008528 4410              ORL      A,#010H
00852A F0                MOVX     @DPTR,A
