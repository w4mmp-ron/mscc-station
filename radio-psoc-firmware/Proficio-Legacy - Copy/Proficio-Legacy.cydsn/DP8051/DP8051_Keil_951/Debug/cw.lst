 157          uint8 keyer_write(uint8_t buffer)
 158          {
 159   1              uint8_t msg_buffer = 0;
 160   1              uint8_t ret_status = 0;
 161   1              uint8_t write_status = 0;
 162   1          uint8 buffer_written = 0;
 163   1          uint8 attempt;
 164   1      
 165   1          /*
 166   1           * PIC may NACK while busy (e.g. EEPROM write on STORE_END). Retry a few
 167   1           * times so a following PLAY is not dropped and keyer not marked missing.
 168   1           */
 169   1          msg_buffer = buffer;
 170   1          for (attempt = 0; attempt < 8u; attempt++) {
 171   2              write_status = I2C_DISPLAY_MasterWriteBuf(KEYER_SLAVE_ADDRESS, &msg_buffer, 1u,
 172   2                  I2C_DISPLAY_MODE_COMPLETE_XFER);
 173   2              while ((I2C_DISPLAY_MasterStatus() & I2C_DISPLAY_MSTAT_WR_CMPLT) == 0u) {
 174   3              }
 175   2              buffer_written = I2C_DISPLAY_MasterGetWriteBufSize();
C51 COMPILER V9.51   CW                                                                    10/20/2026 11:01:07 PAGE 4   

 176   2              if (buffer_written == 1u) {
 177   3                  ret_status = 1;
 178   3                  break;
 179   3              }
 180   2              CyDelay(5u);
 181   2          }
 182   1          return ret_status;
 183   1      }
