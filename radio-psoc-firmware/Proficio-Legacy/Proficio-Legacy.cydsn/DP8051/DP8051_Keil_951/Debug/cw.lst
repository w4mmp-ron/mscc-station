 442          /*
 443           * Non-QSK first key down: AMP + PA (T/R relays) on now, I/Q blanked, and start recording
 444           * the key so the ISR can open DIN key_delay_ms later, after the relays settle.
 445           */
 446          static void cw_delay_start(void)
 447          {
 448   1          uint8_t c;
 449   1          uint8 i;
 450   1      
 451   1          if (!dac_muted) cw_dac_mute(TRUE); //normally already muted in idle
 452   1          for(i = 0; i < KEY_DELAY_BUF_SIZE; i++) key_delay_buf[i] = 0; //ISR not active yet so no race
 453   1          key_delay_ms = E_key_delay_ms;
 454   1          if (key_delay_ms < KEY_DELAY_MIN_MS) key_delay_ms = KEY_DELAY_MIN_MS;   //ISR needs key_delay_ms > DAC
             -_RISE_LEAD_MS
 455   1          key_up_ms = 0;          //Key is down now
 456   1          key_delay_busy = TRUE;
 457   1          key_delay_lo_ready = FALSE;
 458   1          rf_on = FALSE;
 459   1          rf_off_ms = 255;
 460   1          dac_req = DAC_REQ_NONE;
 461   1          key_delay_active = TRUE;
 462   1          c = Control_Read();
 463   1          c = c & ~CONTROL_AMP;    /* AMP ON (active low) */
 464   1          c = c & ~CONTROL_RX;     /* PA / T-R ON (active low) */
 465   1          c = c & ~CONTROL_DIN;    /* I/Q blank until the ISR opens it */
 466   1          Control_Write(c);
 467   1          E_cw_hold = TRUE;
 468   1      }
