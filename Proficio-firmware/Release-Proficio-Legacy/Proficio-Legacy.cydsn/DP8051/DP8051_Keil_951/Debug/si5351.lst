 223           * si5351_init(uint8_t xtal_load_c, uint32 ref_osc_freq)
 224           *
 225           * Setup communications to the Si5351 and set the crystal
 226           * load capacitance.
 227           *
 228           * xtal_load_c - Crystal load capacitance. Use the SI5351_CRYSTAL_LOAD_*PF
 229           * defines in the header file
 230           * ref_osc_freq - Crystal/reference oscillator frequency in 1 Hz increments.
 231           * Defaults to 25000000 if a 0 is used here.
 232           *
 233           */
 234          int si5351_init(uint8_t xtal_load_c, uint32 ref_osc_freq)
 235          {
 236   1              uint8_t ret = 0;
 237   1          
 238   1          //Fake Si570_Xtal so ExtIO_Si570 does not complain
C51 COMPILER V9.51   SI5351                                                                08/22/2026 15:33:28 PAGE 5   

