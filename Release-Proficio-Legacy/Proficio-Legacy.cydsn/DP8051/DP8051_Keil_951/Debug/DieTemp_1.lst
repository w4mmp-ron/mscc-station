  42          /*******************************************************************************
  43          * Function Name: DieTemp_1_Start
  44          ********************************************************************************
  45          *
  46          * Summary:
  47          *  Sends the command and parameters to the SPC to start a Die Temperature 
  48          *  reading. This function returns before the SPC finishes. 
  49          *  This function call must always be paired with a call to the DieTemp_Query()
  50          *  API to complete the Die Temperature read
  51          *
  52          * Parameters:
  53          *  void.
C51 COMPILER V9.51   DIETEMP_1                                                             08/14/2026 10:16:40 PAGE 2   

  54          *
  55          * Return:
  56          *  CYRET_STARTED if the spc command startes successfully.
  57          *  CYRET_UNKNOWN if the spc command failes.
  58          *  CYRET_LOCKED if the spc is busy.
  59          *
  60          *******************************************************************************/
  61          cystatus DieTemp_1_Start(void) 
  62          {
  63   1          cystatus status;
  64   1      
  65   1          /* Plan for failure. */
  66   1          status = CYRET_UNKNOWN;
  67   1      
  68   1          /* Power up the SPC. */
  69   1          CySpcStart();
  70   1      
  71   1          if(CySpcLock() == CYRET_SUCCESS)
  72   1          {
  73   2              #if(CY_PSOC5A)
                          if(CYRET_STARTED == CySpcGetTemp(DieTemp_1_NUMBER_OF_SAMPLES,
                                                           DieTemp_1_TIMER_PERIOD,
                                                           DieTemp_1_CLK_DIV_SELECT))
                          {
                              status = CYRET_STARTED;
                          }
                      #else
  81   2                  if(CYRET_STARTED == CySpcGetTemp(DieTemp_1_NUMBER_OF_SAMPLES))
  82   2                  {
  83   3                      status = CYRET_STARTED;
  84   3                  }
  85   2              #endif  /* (CY_PSOC5A) */
  86   2              CySpcUnlock();
  87   2          }
  88   1          else
  89   1          {
  90   2              status = CYRET_LOCKED;
  91   2          }
  92   1          return (status);
  93   1      }
