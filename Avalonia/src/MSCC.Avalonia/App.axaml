<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MSCC.Avalonia.App"
             xmlns:local="using:MSCC.Avalonia"
             xmlns:ctrl="using:MSCC.Avalonia.Controls"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <SolidColorBrush x:Key="UiWindowBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="UiPanelBackgroundBrush" Color="#252525"/>
    <SolidColorBrush x:Key="UiPrimaryTextBrush" Color="White"/>
    <SolidColorBrush x:Key="UiMutedTextBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="UiButtonFaceBrush" Color="#FFCC00"/>
    <SolidColorBrush x:Key="UiButtonBorderBrush" Color="#FFAA00"/>
    <SolidColorBrush x:Key="UiButtonHoverBrush" Color="#FFDD55"/>
    <SolidColorBrush x:Key="UiButtonTextBrush" Color="Black"/>
    <SolidColorBrush x:Key="UiButtonSelectedBrush" Color="#FFAA00"/>
    <SolidColorBrush x:Key="UiButtonSelectedBorderBrush" Color="#FF8800"/>
    <SolidColorBrush x:Key="UiAccentBrush" Color="#00FFAA"/>
    <SolidColorBrush x:Key="UiAccentMutedBrush" Color="#006B5A"/>

    <!-- Rail sliders only. Settings, S/W, Remote Audio, and cal tabs stay Fluent. -->
    <LinearGradientBrush x:Key="UiSliderTrackFillBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#050608"/>
      <GradientStop Offset="0.55" Color="#161920"/>
      <GradientStop Offset="1" Color="#2A2E36"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UiSliderTrackBorderBrush" Color="#3A404A"/>
    <SolidColorBrush x:Key="UiSliderTrackHighlightBrush" Color="#6A7382"/>
    <LinearGradientBrush x:Key="UiSliderThumbFillBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#EEF1F6"/>
      <GradientStop Offset="0.16" Color="#8B929C"/>
      <GradientStop Offset="0.38" Color="#1A1C20"/>
      <GradientStop Offset="0.78" Color="#050506"/>
      <GradientStop Offset="1" Color="#3A3F48"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UiSliderThumbBorderBrush" Color="#C5CAD3"/>
    <SolidColorBrush x:Key="UiSliderValueBrush" Color="#FFE14A"/>

    <!-- Light-bar buttons (band, mode, filter/step, left/right panels). Tabs stay gold. -->
    <LinearGradientBrush x:Key="UiBarFaceBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#3C424C"/>
      <GradientStop Offset="0.5" Color="#1C1F24"/>
      <GradientStop Offset="1" Color="#0B0C0E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UiBarFaceHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#4A515C"/>
      <GradientStop Offset="0.5" Color="#262A31"/>
      <GradientStop Offset="1" Color="#15171B"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UiBarFacePressedBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#101114"/>
      <GradientStop Offset="0.5" Color="#1A1D22"/>
      <GradientStop Offset="1" Color="#24282E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UiBarShineBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#55FFFFFF"/>
      <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UiBarOutlineBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="UiBarEdgeTopBrush" Color="#66707A86"/>
    <SolidColorBrush x:Key="UiBarEdgeBottomBrush" Color="#CC000000"/>
    <SolidColorBrush x:Key="UiBarEdgeSideBrush" Color="#59000000"/>
    <SolidColorBrush x:Key="UiBarSlotOffBrush" Color="#3A3D42"/>
    <LinearGradientBrush x:Key="UiBarSlotOnBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#8CC8FF"/>
      <GradientStop Offset="0.5" Color="#2E8BFF"/>
      <GradientStop Offset="1" Color="#1A5FD0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UiBarSlotTxBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#FF6B60"/>
      <GradientStop Offset="1" Color="#E53935"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UiBarTextBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="UiBarTextTxBrush" Color="#FF8A80"/>
    <SolidColorBrush x:Key="UiBarTextDisabledBrush" Color="#8A8A8A"/>

    <!-- VFO LCD. Skins swap these brushes by key. -->
    <!-- Also used by the S-meter and ALC frames. -->
    <SolidColorBrush x:Key="UiVfoBezelBrush" Color="#FF101214"/>
    <RadialGradientBrush x:Key="UiVfoLcdBrush" Center="50%,40%" GradientOrigin="50%,40%" RadiusX="70%" RadiusY="70%">
      <GradientStop Offset="0" Color="#FFFFF4C4"/>
      <GradientStop Offset="1" Color="#FFE3CF7C"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="UiVfoLcdShadeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#59000000"/>
      <GradientStop Offset="1" Color="#00000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UiVfoBevelDarkBrush" Color="#E0000000"/>
    <SolidColorBrush x:Key="UiVfoBevelLightBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="UiVfoDigitBrush" Color="#FF1E1C12"/>
    <SolidColorBrush x:Key="UiVfoDigitHzBrush" Color="#FF3C3824"/>
    <SolidColorBrush x:Key="UiVfoLabelBrush" Color="#FF5A5438"/>
    <SolidColorBrush x:Key="UiVfoModeBrush" Color="#FF1E1C12"/>
    <SolidColorBrush x:Key="UiVfoStripBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="UiVfoStripTextBrush" Color="#FF2A281A"/>
    <RadialGradientBrush x:Key="UiVfoActiveDotBrush" Center="50%,50%" GradientOrigin="40%,35%" RadiusX="55%" RadiusY="55%">
      <GradientStop Offset="0" Color="#FFFF5A4A"/>
      <GradientStop Offset="1" Color="#FFB01818"/>
    </RadialGradientBrush>

    <!-- ===== Faceplate (UiFace*) =====
         Skin: Steel (default). Later presets (not in this command): Dark, Olive — swap these keys only.
         Light source: above (matches light-bar buttons, cmd-097b): lighter high-center, darker edges. -->
    <RadialGradientBrush x:Key="UiFaceBaseBrush" Center="50%,30%" GradientOrigin="50%,22%" RadiusX="85%" RadiusY="95%">
      <GradientStop Offset="0"    Color="#FF4E5C6D"/>
      <GradientStop Offset="0.55" Color="#FF3E4A58"/>
      <GradientStop Offset="1"    Color="#FF262E38"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="UiFaceSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0"    Color="#1FFFFFFF"/>
      <GradientStop Offset="0.006" Color="#10FFFFFF"/>
      <GradientStop Offset="0.35" Color="#00FFFFFF"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="UiFaceVignetteBrush" Center="50%,45%" GradientOrigin="50%,45%" RadiusX="75%" RadiusY="80%">
      <GradientStop Offset="0.6" Color="#00000000"/>
      <GradientStop Offset="1"   Color="#59000000"/>
    </RadialGradientBrush>
    <ImageBrush x:Key="UiFaceTextureBrush" Source="avares://MSCC.Avalonia/Assets/face-brushed.png"
                TileMode="Tile" Stretch="None" DestinationRect="0,0,256,256" Opacity="0.55"/>
    <SolidColorBrush x:Key="UiFaceHeadingBrush" Color="#FFEEF2F6"/>
    <Color x:Key="UiFaceHeadingShadowColor">#C0000000</Color>
    <SolidColorBrush x:Key="UiFaceLabelBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="UiFaceMutedTextBrush" Color="#FFD4DCE4"/>
    <SolidColorBrush x:Key="UiFaceWarnTextBrush" Color="#FFFFD08A"/>
    <SolidColorBrush x:Key="UiFaceOkTextBrush" Color="#FFA8EBC8"/>
    <!-- Tab well: etched groove, light from above (dark line, light line under it). -->
    <SolidColorBrush x:Key="UiFaceEtchDarkBrush" Color="#B0141A22"/>
    <BoxShadows x:Key="UiFaceEtchShadows">inset 0 1 0 0 #26FFFFFF, 0 1 0 0 #40FFFFFF</BoxShadows>
    <!-- Fluent selected tab uses these. The selected pill is clear, so the header and pipe stay light. -->
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="#00000000"/>
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#FFFFFFFF"/>

    <ControlTheme x:Key="MsccPhysicalTrackButton" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" MinHeight="20"/>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="MsccPhysicalThumbTheme" TargetType="Thumb">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="MinHeight" Value="18"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border CornerRadius="1"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource UiSliderThumbBorderBrush}"
                  Background="{DynamicResource UiSliderThumbFillBrush}"/>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="MsccPhysicalSliderTheme" TargetType="Slider">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Background" Value="{DynamicResource UiSliderTrackFillBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource UiSliderThumbFillBrush}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid MinHeight="22" VerticalAlignment="Center" Background="Transparent">
            <Border Height="9"
                    VerticalAlignment="Center"
                    CornerRadius="1"
                    Background="{DynamicResource UiSliderTrackFillBrush}"
                    BorderBrush="{DynamicResource UiSliderTrackBorderBrush}"
                    BorderThickness="1">
              <Border Height="1"
                      VerticalAlignment="Top"
                      Margin="1,0"
                      Background="{DynamicResource UiSliderTrackHighlightBrush}"/>
            </Border>
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   Orientation="Horizontal"
                   VerticalAlignment="Center">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton"
                              Theme="{StaticResource MsccPhysicalTrackButton}"
                              Focusable="False"/>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton"
                              Theme="{StaticResource MsccPhysicalTrackButton}"
                              Focusable="False"/>
              </Track.IncreaseButton>
              <Thumb Name="thumb" Theme="{StaticResource MsccPhysicalThumbTheme}"/>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4"/>
      </Style>
    </ControlTheme>

    <!-- App-wide small checkbox: 14 px box, 16 px row. Not based on Fluent. -->
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
      <Setter Property="MinHeight" Value="16"/>
      <Setter Property="Padding" Value="4,0,0,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*" MinHeight="16" Background="Transparent" VerticalAlignment="Center">
            <Border x:Name="Box"
                    Width="14"
                    Height="14"
                    CornerRadius="2"
                    BorderThickness="1"
                    Background="#FF1A1A1A"
                    BorderBrush="#FF888888"
                    VerticalAlignment="Center">
              <Panel>
                <Viewbox x:Name="CheckGlyph"
                         Width="10"
                         Height="10"
                         IsVisible="False"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                  <Path Stroke="Black"
                        StrokeThickness="2"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Data="M1.5,6.5 L4.5,9.5 L10.5,2.5"/>
                </Viewbox>
                <Border x:Name="IndeterminateMark"
                        Width="8"
                        Height="8"
                        CornerRadius="1"
                        Background="Black"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
              </Panel>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              FontStyle="{TemplateBinding FontStyle}"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              HorizontalAlignment="Left"
                              RecognizesAccessKey="True"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Viewbox#CheckGlyph">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
      <Style Selector="^:checked /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource UiAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}"/>
      </Style>
      <Style Selector="^:indeterminate /template/ Border#IndeterminateMark">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
      <Style Selector="^:indeterminate /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource UiAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="White"/>
      </Style>
      <Style Selector="^:checked:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="White"/>
      </Style>
      <Style Selector="^:indeterminate:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="White"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45"/>
      </Style>
    </ControlTheme>

    <!-- Host history: 24 px arrow only. Other ComboBoxes stay Fluent. -->
    <ControlTheme x:Key="MsccHostPickTheme" TargetType="ComboBox">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#FF000000"/>
      <Setter Property="Foreground" Value="#FF00FFAA"/>
      <Setter Property="BorderBrush" Value="#FF666666"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Width="24" Height="22" Background="Transparent">
            <Border x:Name="Background"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2"/>
            <PathIcon x:Name="DropDownGlyph"
                      Width="10"
                      Height="10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Foreground="{TemplateBinding Foreground}"
                      Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z"/>
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   Placement="Bottom"
                   PlacementTarget="Background"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="160"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <Border Background="#FF2A2A2A"
                      BorderBrush="#FF666666"
                      BorderThickness="1"
                      Padding="2"
                      MinWidth="160">
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              IsScrollChainingEnabled="False">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="White"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45"/>
      </Style>
    </ControlTheme>

    <!-- Dark glossy face, shiny top, 3 px slot. Selected lights the slot only. -->
    <ControlTheme x:Key="MsccLightBarButtonTheme" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource UiBarFaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource UiBarTextBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="MinHeight" Value="18"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border CornerRadius="3"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource UiBarOutlineBrush}"
                  Background="{TemplateBinding Background}"
                  ClipToBounds="True">
            <Grid RowDefinitions="0.45*,0.55*">
              <Border x:Name="EdgeSides"
                      Grid.RowSpan="2"
                      BorderThickness="1,0,1,0"
                      BorderBrush="{DynamicResource UiBarEdgeSideBrush}"
                      CornerRadius="2"
                      IsHitTestVisible="False"/>
              <Border x:Name="EdgeTop"
                      Grid.RowSpan="2"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource UiBarEdgeTopBrush}"
                      CornerRadius="2"
                      IsHitTestVisible="False"/>
              <Border x:Name="EdgeBottom"
                      Grid.RowSpan="2"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource UiBarEdgeBottomBrush}"
                      CornerRadius="2"
                      IsHitTestVisible="False"/>
              <Border x:Name="Shine"
                      Grid.Row="0"
                      Margin="1,1,1,0"
                      Background="{DynamicResource UiBarShineBrush}"
                      CornerRadius="2,2,0,0"
                      IsHitTestVisible="False"/>
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Grid.RowSpan="2"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                Margin="0,0,0,6"/>
              <Border x:Name="LightBar"
                      Grid.RowSpan="2"
                      Height="3"
                      VerticalAlignment="Bottom"
                      Margin="5,0,5,2"
                      CornerRadius="1"
                      Background="{DynamicResource UiBarSlotOffBrush}"
                      IsHitTestVisible="False"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiBarFaceHoverBrush}"/>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource UiBarFacePressedBrush}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#EdgeTop">
        <Setter Property="BorderBrush" Value="{DynamicResource UiBarEdgeBottomBrush}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#EdgeBottom">
        <Setter Property="BorderBrush" Value="{DynamicResource UiBarEdgeTopBrush}"/>
      </Style>
      <Style Selector="^.mscc-selected /template/ Border#LightBar">
        <Setter Property="Background" Value="{DynamicResource UiBarSlotOnBrush}"/>
      </Style>
      <Style Selector="^.mscc-tx-on /template/ Border#LightBar">
        <Setter Property="Background" Value="{DynamicResource UiBarSlotTxBrush}"/>
      </Style>
      <Style Selector="^.mscc-tx-on">
        <Setter Property="Foreground" Value="{DynamicResource UiBarTextTxBrush}"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBarTextDisabledBrush}"/>
      </Style>
    </ControlTheme>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Fluent's implicit CheckBox theme is 20 px / MinHeight 32. Force the small one. -->
    <Style Selector="CheckBox">
      <Setter Property="Theme" Value="{StaticResource {x:Type CheckBox}}"/>
    </Style>

    <Style Selector="Button.mscc-bar">
      <Setter Property="Theme" Value="{StaticResource MsccLightBarButtonTheme}"/>
    </Style>

    <!--
      Multus buttons: Fluent paints Background on ContentPresenter, so we must
      set both Button and /template/ ContentPresenter or grey hover wins.
    -->
    <Style Selector="Button.mscc-gold">
      <Setter Property="Background" Value="{DynamicResource UiButtonFaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource UiButtonTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiButtonBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.mscc-gold /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiButtonFaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiButtonBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Idle gold hover (cycle filters, unlatched buttons) -->
    <Style Selector="Button.mscc-gold:pointerover">
      <Setter Property="Background" Value="{DynamicResource UiButtonHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource UiButtonTextBrush}"/>
    </Style>
    <Style Selector="Button.mscc-gold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiButtonHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiButtonBorderBrush}"/>
    </Style>
    <Style Selector="Button.mscc-gold:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
    </Style>

    <Style Selector="Button.mscc-gold:disabled">
      <Setter Property="Background" Value="#FF555555"/>
      <Setter Property="Foreground" Value="#FF999999"/>
      <Setter Property="BorderBrush" Value="#FF444444"/>
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="Button.mscc-gold:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF555555"/>
      <Setter Property="BorderBrush" Value="#FF444444"/>
    </Style>

    <!-- PTT / TUN / AMP latched ON — red even while pointer is still over button -->
    <Style Selector="Button.mscc-gold.mscc-tx-on">
      <Setter Property="Background" Value="#FFE53935"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#FFB71C1C"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-tx-on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFE53935"/>
      <Setter Property="BorderBrush" Value="#FFB71C1C"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-tx-on:pointerover">
      <Setter Property="Background" Value="#FFEF5350"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#FFC62828"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-tx-on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFEF5350"/>
      <Setter Property="BorderBrush" Value="#FFC62828"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-tx-on:pressed">
      <Setter Property="Background" Value="#FFC62828"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#FFB71C1C"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-tx-on:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFC62828"/>
      <Setter Property="BorderBrush" Value="#FFB71C1C"/>
    </Style>
    <!-- After unlatch while still hovering: force gold hover, not Fluent grey -->
    <Style Selector="Button.mscc-gold.mscc-tx-on:pointerover:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFC62828"/>
      <Setter Property="BorderBrush" Value="#FFB71C1C"/>
    </Style>

    <!-- Selected / latched (mode, bands, NB/NR/AN, CMP, MON, cal) -->
    <Style Selector="Button.mscc-gold.mscc-selected">
      <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
    </Style>

    <!-- TX-on wins over selected under pointer -->
    <Style Selector="Button.mscc-gold.mscc-tx-on.mscc-selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFE53935"/>
      <Setter Property="BorderBrush" Value="#FFB71C1C"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.mscc-gold.mscc-tx-on.mscc-selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFEF5350"/>
      <Setter Property="BorderBrush" Value="#FFC62828"/>
    </Style>

    <!-- Stub / not wired -->
    <Style Selector="Button.mscc-stub">
      <Setter Property="Background" Value="#FF555555"/>
      <Setter Property="Foreground" Value="#FFAAAAAA"/>
      <Setter Property="BorderBrush" Value="#FF444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Padding" Value="3,1"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style Selector="TextBlock.mscc-section">
      <Setter Property="Foreground" Value="{DynamicResource UiFaceHeadingBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,4,0,1"/>
      <Setter Property="Effect">
        <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="0" Color="{StaticResource UiFaceHeadingShadowColor}" Opacity="1"/>
      </Setter>
    </Style>
    <!-- Tab and card titles: same lettering as mscc-section, keep each title's FontSize. -->
    <Style Selector="TextBlock.mscc-face-heading">
      <Setter Property="Foreground" Value="{DynamicResource UiFaceHeadingBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Effect">
        <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="0" Color="{StaticResource UiFaceHeadingShadowColor}" Opacity="1"/>
      </Setter>
    </Style>
    <!-- Left rail only: spend the freed Step row on the section gaps. SERVER keeps its own margin. -->
    <Style Selector="StackPanel.mscc-left-rail > TextBlock.mscc-section">
      <Setter Property="Margin" Value="0,8,0,1"/>
    </Style>

    <Style Selector="TextBlock.mscc-label">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Inline slider + readout row height. Tab and cal sliders keep this. -->
    <Style Selector="Slider.mscc-slider">
      <Setter Property="MinHeight" Value="18"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Left and right rails only. Do not put this class on Settings, S/W, or cal sliders. -->
    <Style Selector="Slider.mscc-physical">
      <Setter Property="Theme" Value="{StaticResource MsccPhysicalSliderTheme}"/>
      <Setter Property="ctrl:SliderWheel.OneStepPerNotch" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="TextBlock.mscc-readout">
      <Setter Property="Foreground" Value="{DynamicResource UiAccentBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="MinWidth" Value="28"/>
    </Style>

    <!-- Rail slider numbers only. Left-aligned so the 6 px margin is a gap from the thumb. -->
    <Style Selector="TextBlock.mscc-slider-value">
      <Setter Property="Foreground" Value="{DynamicResource UiSliderValueBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <!-- Calibration status lamp -->
    <Style Selector="Border.cal-lamp">
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Border.cal-lamp.calibrated">
      <Setter Property="Background" Value="#00C853"/>
    </Style>

    <!-- Active VFO face. The idle VFO is dimmed. No border. -->
    <Style Selector="Border.mscc-vfo-active">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.mscc-vfo-idle">
      <Setter Property="Opacity" Value="0.78"/>
    </Style>

    <!-- Host / port entry: short box, larger centered text -->
    <Style Selector="TextBox.mscc-host-ip">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="Background" Value="#FF000000"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderBrush" Value="#FF666666"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionForegroundBrush" Value="Black"/>
      <Setter Property="SelectionBrush" Value="#FFAAAAAA"/>
    </Style>
    <Style Selector="TextBox.mscc-host-ip:pointerover">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#FF000000"/>
    </Style>
    <Style Selector="TextBox.mscc-host-ip:focus">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#FF000000"/>
    </Style>
    <Style Selector="ComboBox.mscc-host-pick">
      <Setter Property="Theme" Value="{StaticResource MsccHostPickTheme}"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#FF000000"/>
      <Setter Property="Foreground" Value="#FF00FFAA"/>
      <Setter Property="BorderBrush" Value="#FF666666"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ComboBox.mscc-hostport">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Background" Value="#FF000000"/>
      <Setter Property="Foreground" Value="#FF00FFAA"/>
      <Setter Property="BorderBrush" Value="#FF666666"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.mscc-hostport">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="MinHeight" Value="18"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="Background" Value="#FF333333"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#FF666666"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.mscc-panel">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- Etched groove around a tab's working area. MAIN keeps the spectrum bezel instead. -->
    <Style Selector="Border.mscc-tab-well">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiFaceEtchDarkBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="BoxShadow" Value="{DynamicResource UiFaceEtchShadows}"/>
    </Style>

    <!-- CW keyer lists: items ~17 px so the WPF heights show every row with no scroll bar. -->
    <Style Selector="ListBox.mscc-cw-list">
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.mscc-cw-list ListBoxItem">
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Checkbox labels sit on the faceplate. Local Foreground still wins. -->
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource UiFaceLabelBrush}"/>
    </Style>

    <!-- Tab headers — fuller WPF-style labels; room to use more of the bar -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource UiFaceMutedTextBrush}"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource UiFaceLabelBrush}"/>
    </Style>
    <!-- Fluent's selected header foreground is for a light pill. The pill is transparent, so paint the header text and the pipe directly. -->
    <Style Selector="TabItem:selected /template/ TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource UiFaceLabelBrush}"/>
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{DynamicResource UiFaceLabelBrush}"/>
      <Setter Property="IsVisible" Value="True"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="2"/>
    </Style>
  </Application.Styles>
</Application>
