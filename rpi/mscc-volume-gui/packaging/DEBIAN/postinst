#!/bin/bash
set -e

resolve_user() {
  local u=""
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    u="$SUDO_USER"
  elif [[ -n "${PKEXEC_UID:-}" ]]; then
    u="$(getent passwd "$PKEXEC_UID" | cut -d: -f1 || true)"
  fi
  if [[ -z "$u" || "$u" == "root" ]]; then
    u="$(logname 2>/dev/null || true)"
  fi
  if [[ -z "$u" || "$u" == "root" ]]; then
    return 1
  fi
  echo "$u"
}

case "$1" in
configure)
  chmod 755 /usr/bin/mscc-volume-gui /usr/bin/mscc-volume-restore 2>/dev/null || true
  chmod 755 /usr/share/mscc-volume-gui/mscc-volume-gui \
            /usr/share/mscc-volume-gui/mscc-volume-restore 2>/dev/null || true
  find /usr/share/mscc-volume-gui -type d -exec chmod 755 {} \; 2>/dev/null || true
  find /usr/share/mscc-volume-gui -type f -name '*.py' -exec chmod 644 {} \; 2>/dev/null || true

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
  fi

  # Also install under ~/mscc/mscc-volume-gui for the sudo user
  if REAL_USER="$(resolve_user)"; then
    HOME_DIR="$(getent passwd "$REAL_USER" | cut -d: -f6)"
    if [[ -n "$HOME_DIR" && -d "$HOME_DIR" ]]; then
      DEST="$HOME_DIR/mscc/mscc-volume-gui"
      mkdir -p "$HOME_DIR/mscc"
      rm -rf "$DEST"
      cp -a /usr/share/mscc-volume-gui "$DEST"
      chmod 755 "$DEST/mscc-volume-gui" "$DEST/mscc-volume-restore" 2>/dev/null || true
      chown -R "$REAL_USER:$REAL_USER" "$DEST"
      echo "mscc-volume-gui: installed tree → $DEST"
    fi
  else
    echo "mscc-volume-gui: note: could not seed \$HOME/mscc/mscc-volume-gui (no sudo user)"
    echo "  copy from /usr/share/mscc-volume-gui or re-run: sudo apt install --reinstall mscc-volume-gui"
  fi

  echo
  echo "================================================================"
  echo "  mscc-volume-gui installed"
  echo "================================================================"
  echo "  Run as your normal desktop user (not root):"
  echo "    • Menu:  MSCC Volume"
  echo "    • or:    mscc-volume-gui"
  echo "    • tree:  \$HOME/mscc/mscc-volume-gui/"
  echo "  Sticky:  \$HOME/.local/mscc/volume-levels.conf"
  echo "================================================================"
  echo
  ;;
esac
exit 0
