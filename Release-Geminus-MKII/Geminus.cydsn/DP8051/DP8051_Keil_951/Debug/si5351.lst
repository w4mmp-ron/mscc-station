1047   1          
1048   1              write_status = I2C_DISPLAY_MasterWriteBuf(SI5351_SLAVE_ADDRESS,msg_buffer,2u,I2C_DISPLAY_MODE_COMPLETE_XF
             -ER);
1049   1          while((I2C_DISPLAY_MasterStatus() & I2C_DISPLAY_MSTAT_WR_CMPLT) == 0u){};
1050   1          buffer_written = I2C_DISPLAY_MasterGetWriteBufSize();
