  30          
  31          uint8 TX_Request = 0;
  32          uint8 TX_Inhibit = 0;
  33          
  34          /*
  35           * Non-QSK amp sequencing, same as CW: AMP on, wait E_key_delay_ms (from TX hold) for the
  36           * amp relays to settle, then PA on. On release PA off, wait AMP_RELEASE_MS, then AMP off.
  37           * QSK amp (E_QSK TRUE) keeps the original order.
  38           *
  39           * 3.241 non-QSK: PCM3060 DAC soft mute (reg 0x44) around the PA edges, so TX_HI never
  40           * switches with RF at full level (broadband splatter at TUN / PTT release).
  41           *   Key:     DAC mute, AMP on, key delay (>= 20 ms > 16.7 ms ramp), PA on, DAC unmute.
  42           *   Release: DAC mute, TX_DAC_RAMP_MS, PA off, AMP_RELEASE_MS, AMP off, DAC unmute.
  43           */
  44          static uint8 state = 0;
  45          
  46          /* Main loop: force TX_Main back to idle (entering CW, where cw.c owns the DAC mute) */
  47          void TX_Reset(void) {
  48   1          state = 0;
  49   1      }
  50          
  51          /* 3.242: TRUE when TX_Main is receiving (PA and AMP off, DAC unmuted) */
  52          uint8 TX_Idle(void) {
C51 COMPILER V9.51   TX                                                                    10/29/2026 12:58:40 PAGE 2   

  53   1          return (state == 0);
  54   1      }
  55          
  56          void TX_Main(void) {
  57   1          static uint8 start_tick = 0;
  58   1          static uint8 delay_ms = 0;
  59   1      
  60   1          switch (state) {
  61   2              case 0: // receiving
  62   2                  if (TX_Request && !TX_Inhibit) {
  63   3                      if(E_QSK == TRUE){
  64   4                          state = 2;
  65   4                          Control_Write(Control_Read() & ~CONTROL_RX);
  66   4                      }else{
  67   4                          TX_DAC_Mute(TRUE);                              //Ramp DAC down during the key delay
  68   4                          Control_Write(Control_Read() & ~CONTROL_AMP);   //AMP on first - Negative logic level
  69   4                          delay_ms = E_key_delay_ms;
  70   4                          start_tick = E_ms_tick;
  71   4                          state = 3;
  72   4                      }
  73   3                  }
  74   2                  break;
  75   2              case 2:
  76   2                  Control_Write(Control_Read() & ~CONTROL_AMP);
  77   2                  state = 10;
  78   2                  break;
  79   2              case 3: // Non-QSK: AMP on, waiting for the amp relays before PA on
  80   2                  if (!TX_Request || TX_Inhibit) {
  81   3                      Control_Write(Control_Read() | CONTROL_AMP);    //PTT dropped before PA on. AMP off
  82   3                      TX_DAC_Mute(FALSE);
  83   3                      state = 0;
  84   3                  }else if ((uint8)(E_ms_tick - start_tick) >= delay_ms) {
  85   3                      Control_Write(Control_Read() & ~CONTROL_RX);    //PA on - Negative logic level
  86   3                      TX_DAC_Mute(FALSE);                             //Then ramp the DAC up (~3 ms 10-90 %)
  87   3                      state = 10;
  88   3                  }
  89   2                  break;
  90   2              case 10: // transmitting
  91   2                  if (!TX_Request && !TX_Inhibit) {
  92   3                      if(E_QSK == TRUE){
  93   4                          Control_Write(Control_Read() & ~(CONTROL_LED) | CONTROL_AMP);
  94   4                          state = 11;
  95   4                      }else{
  96   4                          TX_DAC_Mute(TRUE);                          //Ramp RF down first, PA stays on
  97   4                          start_tick = E_ms_tick;
  98   4                          state = 13;
  99   4                      }
 100   3                   }
 101   2                 break;
 102   2              case 13: // Non-QSK: DAC ramping down, PA still on
 103   2                  if (TX_Request) {
 104   3                      TX_DAC_Mute(FALSE);                             //Re-keyed during the ramp
 105   3                      state = 10;
 106   3                  }else if ((uint8)(E_ms_tick - start_tick) >= TX_DAC_RAMP_MS) {
 107   3                      Control_Write(Control_Read() & ~(CONTROL_LED) | CONTROL_RX);    //PA off
 108   3                      start_tick = E_ms_tick;
 109   3                      state = 12;
 110   3                  }
 111   2                  break;
 112   2              case 11:
 113   2                  Control_Write(Control_Read() | CONTROL_RX);
 114   2                  state = 0;
