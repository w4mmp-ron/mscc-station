 780   1      
 781   1          #if (USBFS_EP2_ISR_ACTIVE)
 782   1              CyIntDisable(USBFS_EP_2_VECT_NUM);
 783   1          #endif /* (USBFS_EP2_ISR_ACTIVE) */
 784   1      
 785   1          #if (USBFS_EP3_ISR_ACTIVE)
