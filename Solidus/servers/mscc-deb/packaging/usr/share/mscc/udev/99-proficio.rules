# Multus SDR / Proficio — control USB (libusb) and related interfaces
# VID 16c0 PID 05dc (see ms-sdr / mscc-init Linux notes)
# Symlink: /dev/proficio
SUBSYSTEM=="usb", ATTR{idVendor}=="16c0", ATTR{idProduct}=="05dc", MODE="0666", GROUP="plugdev", TAG+="uaccess", SYMLINK+="proficio"

# PSoC HID bootloader (BOOT jumper / Morse LOADER) — used by $HOME/mscc/bootloader
# Symlink: /dev/proficio-bootloader
SUBSYSTEM=="usb", ATTR{idVendor}=="04b4", ATTR{idProduct}=="b71d", MODE="0666", GROUP="plugdev", TAG+="uaccess", SYMLINK+="proficio-bootloader"

# USB sound interfaces that report the same vendor (I/Q audio)
# Symlink: /dev/proficio-sound-control  (controlC* node)
SUBSYSTEM=="sound", ATTRS{idVendor}=="16c0", MODE="0666", GROUP="audio"
KERNEL=="controlC*", ATTRS{idVendor}=="16c0", MODE="0666", GROUP="audio", SYMLINK+="proficio-sound-control"
