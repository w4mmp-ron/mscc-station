 765   1              {
 766   2                      regValue |= 0x00u;
 767   2              }
 768   1              else
 769   1              {
 770   2                      regValue &= (uint8)~0x00u;
 771   2              }
 772   1              CY_SET_REG8((void CYXDATA *)CYREG_PUMP_CR0, regValue);
 773   1      }
