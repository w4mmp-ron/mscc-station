002272 E0                MOVX     A,@DPTR
002273 4410              ORL      A,#010H
002275 F0                MOVX     @DPTR,A
002276         ?C0070?CYFLASH:
  622: 
  623:     while(0u == (CY_FLASH_SPC_FM_EE_CR_REG & CY_FLASH_EE_EE_AWAKE))
