 298   1          uint8 errStatus;
 299   1      
 300   1          errStatus = I2C_DISPLAY_MSTR_NOT_READY;
C51 COMPILER V9.51   I2C_DISPLAY_MASTER                                                    08/22/2026 15:13:59 PAGE 6   

