 811          /*
 812           * si5351_set_clock_disable(enum si5351_clock clk, enum si5351_clock_disable dis_state)
 813           *
 814           * clk - Clock output
 815           *   (use the si5351_clock enum)
 816           * dis_state - Desired state of the output upon disable
 817           *   (use the si5351_clock_disable enum)
 818           *
 819           * Set the state of the clock output when it is disabled. Per page 27
 820           * of AN619 (Registers 24 and 25), there are four possible values: low,
 821           * high, high impedance, and never disabled.
 822           */
 823          void si5351_set_clock_disable(enum si5351_clock clk, enum si5351_clock_disable dis_state)
 824          {
 825   1              uint8_t reg_val, reg = 0;
 826   1      
 827   1              if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 828   1              {
 829   2                      reg = SI5351_CLK3_0_DISABLE_STATE;
 830   2              }
 831   1              else if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 832   1              {
 833   2                      reg = SI5351_CLK7_4_DISABLE_STATE;
 834   2              }
 835   1      
 836   1              si5351_read(reg, &reg_val);
 837   1      
 838   1              if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 839   1              {
 840   2                      reg_val &= ~(0x03 << (clk * 2));
 841   2                      reg_val |= dis_state << (clk * 2);
 842   2              }
 843   1              else if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 844   1              {
 845   2                      reg_val &= ~(0x03 << ((clk - 4) * 2));
 846   2                      reg_val |= dis_state << ((clk - 4) * 2);
 847   2              }
 848   1      
 849   1              si5351_write_init(reg, reg_val);
 850   1          
 851   1      }
