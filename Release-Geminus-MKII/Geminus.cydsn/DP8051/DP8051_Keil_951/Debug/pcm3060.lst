 173          
 174          uint8 PCM3060_Init(void) {
 175   1          I2S_Start();
 176   1          DmaRxInit();
 177   1          DmaTxInit();
 178   1          return PCM3060_Stop();
 179   1      }
 180          
 181          void PCM3060_Start(void) {
 182   1          PCM3060_SetRegister(0x40, 0xC0); // Wakeup
 183   1          PCM3060_SetRegister(0x45, 0x80); // Slow rolloff filter
 184   1          PCM3060_SetRegister(0x41, 0xff); //Set the volume to full
 185   1          PCM3060_SetRegister(0x42, 0xff); //Set the volume to full
 186   1          DmaRxStart();
 187   1          DmaTxStart();
 188   1          I2S_EnableRx();
 189   1          I2S_EnableTx();
 190   1      }
 191          
 192          uint8 PCM3060_Stop(void) {
 193   1          uint8 ret;
 194   1          ret = PCM3060_SetRegister(0x40, 0xF0); // Sleep
 195   1          I2S_DisableRx();
 196   1          I2S_DisableTx();
 197   1          CyDmaChDisable(RxI2S_Stage_DmaHandle);
 198   1          CyDmaChDisable(RxI2S_Buff_DmaHandle);
 199   1          CyDmaChDisable(TxI2S_Stage_DmaHandle);
 200   1          CyDmaChDisable(TxI2S_Buff_DmaHandle);
 201   1          CyDmaChDisable(TxI2S_Zero_DmaHandle);
 202   1          I2S_ClearRxFIFO();
 203   1          I2S_ClearTxFIFO();
 204   1          return ret;
 205   1      }
