008DE4 124D79            LCALL    CyEnterCriticalSection
;---- Variable 'interruptState' assigned to Register 'R7' ----
  666: 
  667: 
  668:     /***************************************************************************
  669:     * Enable SPC clock. This also internally enables the 36MHz IMO, since this
  670:     * is required for the SPC to function.
  671:     ***************************************************************************/
  672:     CY_FLASH_PM_ACT_CFG0_REG    |= CY_FLASH_PM_ACT_CFG0_EN_CLK_SPC;
008DE7 9043A0            MOV      DPTR,#043A0H
008DEA E0                MOVX     A,@DPTR
008DEB 4408              ORL      A,#08H
008DED F0                MOVX     @DPTR,A
LX51 LINKER/LOCATER V4.64.0.0                                                         10/31/2026  20:29:11  PAGE 176


  673:     CY_FLASH_PM_ALTACT_CFG0_REG |= CY_FLASH_PM_ALTACT_CFG0_EN_CLK_SPC;
008DEE 9043B0            MOV      DPTR,#043B0H
008DF1 E0                MOVX     A,@DPTR
008DF2 4408              ORL      A,#08H
008DF4 F0                MOVX     @DPTR,A
  674: 
  675: 
  676:     /***************************************************************************
  677:     * The wake count defines the number of Bus Clock cycles it takes for the
  678:     * flash or EEPROM to wake up from a low power mode independent of the chip
  679:     * power mode. Wake up time for these blocks is 5 us.
  680:     * The granularity of this register is 2 Bus Clock cycles, so a value of 0x1E
  681:     * (30d) defines the wake up time as 60 cycles of the Bus Clock.
  682:     * This register needs to be written with a value dependent on the Bus Clock
  683:     * frequency so that the duration of the cycles is equal to or greater than
  684:     * the 5 us delay required.
  685:     ***************************************************************************/
  686:     CY_FLASH_SPC_FM_EE_WAKE_CNT_REG = CY_FLASH_SPC_FM_EE_WAKE_CNT_80MHZ;
008DF5 904701            MOV      DPTR,#04701H
008DF8 74C8              MOV      A,#0C8H
008DFA F0                MOVX     @DPTR,A
  687: 
  688: 
  689:     /***************************************************************************
  690:     * Enable EEPROM. Re-enabling an EEPROM macro takes 5us. During this time,
  691:     * the EE will not acknowledge a PHUB request.
  692:     ***************************************************************************/
  693:     CY_FLASH_PM_ACT_CFG12_REG    |= CY_FLASH_PM_ACT_CFG12_EN_EE;
008DFB 9043AC            MOV      DPTR,#043ACH
008DFE E0                MOVX     A,@DPTR
008DFF 4410              ORL      A,#010H
008E01 F0                MOVX     @DPTR,A
  694:     CY_FLASH_PM_ALTACT_CFG12_REG |= CY_FLASH_PM_ALTACT_CFG12_EN_EE;
008E02 9043BC            MOV      DPTR,#043BCH
008E05 E0                MOVX     A,@DPTR
008E06 4410              ORL      A,#010H
008E08 F0                MOVX     @DPTR,A
008E09         ?C0085?CYFLASH:
  695: 
  696:     while(0u == (CY_FLASH_SPC_FM_EE_CR_REG & CY_FLASH_EE_EE_AWAKE))
008E09 904700            MOV      DPTR,#04700H
008E0C E0                MOVX     A,@DPTR
008E0D 5420              ANL      A,#020H
008E0F 60F8              JZ       ?C0085?CYFLASH
  697:     {
  698:         /* Non-zero status denotes that the EEPROM/Flash is awake & powered. */
  699:     }
008E11         ?C0086?CYFLASH:
  700: 
  701:     CyExitCriticalSection(interruptState);
008E11 024D61            LJMP     _CyExitCriticalSection
