  25          #include <basic-plus.h>
  26          #define PULSE_TUNER_TIME 5000;
  27          
  28          // Full support for Elecraft T1 Automatic Antenna Tuner
  29          
  30          uint8 T1_Band_Number;
  31          uint8 T1_Tune_Request;
  32          uint32 Pulse_Tuner = PULSE_TUNER_TIME
  33          
  34          void T1_Main(void) {
  35   1          static uint8 state = 0, timer, band, send, bits, band_request, band_request_timer;
  36   1          static uint16 tune_timer; 
  37   1          //static uint8 previous_E_AMP_Bypass = 100;
  38   1          //static uint8 band_refresh_count = 3;
  39   1          
  40   1          if(Pulse_Tuner-- == 0){
  41   2              band = 0;
  42   2              Pulse_Tuner = PULSE_TUNER_TIME;
  43   2          }
  44   1          if (tune_timer) {
  45   2              tune_timer--;
  46   2              if (!tune_timer) {
  47   3                  Control_Write(Control_Read() & ~CONTROL_ATU_1);
  48   3              }
  49   2          }
  50   1      
  51   1          if (band_request_timer) band_request_timer--;
  52   1          else if (T1_Band_Number != band) {
