  24          #include <basic-plus.h>
  25          #include <si5351.h>
  26          #include <si5351a.h>
  27          
  28          #define TX_LED_BLINK_ON_MS 40
  29          #define TX_LED_BLINK_OFF_MS 50
  30          
  31          uint8 TX_Request = 0;
  32          uint8 TX_Inhibit = 0;
  33          
  34          /*
  35           * Non-QSK amp sequencing, same as CW: AMP on, wait E_key_delay_ms (from TX hold) for the
  36           * amp relays to settle, then PA on. On release PA off, wait AMP_RELEASE_MS, then AMP off.
  37           * QSK amp (E_QSK TRUE) keeps the original order.
  38           *
  39           * 3.241 non-QSK: PCM3060 DAC soft mute (reg 0x44) around the PA edges, so TX_HI never
  40           * switches with RF at full level (broadband splatter at TUN / PTT release).
  41           *   Key:     DAC mute, AMP on, key delay (>= 20 ms > 16.7 ms ramp), PA on, DAC unmute.
  42           *   Release: DAC mute, TX_DAC_RAMP_MS, PA off, AMP_RELEASE_MS, AMP off, DAC unmute.
  43           *
  44           * 3.243 / 4.244: non-QSK keeps the DAC muted the whole time it receives, and unmutes it only
  45           * after the PA is on. SDRcore-trans still has tens of ms of carrier / two-tone queued when the
  46           * radio unkeys; with the DAC unmuted again 28 ms after release that tail played with the PA off
  47           * and leaked out (spurs at the 12 kHz TX IF spacing on the SA, a beep / click in the speaker,
  48           * Stew 11-02). The DAC carries TX I/Q only, so RX loses nothing. QSK (no shaping) keeps the
  49           * DAC at full, as before. In CW, cw.c owns the mute.
  50           *   Release: DAC mute, TX_DAC_RAMP_MS, PA off, AMP_RELEASE_MS, AMP off (DAC stays muted).
  51           */
  52          static uint8 state = 0;
C51 COMPILER V9.51   TX                                                                    11/12/2026 20:09:34 PAGE 2   

  53          
  54          /* Main loop: force TX_Main back to idle (entering CW, where cw.c owns the DAC mute) */
  55          void TX_Reset(void) {
  56   1          state = 0;
  57   1      }
  58          
  59          /* 3.242: TRUE when TX_Main is receiving (PA and AMP off, DAC unmuted) */
  60          uint8 TX_Idle(void) {
  61   1          return (state == 0);
  62   1      }
  63          
  64          void TX_Main(void) {
  65   1          static uint8 start_tick = 0;
  66   1          static uint8 delay_ms = 0;
  67   1      
  68   1          switch (state) {
  69   2              case 0: // receiving
  70   2                  TX_DAC_Mute(E_QSK == TRUE ? FALSE : TRUE);          //3.243: non-QSK muted in RX, QSK at full
  71   2                  if (TX_Request && !TX_Inhibit) {
  72   3                      if(E_QSK == TRUE){
  73   4                          state = 2;
  74   4                          Control_Write(Control_Read() & ~CONTROL_RX);
  75   4                      }else{
  76   4                          TX_DAC_Mute(TRUE);                              //Ramp DAC down during the key delay
  77   4                          Control_Write(Control_Read() & ~CONTROL_AMP);   //AMP on first - Negative logic level
  78   4                          delay_ms = E_key_delay_ms;
  79   4                          start_tick = E_ms_tick;
  80   4                          state = 3;
  81   4                      }
  82   3                  }
  83   2                  break;
  84   2              case 2:
  85   2                  Control_Write(Control_Read() & ~CONTROL_AMP);
  86   2                  state = 10;
  87   2                  break;
  88   2              case 3: // Non-QSK: AMP on, waiting for the amp relays before PA on
  89   2                  if (!TX_Request || TX_Inhibit) {
  90   3                      Control_Write(Control_Read() | CONTROL_AMP);    //PTT dropped before PA on. AMP off
  91   3                      state = 0;                                      //3.243: DAC stays muted
  92   3                  }else if ((uint8)(E_ms_tick - start_tick) >= delay_ms) {
  93   3                      Control_Write(Control_Read() & ~CONTROL_RX);    //PA on - Negative logic level
  94   3                      TX_DAC_Mute(FALSE);                             //Then ramp the DAC up (~3 ms 10-90 %)
  95   3                      state = 10;
  96   3                  }
  97   2                  break;
  98   2              case 10: // transmitting
  99   2                  if (!TX_Request && !TX_Inhibit) {
 100   3                      if(E_QSK == TRUE){
 101   4                          Control_Write(Control_Read() & ~(CONTROL_LED) | CONTROL_AMP);
 102   4                          state = 11;
 103   4                      }else{
 104   4                          TX_DAC_Mute(TRUE);                          //Ramp RF down first, PA stays on
 105   4                          start_tick = E_ms_tick;
 106   4                          state = 13;
 107   4                      }
 108   3                   }
 109   2                 break;
 110   2              case 13: // Non-QSK: DAC ramping down, PA still on
 111   2                  if (TX_Request) {
 112   3                      TX_DAC_Mute(FALSE);                             //Re-keyed during the ramp
 113   3                      state = 10;
 114   3                  }else if ((uint8)(E_ms_tick - start_tick) >= TX_DAC_RAMP_MS) {
C51 COMPILER V9.51   TX                                                                    11/12/2026 20:09:34 PAGE 3   

 115   3                      Control_Write(Control_Read() & ~(CONTROL_LED) | CONTROL_RX);    //PA off
 116   3                      start_tick = E_ms_tick;
 117   3                      state = 12;
 118   3                  }
 119   2                  break;
 120   2              case 11:
 121   2                  Control_Write(Control_Read() | CONTROL_RX);
 122   2                  state = 0;
 123   2                  break;
 124   2              case 12: // Non-QSK: PA off, waiting for RF to die before AMP off
 125   2                  if ((uint8)(E_ms_tick - start_tick) >= AMP_RELEASE_MS) {
 126   3                      Control_Write(Control_Read() | CONTROL_AMP);
 127   3                      state = 0;                                      //3.243: DAC stays muted in RX (no TX tail
