 258          uint32 swap32(uint32 original) CYREENTRANT {
 259   1          uint8 *r, *o;
 260   1          uint32 ret;
 261   1          r = (void*)&ret;
 262   1          o = (void*)&original;
 263   1          r[0] = o[3];
 264   1          r[1] = o[2];
 265   1          r[2] = o[1];
 266   1          r[3] = o[0];
 267   1          return ret;
 268   1      }
