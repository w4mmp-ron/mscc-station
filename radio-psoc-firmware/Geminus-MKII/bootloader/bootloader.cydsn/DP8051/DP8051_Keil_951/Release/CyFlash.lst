 671          /*******************************************************************************
 672          * Function Name: CyEEPROM_ReadRelease
 673          ****************************************************************************//**
 674          *
 675          *  Release the read reservation of the EEPROM.
 676          *
 677          *******************************************************************************/
 678          void CyEEPROM_ReadRelease(void) 
 679          {
 680   1          CY_FLASH_EE_SCR_REG &= (uint8)(~CY_FLASH_EE_SCR_AHB_EE_REQ);
