  55          /*
  56           * Non-QSK amp keying delay. AMP port goes on at first key down; the key lines are
  57           * sampled every 1 ms into key_delay_buf and played to the PA (CONTROL_RX) key_delay_ms late
  58           * so the amp relays settle before RF. Element lengths are unchanged.
  59           * key_delay_ms is latched from E_key_delay_ms (set from E_TX_Hold in main.c) at the start
  60           * of each over, so a change never alters an element mid-over.
  61           * Key_Delay_Timer: fixed-function, CW_Clock (10 kHz), period 10 -> 1 ms tc.
  62           * ISR uses the register macros, not Status_Read()/Control_Read()/Control_Write():
  63           * Keil 8051 functions are not reentrant and the main loop calls those.
  64           * Main loop Control_Write() read-modify-writes may briefly undo CONTROL_RX;
  65           * the ISR rewrites it every tick, so worst case is a 1 ms edge error.
  66           *
  67           * Key click shaping (3.240, as the Legacy 1.232 copy): SDRcore-trans sends a steady carrier
  68           * in CW, so the RF edges were the hard PA switch. Now the PCM3060 DAC soft mute (reg 0x44,
  69           * MUT21/MUT22) ramps the I/Q level 0.5 dB per 8/fs, i.e. 6 dB/ms at 96 kHz, 16.7 ms from
  70           * full to mute. Non-QSK only (QSK has no key delay to ramp ahead in). The DAC is kept muted
  71           * in non-QSK CW. For each element the PA goes on and the DAC unmutes DAC_RISE_LEAD_MS before
  72           * the delayed key down (so the -6 dB point lands on the edge); at the delayed key up the DAC
  73           * mutes and the PA goes off DAC_RAMP_MS later. The ISR only asks for the mute / unmute
  74           * (dac_req); the main loop does the I2C write. Spaces shorter than DAC_RISE_LEAD_MS merge
  75           * (above about 80 WPM).
  76           */
  77          #define DAC_RAMP_MS 18u        /* soft mute full ramp 16.7 ms at 96 kHz, rounded up */
  78          #define DAC_RISE_LEAD_MS 14u   /* < KEY_DELAY_MIN_MS. Unmute this early: -6 dB after about 15 ms */
  79          #define DAC_REQ_NONE 0u
  80          #define DAC_REQ_MUTE 1u
  81          #define DAC_REQ_UNMUTE 2u
  82          #define PCM3060_REG_DAC_MUTE 0x44u
  83          #define PCM3060_DAC_MUTE_ON 0x03u      /* MUT22 + MUT21 */
  84          #define PCM3060_DAC_MUTE_OFF 0x00u
  85          #define KEY_DELAY_BUF_SIZE 64u       /* ms of key history, power of 2, > KEY_DELAY_MAX_MS */
  86          static uint8 key_delay_buf[KEY_DELAY_BUF_SIZE];
  87          static volatile uint8 key_delay_idx = 0;
  88          static volatile uint8 key_delay_ms = 0;        /* delay for this over */
  89          static volatile uint8 key_up_ms = 0;           /* ms since last key down, stops at 255 */
  90          static volatile uint8 key_delay_active = FALSE;
  91          static volatile uint8 key_delay_busy = FALSE;   /* TRUE until delayed RF of last key down is done */
  92          static volatile uint8 key_delay_lo_ready = FALSE; /* LO on TX freq. PA held off until TRUE */
  93          volatile uint8 E_ms_tick = 0;                   /* free running 1 ms count, used by TX_Main() amp delay */
  94          static volatile uint8 dac_req = DAC_REQ_NONE;   /* ISR -> main loop: PCM3060 soft mute request */
  95          static volatile uint8 rf_on = FALSE;            /* PA on and DAC unmuted for an element */
  96          static volatile uint8 rf_off_ms = 255;          /* ms since DAC mute started, stops at 255 */
  97          static uint8 dac_muted = FALSE;                 /* main loop copy of the PCM3060 mute bits */
  98          
  99          CY_ISR(KEY_DELAY_interrupt){
 100   1          uint8 reg;
 101   1          uint8 key;
 102   1          uint8 on;
 103   1      
 104   1          E_ms_tick++;
 105   1          if(!key_delay_active) return;
 106   1          if(TX_Inhibit || (E_host_mode != 'C')){ //Left CW or inhibited mid-over: PA off, stop playing
 107   2              Control_Control |= CONTROL_RX;
 108   2              rf_on = FALSE;
 109   2              dac_req = DAC_REQ_MUTE;
 110   2              key_delay_busy = FALSE;
 111   2              key_delay_active = FALSE;
 112   2              return;
 113   2          }
 114   1          reg = Status_Status;
C51 COMPILER V9.51   CW                                                                    10/29/2026 12:58:46 PAGE 3   

 115   1          key = (!(reg & STATUS_KEY_0) || !(reg & STATUS_KEY_1));
 116   1          key_delay_buf[key_delay_idx] = key;
 117   1          if(key){
 118   2              key_up_ms = 0;
 119   2          }else if(key_up_ms < 255u){
 120   2              key_up_ms++;
 121   2          }
 122   1          on = FALSE;
 123   1          if(key_delay_lo_ready){ //RF from DAC_RISE_LEAD_MS before the delayed key down to the delayed key up
 124   2              on = key_delay_buf[(uint8)(key_delay_idx - key_delay_ms) & (KEY_DELAY_BUF_SIZE - 1u)]
 125   2                || key_delay_buf[(uint8)(key_delay_idx - (key_delay_ms - DAC_RISE_LEAD_MS)) & (KEY_DELAY_BUF_SIZ
             -E - 1u)];
 126   2          }
 127   1          if(on && !rf_on){
 128   2              Control_Control &= ~CONTROL_RX;     //Turn ON PA - Negative logic level. DAC ramps up
 129   2              dac_req = DAC_REQ_UNMUTE;
 130   2              rf_on = TRUE;
 131   2          }else if(!on && rf_on){
 132   2              dac_req = DAC_REQ_MUTE;             //DAC ramps down, PA goes off when done
 133   2              rf_on = FALSE;
 134   2              rf_off_ms = 0;
 135   2          }else if(!rf_on){
 136   2              if(rf_off_ms < 255u) rf_off_ms++;
 137   2              if(rf_off_ms >= DAC_RAMP_MS){
 138   3                  Control_Control |= CONTROL_RX;  //Turn OFF PA - Negative logic level
 139   3              }else{
 140   3                  Control_Control &= ~CONTROL_RX; //Ramping down: PA stays on (rewrite every tick)
 141   3              }
 142   2          }else{
 143   2              Control_Control &= ~CONTROL_RX;     //Rewrite every tick: a main loop Control_Write() may undo it
 144   2          }
 145   1          key_delay_idx = (key_delay_idx + 1u) & (KEY_DELAY_BUF_SIZE - 1u);
 146   1          key_delay_busy = (key_up_ms <= key_delay_ms) || rf_on || (rf_off_ms < DAC_RAMP_MS);
 147   1      }
