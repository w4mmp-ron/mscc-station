 936          void si5351_update_sys_status(struct Si5351Status *status)
 937          {
 938   1              uint8_t reg_val = 0;
 939   1      
 940   1              if(si5351_read(SI5351_DEVICE_STATUS, &reg_val) != 0)
 941   1              {
 942   2                      return;
 943   2              }
 944   1      
 945   1              /* Parse the register */
 946   1              status->SYS_INIT = (reg_val >> 7) & 0x01;
 947   1              status->LOL_B = (reg_val >> 6) & 0x01;
 948   1              status->LOL_A = (reg_val >> 5) & 0x01;
 949   1              status->LOS = (reg_val >> 4) & 0x01;
 950   1              status->REVID = reg_val & 0x03;
 951   1      }
