<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MSCC.Avalonia.Controls.SpectrumDisplayControl"
             Background="#FF0A0A12"
             MinHeight="180"
             ClipToBounds="True">
  <Grid>
    <Image x:Name="SpectrumImage"
           Stretch="Fill"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch" />
    <!-- WPF port: PEAK MARKER readout (top right) -->
    <Border x:Name="PeakMarkerBox"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,4,6,0" Padding="5,2"
            Background="#CC222200" BorderBrush="#FFEECC00" BorderThickness="1" CornerRadius="2"
            IsHitTestVisible="False" IsVisible="False">
      <TextBlock x:Name="PeakMarkerText"
                 FontFamily="Consolas, Courier New, monospace"
                 FontSize="13" FontWeight="Bold" Foreground="#FFEECC00"/>
    </Border>
    <!-- 1.6.89: the "Center ... MHz | bins | zoom | click to tune" banner removed (Ron: covered the pass band) -->
  </Grid>
</UserControl>
