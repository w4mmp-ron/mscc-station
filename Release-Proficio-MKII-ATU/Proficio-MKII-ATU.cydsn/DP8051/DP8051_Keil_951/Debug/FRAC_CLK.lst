  47   1          /* Set the bit to enable the clock. */
  48   1          FRAC_CLK_CLKEN |= FRAC_CLK_CLKEN_MASK;
  49   1              FRAC_CLK_CLKSTBY |= FRAC_CLK_CLKSTBY_MASK;
  50   1      }
