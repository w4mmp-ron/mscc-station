                      I2C_DISPLAY_STBY_PWRMGR_REG &= (uint8) ~I2C_DISPLAY_STBY_PWR_EN;
                      CyExitCriticalSection(intState);
              
                      /* Enable component in I2C_Wakeup() after register restore */
                      I2C_DISPLAY_backup.enableState = I2C_DISPLAY_ENABLE;
