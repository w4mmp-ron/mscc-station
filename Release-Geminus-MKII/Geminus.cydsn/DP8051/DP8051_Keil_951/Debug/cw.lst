 187          void Manage_Paddles_Port(void)  
 188          {
 189   1          uint8 key;
 190   1          uint8 paddles_section;
 191   1          static uint8_t state = 0;
 192   1          uint8_t control_status = 0;
 193   1          static uint32 previous_CW_LO_Freq = 0;
 194   1          
 195   1          switch(state){  //When in CW mode Manage_Paddles_Port manages the LO freq.
 196   2              case 0:     //Idle state
 197   2                  if(previous_CW_LO_Freq != CW_LO_Freq){
 198   3                      SI5351_status = si5351aSetFrequency(CW_LO_Freq);
 199   3                      if(SI5351_status == 0){
 200   4                          previous_CW_LO_Freq = CW_LO_Freq;
 201   4                          if(!TX_Inhibit && (E_host_mode == 'C')){ //Do not process the CW KEY if TX_Inhibit act
             -ive and NOT in CW mode
 202   5                              state++; //Now check for key down
 203   5                          }
 204   4                      }
 205   3                  }else{
 206   3                      if(!TX_Inhibit && (E_host_mode == 'C')){ //Do not process the CW KEY if TX_Inhibit active 
             -and NOT in CW mode
 207   4                          state++; //CW_LO_Freq did not change. Now check for key down
 208   4                      }
 209   3                  }            
 210   2                  break;
 211   2              case 1: //Check for KEY DOWN
 212   2                  paddles_section = CyEnterCriticalSection();
 213   2                  key = Status_Read();
 214   2                  CyExitCriticalSection(paddles_section);
 215   2                  if (key & STATUS_KEY_0)  E_key_0 = TRUE; else E_key_0 = FALSE;
 216   2                  if (key & STATUS_KEY_1)  E_key_1 = TRUE; else E_key_1 = FALSE;
 217   2                  if(!E_key_0 || !E_key_1){ //Key is DOWN   
 218   3                      E_key_down = TRUE;
 219   3                      state++;
 220   3                  }else{
 221   3                      state = 0;//Key is not down return to idle state
 222   3                  }
 223   2                  break;
 224   2              case 2: //A KEY is down and the CW Hold timer is not running
 225   2                  Control_Write(Control_Read() & ~CONTROL_DOUT);          //Turn OFF output from PCM3060. Do NOT
             - Receive the Audio
 226   2                  SI5351_status = si5351aSetFrequency(CW_LO_Freq + E_cw_pitch_freq); //Set the LO to the CW TX f
             -requency
 227   2                  if(SI5351_status == 0){
 228   3                      state++;   
 229   3                  }
 230   2                  break;
 231   2              case 3:
 232   2                  control_status = Control_Read();
 233   2                  if(E_QSK == TRUE){//The Potentia 50 / 100 is attached.  They are QSK. Turn on the AMP port and
C51 COMPILER V9.51   CW                                                                    03/03/2025 12:10:05 PAGE 5   

             - the PA now.
 234   3                      control_status = control_status & ~CONTROL_AMP;     //Turn ON the AMP port - Negative logi
             -c level
 235   3                      control_status = control_status & ~CONTROL_RX;      //Turn ON PA - Negative logic level. P
             -A controls CW ON/OFF 
 236   3                      Band_Control_Write(Band_Control_Read() | CONTROL_BAND_TX);//Geminus:Turn on PA
 237   3                      E_cw_hold = TRUE;                                   //CW_Hold_Control will set this to FAL
             -SE when the timer expires
 238   3                      CW_Hold_Control_Write(CW_CONTROL_RESET);            //Reset and start CW hold timer
 239   3                      state = 5;
 240   3                  }else{
 241   3                      control_status = control_status & ~CONTROL_AMP;     //Turn ON the AMP port - Negative logi
             -c level
 242   3                      state = 4;
 243   3                  }
 244   2                  Control_Write(control_status);
 245   2                  break;
 246   2              case 4:
 247   2                  Control_Write(Control_Read() & ~CONTROL_RX);        //Turn ON PA - Negative logic level. PA co
             -ntrols CW ON/OFF 
 248   2                  Band_Control_Write(Band_Control_Read() | CONTROL_BAND_TX);//Geminus:Turn on PA
 249   2                  E_cw_hold = TRUE;                                   //CW_Hold_Control will set this to FALSE w
             -hen the timer expires
 250   2                  CW_Hold_Control_Write(CW_CONTROL_RESET);            //Reset and start CW hold timer
 251   2                  state++;                                            //KEY is DOWN and PA output is now ON
 252   2                  break;
 253   2              case 5: //Now check if KEY is UP
 254   2                  paddles_section = CyEnterCriticalSection();
 255   2                  key = Status_Read();
 256   2                  CyExitCriticalSection(paddles_section);
 257   2                  if (key & STATUS_KEY_0)  E_key_0 = TRUE; else E_key_0 = FALSE;
 258   2                  if (key & STATUS_KEY_1)  E_key_1 = TRUE; else E_key_1 = FALSE;
 259   2                  if((E_key_0 && E_key_1)){ //KEY is UP.  If NOT then the KEY is still down and nothing changes.
 260   3                      state++;
 261   3                  }
 262   2                  break;
 263   2              case 6: //KEY is UP
 264   2                  Control_Write(Control_Read() | CONTROL_RX);         //Turn OFF PA - Negative logic level
 265   2                  Band_Control_Write(Band_Control_Read() & ~CONTROL_BAND_TX); //Geminus:Turn off PA
 266   2                  state++;
 267   2                  break;
 268   2              case 7: //Check CW hold timer.  KEY is UP
 269   2                  if(E_cw_hold == FALSE){ //KEY is UP and timer expired.
 270   3                     SI5351_status = si5351aSetFrequency(CW_LO_Freq);    //Set the LO to the CW RX dial frequenc
             -y
 271   3                      if(SI5351_status == 0){
 272   4                          control_status = Control_Read();
 273   4                          control_status = control_status | CONTROL_AMP;  //Turn OFF the AMP port - Negative log
             -ic level
 274   4                          control_status = control_status | CONTROL_DOUT; //Turn ON output from PCM3060
 275   4                          Control_Write(control_status);
 276   4                          E_key_down = FALSE;
 277   4                          state = 0;                                   //Return to idle state
 278   4                      }                           
 279   3                  }else{
 280   3                      state = 10;//KEY is UP but timer is still running. Check for KEY DOWN
 281   3                  }
 282   2                  break;
 283   2              case 10: //Timer is still running but the KEY is UP.  Check for KEY DOWN
 284   2                  paddles_section = CyEnterCriticalSection();
 285   2                  key = Status_Read();
 286   2                  CyExitCriticalSection(paddles_section);
C51 COMPILER V9.51   CW                                                                    03/03/2025 12:10:05 PAGE 6   

 287   2                  if (key & STATUS_KEY_0)  E_key_0 = TRUE; else E_key_0 = FALSE;
 288   2                  if (key & STATUS_KEY_1)  E_key_1 = TRUE; else E_key_1 = FALSE;
 289   2                  //Check if KEY is down
 290   2                  if(!E_key_0 || !E_key_1){ //Key is DOWN
 291   3                      state = 4; //KEY is DOWN. TURN ON PA in state 4
 292   3                  }else{
 293   3                      state = 7; //KEY is UP.  Check timer state;
 294   3                  }
 295   2                  break;
 296   2          }
 297   1      }
