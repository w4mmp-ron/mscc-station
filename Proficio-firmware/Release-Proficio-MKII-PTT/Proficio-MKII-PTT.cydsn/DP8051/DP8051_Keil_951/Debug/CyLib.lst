1667   1          CyDelayUs(1u);
1668   1      
1669   1          (void) CyVdStickyStatus(CY_VD_LVID);
1670   1      
1671   1          if(0u != reset)
1672   1          {
1673   2              CY_VD_PRES_CONTROL_REG |= CY_VD_PRESD_EN;
1674   2          }
1675   1          else
1676   1          {
1677   2              CY_VD_PRES_CONTROL_REG &= ((uint8)(~CY_VD_PRESD_EN));
1678   2          }
