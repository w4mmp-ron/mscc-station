 850          void si5351_set_clock_disable(enum si5351_clock clk, enum si5351_clock_disable dis_state)
 851          {
 852   1              uint8_t reg_val, reg = 0;
 853   1      
 854   1              if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 855   1              {
 856   2                      reg = SI5351_CLK3_0_DISABLE_STATE;
