00852E E0                MOVX     A,@DPTR
00852F 4410              ORL      A,#010H
008531 F0                MOVX     @DPTR,A
008532         ?C0085?CYFLASH:
  695: 
  696:     while(0u == (CY_FLASH_SPC_FM_EE_CR_REG & CY_FLASH_EE_EE_AWAKE))
008532 904700            MOV      DPTR,#04700H
008535 E0                MOVX     A,@DPTR
008536 5420              ANL      A,#020H
008538 60F8              JZ       ?C0085?CYFLASH
LX51 LINKER/LOCATER V4.64.0.0                                                         11/12/2026  20:13:02  PAGE 151


  697:     {
  698:         /* Non-zero status denotes that the EEPROM/Flash is awake & powered. */
  699:     }
00853A         ?C0086?CYFLASH:
