 352          /*
 353           * Legacy CW (relay T/R):
 354           *  - CONTROL_RX / CONTROL_AMP: latched for the whole semi-break-in session
 355           *    (first key-down until CW hold timer expires). Avoids relay chatter.
 356           *  - CONTROL_DIN: element keying — enables audio/I/Q into PCM3060 (mark);
 357           *    clear blanks I/Q (space). Rig has no RF without I/Q.
 358           *  - CONTROL_DOUT: mute RX audio for the session (unchanged role).
 359           * PIN-diode MKII path keyed CONTROL_RX per element; that is wrong for relays.
 360           * Backup: cw.c.bak-pre-legacy-din-key
C51 COMPILER V9.51   CW                                                                    10/26/2026 10:09:12 PAGE 7   

 361           */
 362          
 363          /* Manage_Paddles_Port state machine (legacy semi-break-in) */
 364          #define CW_ST_IDLE          0   /* track LO; wait to sample key */
 365          #define CW_ST_WAIT_KEY      1   /* sample key-down to start session */
 366          #define CW_ST_SESSION_START 2   /* mute DOUT, blank DIN, LO → TX */
 367          #define CW_ST_MARK          3   /* latch AMP+RX (if needed) + DIN on, restart hang */
 368          #define CW_ST_MARK_HOLD     5   /* stay in mark while key down */
 369          #define CW_ST_SPACE         6   /* DIN off only */
 370          #define CW_ST_HANG          7   /* key up: hang timer or re-key */
 371          #define CW_ST_HANG_POLL     10  /* hang active: poll key */
 372          #define CW_ST_DLY_KEYING    20  /* non-QSK: ISR keying DIN; wait key up and delayed RF done */
 373          #define CW_ST_DLY_HANG      21  /* non-QSK: hang timer running, DIN off, AMP+PA on */
 374          #define CW_ST_DLY_END       22  /* non-QSK: back to RX */
 375          
 376          /* Sample paddle status bits into E_key_0 / E_key_1. Returns TRUE if key down. */
 377          static uint8_t cw_keys_down(void)
 378          {
 379   1          uint8 key;
 380   1          uint8 section;
 381   1      
 382   1          section = CyEnterCriticalSection();
 383   1          key = Status_Read();
 384   1          CyExitCriticalSection(section);
 385   1          if (key & STATUS_KEY_0)
 386   1              E_key_0 = TRUE;
 387   1          else
 388   1              E_key_0 = FALSE;
 389   1          if (key & STATUS_KEY_1)
 390   1              E_key_1 = TRUE;
 391   1          else
 392   1              E_key_1 = FALSE;
 393   1          /* Either contact closed → key down (same test as before) */
 394   1          return (uint8_t)(!E_key_0 || !E_key_1);
 395   1      }
 396          
 397          /* Mute RX (DOUT), blank TX I/Q (DIN), LO → CW TX offset. Returns SI5351 status (0=ok). */
 398          static uint8 cw_session_start(void)
 399          {
 400   1          uint8_t c;
 401   1      
 402   1          c = Control_Read();
 403   1          c = c & ~CONTROL_DOUT;   /* PCM3060 RX out OFF */
 404   1          c = c & ~CONTROL_DIN;    /* I/Q blank until mark */
 405   1          Control_Write(c);
 406   1          return si5351aSetFrequency(CW_LO_Freq + E_cw_pitch_freq);
 407   1      }
 408          
 409          /*
 410           * Latch AMP+RX for hang (idempotent if already on) + DIN mark.
 411           * Hang timer starts on key-up (cw_mark_off), not here — so a long hold
 412           * does not burn TX_HOLD before release.
 413           */
 414          static void cw_mark_on(void)
 415          {
 416   1          uint8_t c;
 417   1      
 418   1          c = Control_Read();
 419   1          c = c & ~CONTROL_AMP;    /* AMP ON (active low) */
 420   1          c = c & ~CONTROL_RX;     /* PA / T-R ON (active low) */
 421   1          c = c | CONTROL_DIN;     /* I/Q on → RF */
 422   1          Control_Write(c);
C51 COMPILER V9.51   CW                                                                    10/26/2026 10:09:12 PAGE 8   

 423   1          /* Keep hold flag true while keying so we never "end session" mid-mark */
 424   1          E_cw_hold = TRUE;
 425   1      }
 426          
 427          /* Key-up space: blank I/Q; start/restart semi-break-in hang timer. */
 428          static void cw_mark_off(void)
 429          {
 430   1          Control_Write(Control_Read() & ~CONTROL_DIN);
 431   1          E_cw_hold = TRUE;
 432   1          CW_Hold_Control_Write(CW_CONTROL_RESET);
 433   1      }
 434          
 435          /*
 436           * Non-QSK first key down: AMP + PA (T/R relays) on now, I/Q blanked, and start recording
 437           * the key so the ISR can open DIN key_delay_ms later, after the relays settle.
 438           */
 439          static void cw_delay_start(void)
 440          {
 441   1          uint8_t c;
 442   1          uint8 i;
 443   1      
 444   1          if (!dac_muted) cw_dac_mute(TRUE); //normally already muted in idle
 445   1          for(i = 0; i < KEY_DELAY_BUF_SIZE; i++) key_delay_buf[i] = 0; //ISR not active yet so no race
 446   1          key_delay_ms = E_key_delay_ms;
 447   1          if (key_delay_ms < KEY_DELAY_MIN_MS) key_delay_ms = KEY_DELAY_MIN_MS;   //ISR needs key_delay_ms > DAC
             -_RISE_LEAD_MS
 448   1          key_up_ms = 0;          //Key is down now
 449   1          key_delay_busy = TRUE;
 450   1          key_delay_lo_ready = FALSE;
 451   1          rf_on = FALSE;
 452   1          rf_off_ms = 255;
 453   1          dac_req = DAC_REQ_NONE;
 454   1          key_delay_active = TRUE;
 455   1          c = Control_Read();
 456   1          c = c & ~CONTROL_AMP;    /* AMP ON (active low) */
 457   1          c = c & ~CONTROL_RX;     /* PA / T-R ON (active low) */
 458   1          c = c & ~CONTROL_DIN;    /* I/Q blank until the ISR opens it */
 459   1          Control_Write(c);
 460   1          E_cw_hold = TRUE;
 461   1      }
 462          
 463          /* Hang expired: LO → RX, drop AMP/RX, restore RX audio. Returns SI5351 status (0=ok). */
 464          static uint8 cw_session_end(void)
 465          {
 466   1          uint8_t c;
 467   1          uint8 st;
 468   1      
 469   1          st = si5351aSetFrequency(CW_LO_Freq);
 470   1          if (st != 0)
 471   1              return st;
 472   1          /* DIN already blanked in cw_mark_off() / by the key delay ISR */
 473   1          c = Control_Read();
 474   1          c = c | CONTROL_AMP | CONTROL_RX | CONTROL_DOUT; /* AMP off, PA off, RX audio on */
 475   1          Control_Write(c);
 476   1          Control_Write(Control_Read() | CONTROL_DIN);     /* TX I/Q on again (power-up state) so SSB/digital wo
             -rk after CW */
 477   1          E_key_down = FALSE;
 478   1          return 0;
 479   1      }
