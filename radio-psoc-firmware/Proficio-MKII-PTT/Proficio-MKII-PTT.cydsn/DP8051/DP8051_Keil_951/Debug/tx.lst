 115   2                  break;
 116   2              case 12: // Non-QSK: PA off, waiting for RF to die before AMP off
 117   2                  if ((uint8)(E_ms_tick - start_tick) >= AMP_RELEASE_MS) {
 118   3                      Control_Write(Control_Read() | CONTROL_AMP);
 119   3                      TX_DAC_Mute(FALSE);                             //DAC back at full for RX / next over
 120   3                      state = 0;
 121   3                  }
