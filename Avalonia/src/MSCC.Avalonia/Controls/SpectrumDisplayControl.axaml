<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MSCC.Avalonia.Controls.SpectrumDisplayControl"
             Background="#FF0A0A12"
             MinHeight="180"
             ClipToBounds="True">
  <Grid>
    <Image x:Name="SpectrumImage"
           Stretch="Fill"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch" />
    <!-- WPF port: PEAK MARKER readout (top right, so the hint stays readable) -->
    <Border x:Name="PeakMarkerBox"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,4,6,0" Padding="5,2"
            Background="#CC222200" BorderBrush="#FFEECC00" BorderThickness="1" CornerRadius="2"
            IsHitTestVisible="False" IsVisible="False">
      <TextBlock x:Name="PeakMarkerText"
                 FontFamily="Consolas, Courier New, monospace"
                 FontSize="13" FontWeight="Bold" Foreground="#FFEECC00"/>
    </Border>
    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="6,4,0,0" Padding="6,2"
            Background="#AA222222" CornerRadius="3"
            IsHitTestVisible="False">
      <TextBlock x:Name="HintText"
                 Text="Spectrum / waterfall — click to tune"
                 FontSize="11"
                 Foreground="#FF88AACC"
                 FontFamily="Consolas, Courier New, monospace" />
    </Border>
  </Grid>
</UserControl>
