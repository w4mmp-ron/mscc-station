 225   1          static uint8 soft_ms_hold = 0;     /* 1 = keep MS, PLL-only update */
 226   1          static uint8 clk0_blanked = 0;     /* 1 = CLK0 powered down for hard retune */
 227   1          static uint8 hard_blank_hold = 0;  /* post-reset blank countdown */
 228   1          float delta_freq ,ppm, f;
 229   1          int32 delta_freq_int;
 230   1          static uint8 state = 0;
 231   1          uint8 pll_status;
 232   1          uint8 multi_status;
 233   1          static int8 l_ppm_int;
 234   1          static int8 l_ppm_dec;
 235   1          uint8 try_soft;
 236   1           
 237   1          switch(state){
