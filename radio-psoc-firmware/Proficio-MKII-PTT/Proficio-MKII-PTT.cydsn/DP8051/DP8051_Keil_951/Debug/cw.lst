 149          /* Main loop only (I2C): PCM3060 DAC soft mute on / off */
 150          static void cw_dac_mute(uint8 mute)
 151          {
 152   1          PCM3060_SetRegister(PCM3060_REG_DAC_MUTE, mute ? PCM3060_DAC_MUTE_ON : PCM3060_DAC_MUTE_OFF);
 153   1          dac_muted = mute;
 154   1      }
 155          
 156          /* Main loop, on leaving CW: stop the ISR; DAC back to full for SSB / digital / TUNE */
 157          void CW_Key_Delay_Stop(void)
 158          {
 159   1          key_delay_active = FALSE;
 160   1          key_delay_busy = FALSE;
 161   1          rf_on = FALSE;
 162   1          dac_req = DAC_REQ_NONE;
 163   1          if(dac_muted) cw_dac_mute(FALSE);
 164   1      }
 165          
 166          /* Main loop only (I2C): DAC soft mute for the PTT / TUNE path in tx.c (3.241).
 167           * Shares dac_muted with CW so both paths agree on the PCM3060 state. */
 168          void TX_DAC_Mute(uint8 mute)
 169          {
 170   1          if(dac_muted != mute) cw_dac_mute(mute);
 171   1      }
