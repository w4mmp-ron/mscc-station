  41          //
  42          // Set up specified PLL with mult, num and denom
  43          // mult is 15..90
  44          // num is 0..1,048,575 (0xFFFFF)
  45          // denom is 0..1,048,575 (0xFFFFF)
  46          //
  47          uint8 setupPLL(uint8_t pll, uint8_t mult, uint32 num, uint32 denom)
  48          {
  49   1              static uint32 P1;                                       // PLL config register P1
  50   1              static uint32 P2;                                       // PLL config register P2
