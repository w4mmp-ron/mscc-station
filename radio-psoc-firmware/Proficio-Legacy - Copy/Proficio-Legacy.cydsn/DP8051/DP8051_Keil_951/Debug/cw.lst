 153          /* Main loop, on leaving CW: stop the ISR before DIN is reopened; DAC back to full for SSB */
 154          void CW_Key_Delay_Stop(void)
 155          {
 156   1          key_delay_active = FALSE;
 157   1          key_delay_busy = FALSE;
 158   1          rf_on = FALSE;
 159   1          dac_req = DAC_REQ_NONE;
 160   1          if(dac_muted) cw_dac_mute(FALSE);
 161   1      }
