  94   1      
  95   1          CY_SPC_PM_ACT_REG  &= ((uint8)(~PM_SPC_PM_EN));
  96   1          CY_SPC_PM_STBY_REG &= ((uint8)(~PM_SPC_PM_EN));
  97   1      
  98   1          /* Restore global interrupt enable state */
  99   1          CyExitCriticalSection(interruptState);
 100   1      }
