 239          void ERROR(char* msg) {
 240   1          uint8 i, beat;
 241   1          uint16 timer = 0;
 242   1          
 243   1          if(USBFS_initVar) USBFS_Stop();
 244   1          Control_Write(Control_Read() & CONTROL_LED | CONTROL_AMP | CONTROL_RX);
