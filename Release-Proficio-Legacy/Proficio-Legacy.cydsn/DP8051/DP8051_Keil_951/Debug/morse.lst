  25          #include <basic-plus.h>
  26          
  27          // MCODE is an 8-bit-per-chararcter morse code encoding macro.
  28          // Dots are represented as 1s; dashs are 3s. The length is stored in the three
  29          // lowest bits. Dots are encoded as binary 0; dashes are 1; left aligned.
  30          // For example, letter Q is encoded as "1101" plus a filler "0" then "100".
  31          // The astute bit twiddler will notice that bit 0x40 is part of both
  32          // the code and length; a stored length of 0 is interpreted as 6.
  33          // Use MCODE(0) to indicate a character with no valid morse code.
  34          // These invalid characters will have a stored length of 7.
  35          #define MCODE_L(x) (((x&0x0000000FLU)?1:0)\
  36          +((x&0x000000F0LU)?1:0)\
  37          +((x&0x00000F00LU)?1:0)\
  38          +((x&0x0000F000LU)?1:0)\
  39          +((x&0x000F0000LU)?1:0)\
  40          +((x&0x00F00000LU)?1:0))
  41          #define MCODE_C(x) (((x&0x00000002LU)?1:0)\
  42          +((x&0x00000020LU)?2:0)\
  43          +((x&0x00000200LU)?4:0)\
  44          +((x&0x00002000LU)?8:0)\
  45          +((x&0x00020000LU)?16:0)\
  46          +((x&0x00200000LU)?32:0))
  47          #define MCODE_6(x) (((x&0x00F00000LU)?4:0)\
  48          + ((((x&0x00F00000LU)?1:0) & ((x&0x00000002LU)?0:1))?2:0))
  49          #define MCODE(d)((uint8) (d==0)?7:MCODE_L(0x##d##LU)\
  50          + (MCODE_C(0x##d##LU) << 8 - MCODE_L(0x##d##LU))\
  51          - MCODE_6(0x##d##LU))
  52          
