 895          *   a SET_CONFIGURATION request and cleared in this function.
 896          *
 897          *******************************************************************************/
 898          uint8 USBFS_IsConfigurationChanged(void) 
 899          {
 900   1          uint8 res = 0u;
 901   1      
 902   1          if (USBFS_configurationChanged != 0u)
 903   1          {
 904   2              res = USBFS_configurationChanged;
 905   2              USBFS_configurationChanged = 0u;
 906   2          }
 907   1      
 908   1          return (res);
 909   1      }
