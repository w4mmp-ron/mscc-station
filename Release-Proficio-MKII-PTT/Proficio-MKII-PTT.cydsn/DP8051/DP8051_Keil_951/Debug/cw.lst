 244          void Manage_Paddles_Port(void)  
 245          {
 246   1          uint8 key;
 247   1          uint8 paddles_section;
 248   1          static uint8_t state = 0;
 249   1          uint8_t control_status = 0;
 250   1          static uint32 previous_CW_LO_Freq = 0;
 251   1          
 252   1          switch(state){  //When in CW mode Manage_Paddles_Port manages the LO freq.
 253   2              case 0:     //Idle state
 254   2                  if(previous_CW_LO_Freq != CW_LO_Freq){
 255   3                      SI5351_status = si5351aSetFrequency(CW_LO_Freq);
 256   3                      if(SI5351_status == 0){
 257   4                          previous_CW_LO_Freq = CW_LO_Freq;
 258   4                          if(!TX_Inhibit && (E_host_mode == 'C')){ //Do not process the CW KEY if TX_Inhibit act
             -ive and NOT in CW mode
 259   5                              state++; //Now check for key down
 260   5                          }
 261   4                      }
 262   3                  }else{
 263   3                      if(!TX_Inhibit && (E_host_mode == 'C')){ //Do not process the CW KEY if TX_Inhibit active 
             -and NOT in CW mode
 264   4                          state++; //CW_LO_Freq did not change. Now check for key down
 265   4                      }
 266   3                  }            
 267   2                  break;
 268   2              case 1: //Check for KEY DOWN
 269   2                  paddles_section = CyEnterCriticalSection();
 270   2                  key = Status_Read();
 271   2                  CyExitCriticalSection(paddles_section);
 272   2                  if (key & STATUS_KEY_0)  E_key_0 = TRUE; else E_key_0 = FALSE;
 273   2                  if (key & STATUS_KEY_1)  E_key_1 = TRUE; else E_key_1 = FALSE;
 274   2                  if(!E_key_0 || !E_key_1){ //Key is DOWN   
 275   3                      E_key_down = TRUE;
 276   3                      state++;
 277   3                  }else{
 278   3                      state = 0;//Key is not down return to idle state
 279   3                  }
 280   2                  break;
 281   2              case 2: //A KEY is down and the CW Hold timer is not running
 282   2                  Control_Write(Control_Read() & ~CONTROL_DOUT);          //Turn OFF output from PCM3060. Do NOT
             - Receive the Audio
 283   2                  SI5351_status = si5351aSetFrequency(CW_LO_Freq + E_cw_pitch_freq); //Set the LO to the CW TX f
             -requency
 284   2                  if(SI5351_status == 0){
 285   3                      state++;   
 286   3                  }
 287   2                  break;
 288   2              case 3:
 289   2                  control_status = Control_Read();
 290   2                  if(E_QSK == TRUE){//The Potentia 50 / 100 is attached.  They are QSK. Turn on the AMP port and
             - the PA now.
 291   3                      control_status = control_status & ~CONTROL_AMP;     //Turn ON the AMP port - Negative logi
             -c level
 292   3                      control_status = control_status & ~CONTROL_RX;      //Turn ON PA - Negative logic level. P
             -A controls CW ON/OFF 
 293   3                      E_cw_hold = TRUE;                                   /* hang timer starts on key-up (case 6
C51 COMPILER V9.51   CW                                                                    08/14/2026 12:27:16 PAGE 6   

             -) */
 294   3                      state = 5;
 295   3                  }else{
 296   3                      control_status = control_status & ~CONTROL_AMP;     //Turn ON the AMP port - Negative logi
             -c level
 297   3                      state = 4;
 298   3                  }
 299   2                  Control_Write(control_status);
 300   2                  break;
 301   2              case 4:
 302   2                  Control_Write(Control_Read() & ~CONTROL_RX);        //Turn ON PA - Negative logic level. PA co
             -ntrols CW ON/OFF 
 303   2                  E_cw_hold = TRUE;                                   /* hang timer starts on key-up (case 6) */
 304   2                  state++;                                            //KEY is DOWN and PA output is now ON
 305   2                  break;
 306   2              case 5: //Now check if KEY is UP
 307   2                  paddles_section = CyEnterCriticalSection();
 308   2                  key = Status_Read();
 309   2                  CyExitCriticalSection(paddles_section);
 310   2                  if (key & STATUS_KEY_0)  E_key_0 = TRUE; else E_key_0 = FALSE;
 311   2                  if (key & STATUS_KEY_1)  E_key_1 = TRUE; else E_key_1 = FALSE;
 312   2                  if((E_key_0 && E_key_1)){ //If KEY is UP go to state 6.  If NOT then the KEY is still down and
             - nothing changes.
 313   3                      state++;
 314   3                  }
 315   2                  break;
 316   2              case 6: //KEY is UP — start semi-break-in hang (not on key-down)
 317   2                  Control_Write(Control_Read() | CONTROL_RX);         //Turn OFF PA - Negative logic level
 318   2                  E_cw_hold = TRUE;
 319   2                  CW_Hold_Control_Write(CW_CONTROL_RESET);
 320   2                  state++;
 321   2                  break;
 322   2              case 7: //Check CW hold timer.  KEY is UP
 323   2                  if(E_cw_hold == FALSE){ //KEY is UP and timer expired.
 324   3                      SI5351_status = si5351aSetFrequency(CW_LO_Freq);    //Set the LO to the CW RX dial frequen
             -cy
 325   3                      if(SI5351_status == 0){
 326   4                          control_status = Control_Read();
 327   4                          control_status = control_status | CONTROL_AMP;  //Turn OFF the AMP port - Negative log
             -ic level
 328   4                          control_status = control_status | CONTROL_DOUT; //Turn ON output from PCM3060
 329   4                          Control_Write(control_status);
 330   4                          E_key_down = FALSE;
 331   4                          state = 0;                                   //Return to idle state
 332   4                      }                                  
 333   3                  }else{
 334   3                      state = 10;//KEY is UP but timer is still running. Check for KEY DOWN
 335   3                  }
 336   2                  break;
 337   2              case 10: //Timer is still running but the KEY is UP.  Check for KEY DOWN
 338   2                  paddles_section = CyEnterCriticalSection();
 339   2                  key = Status_Read();
 340   2                  CyExitCriticalSection(paddles_section);
 341   2                  if (key & STATUS_KEY_0)  E_key_0 = TRUE; else E_key_0 = FALSE;
 342   2                  if (key & STATUS_KEY_1)  E_key_1 = TRUE; else E_key_1 = FALSE;
 343   2                  //Check if KEY is down
 344   2                  if(!E_key_0 || !E_key_1){ //Key is DOWN
 345   3                      state = 4; //KEY is DOWN. TURN ON PA in state 4
 346   3                  }else{
 347   3                      state = 7; //KEY is UP.  Check timer state;
 348   3                  }
 349   2                  break;
