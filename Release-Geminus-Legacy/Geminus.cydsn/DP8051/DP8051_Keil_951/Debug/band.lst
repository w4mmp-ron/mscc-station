             - mWattmeter band number
  38          
  39          uint8 Band_Main(void) {
  40   1          static uint32 i;
  41   1         
  42   1          if (i != E_current_LO_freq) {
  43   2              i = E_current_LO_freq;
  44   2              // Watch for special IQ reversal frequencies
  45   2              /*switch (i) {
  46   2                  case 33333333: Audio_IQ_Channels = 0; // 33.333333 MHz
  47   2                      break; 
  48   2                  case 33444444: Audio_IQ_Channels = 1; // 33.444444 MHz
  49   2                      break; 
  50   2                  case 33555555: Audio_IQ_Channels = 2; // 33.555555 MHz
  51   2                      break;
C51 COMPILER V9.51   BAND                                                                  11/29/2024 11:36:26 PAGE 2   

  52   2                  case 33666666: Audio_IQ_Channels = 3; // 33.666666 MHz
  53   2              } //End of switch (i)
  54   2              */
  55   2              if (i > 55000000) T1_Band_Number = 12; // 55.000 MHz (This will not be set. Proficio doesn't go th
             -is high anyway)
  56   2              else if (i > 31000000) T1_Band_Number = 11; // 31.000 MHz (This will not be set. Proficio doesn't 
             -go this high anyway)
  57   2              else if (i > 26000000) T1_Band_Number = 10; // 26.000 MHz
  58   2              else if (i > 22000000) T1_Band_Number = 9; // 22.000 MHz
  59   2              else if (i > 19000000) T1_Band_Number = 8; // 19.000 MHz
  60   2              else if (i > 16000000) T1_Band_Number = 7; // 16.000 MHz
  61   2              else if (i > 12000000) T1_Band_Number = 6; // 12.000 MHz
  62   2              else if (i > 9000000) T1_Band_Number = 5; // 9.000 MHz
  63   2              else if (i > 6000000) T1_Band_Number = 4; // 6.000 MHz
  64   2              else if (i > 5000000) T1_Band_Number = 3; // 5.000 MHz
  65   2              else if (i > 3000000) T1_Band_Number = 2; // 3.000 MHz
  66   2              else if (i > 1500000) T1_Band_Number = 1; // 1.500 MHz
  67   2              else T1_Band_Number = 0;
  68   2                          
  69   2              // Set the correct LPF and BPF
  70   2               if  (i > 400000)  {
  71   3                  Band_Control_Write(CONTROL_BAND_630);  // 630M Set filter - relay - Amplifier
  72   3              } else  {
  73   3                  Band_Control_Write(CONTROL_BAND_2200);  //2200M filter - relay - Amplfier
  74   3              }
  75   2              //Inhibit transmitter as necessary
  76   2              //Allow TX only on the ham bands to keep the FCC happy
  77   2              //Also Set the Band Indicator and PCM3060 Output Volume
  78   2              TX_Inhibit = 1;//Default to disable TX
  79   2              if (i >= 120000 && i <= 140000) {
  80   3                  E_band = BAND_2200M;
  81   3                  TX_Inhibit = 0;
  82   3              }//2200M 
  83   2              else if (i >= 400000 && i <= 500000) {
  84   3                  E_band = BAND_630M;
  85   3                  TX_Inhibit = 0;
  86   3              }//630M
  87   2            
  88   2              //E_meter_band = Band_Map[E_band][0];
