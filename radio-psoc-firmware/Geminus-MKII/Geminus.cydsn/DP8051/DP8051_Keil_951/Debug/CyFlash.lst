 159   3                  if(CYRET_STARTED == status)
 160   3                  {
 161   4                      while(CY_SPC_BUSY)
 162   4                      {
 163   5                          /* Wait for SPC to finish and get SPC status */
 164   5                          CyDelayUs(1u);
 165   5                      }
 166   4                      
 167   4                      /* Hide SPC status */
 168   4                      if(CY_SPC_STATUS_SUCCESS == CY_SPC_READ_STATUS)
 169   4                      {
 170   5                          status = CYRET_SUCCESS;
