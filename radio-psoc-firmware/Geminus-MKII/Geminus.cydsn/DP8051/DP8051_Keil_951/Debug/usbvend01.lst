  43          int32 swap32_int(int32 original) CYREENTRANT {
  44   1          uint8 *r, *o;
  45   1          int32 ret;
  46   1          r = (void*)&ret;
  47   1          o = (void*)&original;
  48   1          r[0] = o[3];
  49   1          r[1] = o[2];
  50   1          r[2] = o[1];
  51   1          r[3] = o[0];
  52   1          return ret;
