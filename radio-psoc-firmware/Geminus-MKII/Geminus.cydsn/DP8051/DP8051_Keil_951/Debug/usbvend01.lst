 443   3                      E_reboot_request = REBOOT_REQ_BOOTLOADER;
 444   3                      break;
 445   3      
 446   3                  /* Keyer update (cw.c Keyer_Boot_Main): store one I2C pass-through request.
 447   3                   * wValue = I2C address (keyer app 0x40 or keyer bootloader 0x5C only), wIndex =
 448   3                   * bytes to read after the write (0..16), data = bytes to write (0..18). Anything
 449   3                   * else, or a request while one is still running: not handled (stall). */
 450   3                  case CMD_KEYER_BOOT:
 451   3                      l_kb_len = ((uint16)CY_GET_REG8(USBFS_lengthHi) << 8) | CY_GET_REG8(USBFS_length);
 452   3                      if (E_kb_state == KB_RECEIVING || E_kb_state == KB_PENDING) break;
 453   3                      if (CY_GET_REG8(USBFS_wValueHi) != 0u || CY_GET_REG8(USBFS_wIndexHi) != 0u) break;
 454   3                      E_kb_addr = CY_GET_REG8(USBFS_wValueLo);
 455   3                      if (E_kb_addr != KEYER_APP_ADDRESS && E_kb_addr != KEYER_BOOT_ADDRESS) break;
 456   3                      if (CY_GET_REG8(USBFS_wIndexLo) > KB_MAX_RD || l_kb_len > KB_MAX_WR) break;
 457   3                      E_kb_rlen = CY_GET_REG8(USBFS_wIndexLo);
 458   3                      E_kb_wlen = (uint8)l_kb_len;
 459   3                      E_kb_state = KB_RECEIVING;
 460   3                      USBFS_currentTD.pData = (void *)E_kb_wbuf;
 461   3                      USBFS_currentTD.count = E_kb_wlen;
 462   3                      requestHandled = USBFS_InitControlWrite();
 463   3                      break;
 464   3      
 465   3      
 466   3              }//End switch (reqCmd)
 467   2          }//End if ((reqType & USBFS_RQST_DIR_MASK) == USBFS_RQST_DIR_D2H)
 468   1          return(requestHandled);
 469   1      }
