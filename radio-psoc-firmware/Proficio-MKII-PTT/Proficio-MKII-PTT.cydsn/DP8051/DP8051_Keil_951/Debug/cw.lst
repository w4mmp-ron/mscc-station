 173          uint8 keyer_write(uint8_t buffer)
 174          {
 175   1              uint8_t msg_buffer = 0;
C51 COMPILER V9.51   CW                                                                    10/29/2026 12:58:46 PAGE 4   

 176   1              uint8_t ret_status = 0;
 177   1              uint8_t write_status = 0;
 178   1          uint8 buffer_written = 0;
 179   1          uint8 attempt;
 180   1      
 181   1          /*
 182   1           * PIC may NACK while busy (e.g. EEPROM write on STORE_END). Retry a few
 183   1           * times so a following PLAY is not dropped and keyer not marked missing.
 184   1           */
 185   1          msg_buffer = buffer;
 186   1          for (attempt = 0; attempt < 8u; attempt++) {
 187   2              write_status = I2C_DISPLAY_MasterWriteBuf(KEYER_SLAVE_ADDRESS, &msg_buffer, 1u,
 188   2                  I2C_DISPLAY_MODE_COMPLETE_XFER);
 189   2              while ((I2C_DISPLAY_MasterStatus() & I2C_DISPLAY_MSTAT_WR_CMPLT) == 0u) {
 190   3              }
 191   2              buffer_written = I2C_DISPLAY_MasterGetWriteBufSize();
 192   2              if (buffer_written == 1u) {
 193   3                  ret_status = 1;
 194   3                  break;
 195   3              }
 196   2              CyDelay(5u);
 197   2          }
 198   1          return ret_status;
 199   1      }
