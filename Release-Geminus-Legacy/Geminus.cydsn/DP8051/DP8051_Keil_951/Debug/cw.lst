 186          
 187          /*
 188           * Geminus-Legacy CW (relay T/R, external keyer, no onboard PIC memories):
 189           *  - CONTROL_RX / CONTROL_AMP / CONTROL_BAND_TX (BS2): latched for the whole
 190           *    semi-break-in session. Avoids relay chatter and wear.
 191           *  - CONTROL_DIN: element keying from the key jack (external keyer or straight key).
 192           *  - CONTROL_DOUT: mute RX audio for the session.
 193           * Ported from Proficio-Legacy DIN session; Geminus also latches BS2 TX.
 194           */
 195          
 196          #define CW_ST_IDLE          0
 197          #define CW_ST_WAIT_KEY      1
 198          #define CW_ST_SESSION_START 2
 199          #define CW_ST_MARK          3
 200          #define CW_ST_MARK_HOLD     5
 201          #define CW_ST_SPACE         6
 202          #define CW_ST_HANG          7
 203          #define CW_ST_HANG_POLL     10
 204          
 205          static uint8_t cw_keys_down(void)
 206          {
 207   1          uint8 key;
 208   1          uint8 section;
 209   1      
 210   1          section = CyEnterCriticalSection();
 211   1          key = Status_Read();
 212   1          CyExitCriticalSection(section);
 213   1          if (key & STATUS_KEY_0)
 214   1              E_key_0 = TRUE;
 215   1          else
 216   1              E_key_0 = FALSE;
 217   1          if (key & STATUS_KEY_1)
 218   1              E_key_1 = TRUE;
 219   1          else
 220   1              E_key_1 = FALSE;
 221   1          return (uint8_t)(!E_key_0 || !E_key_1);
 222   1      }
 223          
 224          static uint8 cw_session_start(void)
 225          {
 226   1          uint8_t c;
 227   1      
 228   1          c = Control_Read();
 229   1          c = c & ~CONTROL_DOUT;   /* PCM3060 RX out OFF */
 230   1          c = c & ~CONTROL_DIN;    /* I/Q blank until mark */
 231   1          Control_Write(c);
 232   1          return si5351aSetFrequency(CW_LO_Freq + E_cw_pitch_freq);
 233   1      }
 234          
 235          static void cw_mark_on(void)
 236          {
 237   1          uint8_t c;
 238   1      
C51 COMPILER V9.51   CW                                                                    09/03/2026 15:23:31 PAGE 5   

 239   1          c = Control_Read();
 240   1          c = c & ~CONTROL_AMP;    /* AMP ON (active low) */
 241   1          c = c & ~CONTROL_RX;     /* PA / T-R ON (active low) */
 242   1          c = c | CONTROL_DIN;     /* I/Q on → RF */
 243   1          Control_Write(c);
 244   1          Band_Control_Write(Band_Control_Read() | CONTROL_BAND_TX); /* Geminus BS2 TX */
 245   1          E_cw_hold = TRUE;
 246   1      }
 247          
 248          static void cw_mark_off(void)
 249          {
 250   1          Control_Write(Control_Read() & ~CONTROL_DIN);
 251   1          E_cw_hold = TRUE;
 252   1          CW_Hold_Control_Write(CW_CONTROL_RESET);
 253   1      }
 254          
 255          static uint8 cw_session_end(void)
 256          {
 257   1          uint8_t c;
 258   1          uint8 st;
 259   1      
 260   1          st = si5351aSetFrequency(CW_LO_Freq);
 261   1          if (st != 0)
 262   1              return st;
 263   1          Band_Control_Write(Band_Control_Read() & ~CONTROL_BAND_TX);
 264   1          c = Control_Read();
 265   1          c = c | CONTROL_AMP | CONTROL_RX | CONTROL_DOUT | CONTROL_DIN;
 266   1          Control_Write(c);
 267   1          E_key_down = FALSE;
 268   1          return 0;
 269   1      }
 270          
 271          void Manage_Paddles_Port(void)  
 272          {
 273   1          static uint8_t state = CW_ST_IDLE;
 274   1          static uint32 previous_CW_LO_Freq = 0;
 275   1          
 276   1          switch(state){
 277   2              case CW_ST_IDLE:
 278   2                  if (previous_CW_LO_Freq != CW_LO_Freq) {
 279   3                      SI5351_status = si5351aSetFrequency(CW_LO_Freq);
 280   3                      if (SI5351_status == 0)
 281   3                          previous_CW_LO_Freq = CW_LO_Freq;
 282   3                      else
 283   3                          break;
 284   3                  }
 285   2                  if (!TX_Inhibit && (E_host_mode == 'C'))
 286   2                      state = CW_ST_WAIT_KEY;
 287   2                  break;
 288   2              case CW_ST_WAIT_KEY:
 289   2                  if (cw_keys_down()) {
 290   3                      E_key_down = TRUE;
 291   3                      state = CW_ST_SESSION_START;
 292   3                  } else {
 293   3                      state = CW_ST_IDLE;
 294   3                  }
 295   2                  break;
 296   2              case CW_ST_SESSION_START:
 297   2                  SI5351_status = cw_session_start();
 298   2                  if (SI5351_status == 0)
 299   2                      state = CW_ST_MARK;
 300   2                  break;
C51 COMPILER V9.51   CW                                                                    09/03/2026 15:23:31 PAGE 6   

 301   2              case CW_ST_MARK:
 302   2                  cw_mark_on();
 303   2                  state = CW_ST_MARK_HOLD;
 304   2                  break;
 305   2              case CW_ST_MARK_HOLD:
 306   2                  if (!cw_keys_down())
 307   2                      state = CW_ST_SPACE;
 308   2                  break;
 309   2              case CW_ST_SPACE:
 310   2                  cw_mark_off();
 311   2                  state = CW_ST_HANG;
 312   2                  break;
 313   2              case CW_ST_HANG:
 314   2                  if (E_cw_hold == FALSE) {
 315   3                      SI5351_status = cw_session_end();
 316   3                      if (SI5351_status == 0)
 317   3                          state = CW_ST_IDLE;
 318   3                  } else {
 319   3                      state = CW_ST_HANG_POLL;
 320   3                  }
 321   2                  break;
 322   2              case CW_ST_HANG_POLL:
 323   2                  if (cw_keys_down())
 324   2                      state = CW_ST_MARK;
 325   2                  else
 326   2                      state = CW_ST_HANG;
 327   2                  break;
 328   2          }
 329   1      }
