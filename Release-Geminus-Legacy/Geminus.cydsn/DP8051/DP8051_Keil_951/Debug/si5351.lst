 195          /*
 196           * si5351_init(uint8_t xtal_load_c, uint32 ref_osc_freq)
 197           *
 198           * Setup communications to the Si5351 and set the crystal
 199           * load capacitance.
 200           *
 201           * xtal_load_c - Crystal load capacitance. Use the SI5351_CRYSTAL_LOAD_*PF
 202           * defines in the header file
 203           * ref_osc_freq - Crystal/reference oscillator frequency in 1 Hz increments.
 204           * Defaults to 25000000 if a 0 is used here.
 205           *
 206           */
 207          int si5351_init(uint8_t xtal_load_c, uint32 ref_osc_freq)
 208          {
 209   1              uint8_t ret = 0;
 210   1          
 211   1          //Fake Si570_Xtal so ExtIO_Si570 does not complain
 212   1          Si570_Xtal = swap32((uint32)(SI570_STARTUP_FREQ * 112 / (float)(56.0) * 0x01000000));               
 213   1              /* Set crystal load capacitance */
 214   1              ret = si5351_write_init(SI5351_CRYSTAL_LOAD, xtal_load_c);
 215   1          
 216   1          
 217   1          
 218   1          if(ret){
 219   2                  // Change the ref osc freq if different from default
 220   2                  if (ref_osc_freq != 0)
 221   2                  {
 222   3                          E_xtal_freq = ref_osc_freq;
 223   3                  }
 224   2      
 225   2                  // Initialize the CLK outputs according to flowchart in datasheet
 226   2                  // First, turn them off
 227   2                  ret = si5351_write_init(16, 0x80);
 228   2              
 229   2                  ret = si5351_write_init(17, 0x80);
 230   2            
 231   2                  ret = si5351_write_init(18, 0x80);
 232   2             
 233   2                  // Turn the clocks back on...
 234   2                  ret = si5351_write_init(16, 0x0c);
 235   2              
 236   2                  ret = si5351_write_init(17, 0x0c);
 237   2              
 238   2                  ret = si5351_write_init(18, 0x0c);
C51 COMPILER V9.51   SI5351                                                                11/29/2024 11:36:26 PAGE 5   

 239   2              
 240   2              si5351_drive_strength(SI5351_CLK0,SI5351_DRIVE_2MA);
 241   2                      
 242   2                  // Then reset the PLLs
 243   2                  si5351_pll_reset(SI5351_PLLA);
 244   2              
 245   2                  si5351_pll_reset(SI5351_PLLB);
 246   2             
 247   2              //Shutdown clock 1 and clock 2 outputs
