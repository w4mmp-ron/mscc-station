  24          #include <basic-plus.h>
  25          #include <si5351.h>
  26          #include <si5351a.h>
  27          
  28          #define TX_LED_BLINK_ON_MS 40
  29          #define TX_LED_BLINK_OFF_MS 50
  30          
  31          uint8 TX_Request = 0;
  32          uint8 TX_Inhibit = 0;
  33          
  34          /*
  35           * Non-QSK amp sequencing, same as CW: AMP on, wait E_key_delay_ms (from TX hold) for the
  36           * amp relays to settle, then PA on. On release PA off, wait AMP_RELEASE_MS, then AMP off.
  37           * QSK amp (E_QSK TRUE) keeps the original order.
  38           */
  39          void TX_Main(void) {
  40   1          static uint8 state = 0;
  41   1          static uint8 start_tick = 0;
  42   1          static uint8 delay_ms = 0;
  43   1      
  44   1          switch (state) {
  45   2              case 0: // receiving
  46   2                  if (TX_Request && !TX_Inhibit) {
  47   3                      if(E_QSK == TRUE){
  48   4                          state = 2;
  49   4                          Control_Write(Control_Read() & ~CONTROL_RX);
  50   4                      }else{
  51   4                          Control_Write(Control_Read() & ~CONTROL_AMP);   //AMP on first - Negative logic level
  52   4                          delay_ms = E_key_delay_ms;
C51 COMPILER V9.51   TX                                                                    10/20/2026 11:01:04 PAGE 2   

  53   4                          start_tick = E_ms_tick;
  54   4                          state = 3;
  55   4                      }
  56   3                  }
  57   2                  break;
  58   2              case 2:
  59   2                  Control_Write(Control_Read() & ~CONTROL_AMP);
  60   2                  state = 10;
  61   2                  break;
  62   2              case 3: // Non-QSK: AMP on, waiting for the amp relays before PA on
  63   2                  if (!TX_Request || TX_Inhibit) {
  64   3                      Control_Write(Control_Read() | CONTROL_AMP);    //PTT dropped before PA on. AMP off
  65   3                      state = 0;
  66   3                  }else if ((uint8)(E_ms_tick - start_tick) >= delay_ms) {
  67   3                      Control_Write(Control_Read() & ~CONTROL_RX);    //PA on - Negative logic level
  68   3                      state = 10;
  69   3                  }
  70   2                  break;
  71   2              case 10: // transmitting
  72   2                  if (!TX_Request && !TX_Inhibit) {
  73   3                      if(E_QSK == TRUE){
  74   4                          Control_Write(Control_Read() & ~(CONTROL_LED) | CONTROL_AMP);
  75   4                          state = 11;
  76   4                      }else{
  77   4                          Control_Write(Control_Read() & ~(CONTROL_LED) | CONTROL_RX);    //PA off first
  78   4                          start_tick = E_ms_tick;
  79   4                          state = 12;
  80   4                      }
  81   3                   }
  82   2                 break;
  83   2              case 11:
  84   2                  Control_Write(Control_Read() | CONTROL_RX);
  85   2                  state = 0;
  86   2                  break;
  87   2              case 12: // Non-QSK: PA off, waiting for RF to die before AMP off
  88   2                  if ((uint8)(E_ms_tick - start_tick) >= AMP_RELEASE_MS) {
  89   3                      Control_Write(Control_Read() | CONTROL_AMP);
  90   3                      state = 0;
  91   3                  }
  92   2                  break;
  93   2          }
  94   1      
  95   1      }
