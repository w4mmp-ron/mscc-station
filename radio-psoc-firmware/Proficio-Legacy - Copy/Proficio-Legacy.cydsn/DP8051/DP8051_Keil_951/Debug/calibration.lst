   1          // Per-band calibration stored in the radio (RX IQ, TX IQ, power). 3.235, 2026-10-21;
   2          // 3.236 adds clear (type 6, in usbvend01.c).
   3          // 3.237: no EEPROM_UpdateTemperature() before a save (as the PPM save in settings01.c).
   4          // 3.238: no save command. Done the PPM way (Ron: "something I know works"): a value set
   5          // from the host is written to EEPROM by the radio itself, ONE row per band, with one
   6          // EEPROM_StartWrite like Set_PPM(). 3.236/3.237 hung USB on Ron's MKII at an audio
   7          // interface change ~1-3 s after a save (9 rows + a no-data control request).
   8          // Same opcode / types / sizes as the Black Pill (CMD_CALIBRATION 0xC8, see basic-plus.h),
   9          // except type 4 write (save) is gone: it stalls here.
  10          // 3.239: clear (type 6) removed: a no-data control request like the 3.236/3.237 save, the
  11          // likely hang cause. Type 6 now stalls.
  12          // The radio only stores the values; the server applies them.
  13          //
  14          // The record lives in RAM (E_cal). usbvend01.c (USB ISR) reads and writes it directly:
  15          // a set lands straight in the record, marks the band valid and marks the band dirty.
  16          // Values are raw little-endian bytes as the host sent them (the 8051 is big endian, so
  17          // the firmware never treats them as numbers).
  18          //
  19          // EEPROM: one 16-byte row per band, rows CAL_ROW_FIRST .. CAL_ROW_FIRST + 11:
  20          //   [0] 'C'  [1] version  [2] band  [3] valid bits (1 RX IQ, 2 TX IQ, 4 power)
  21          //   [4..7] RX IQ  [8..11] TX IQ  [12..13] power  [14] 0  [15] checksum (sum of 0..14)
  22          // Cal_Main() (main loop) writes one dirty row, waits for it to finish (EEPROM_Query
  23          // releases the SPC), then the next. It waits CAL_QUIET_SET passes after the last set so the
  24          // USB data stage has landed, and does not write while transmitting (rows stay dirty).
  25          // Boot: Cal_Init() loads each good row; a bad row = that band 0, not valid.
  26          //
  27          // Variable naming conventions:     E_<variable> -> Externally defined global
  28          //                                  l_<variable> -> locally defined variable
  29          //                                  All UPPERCASE -> Define
  30          
  31          #include <basic-plus.h>
  32          #include <usbvend.h>
  33          #include <STRING.H>
  34          
  35          #define CAL_ROW_FIRST   8u      // EEPROM row 0 = crystal / PPM / IQ channels (settings01.c), row 1 = keye
             -r
  36          #define CAL_ROW_MAGIC   'C'
  37          #define CAL_ROW_VERSION 2u
  38          
  39          #define CAL_ST_IDLE     0u
  40          #define CAL_ST_WAIT     1u
  41          
  42          cal_record_t E_cal;
  43          uint8 E_cal_status[2] = {CAL_SAVE_IDLE, 0u};   // [write status, 1 = loaded from EEPROM]
  44          volatile uint8 E_cal_dirty[CAL_BANDS];          // set by the ISR, cleared when the row write starts
  45          volatile uint8 E_cal_quiet = 0;                 // set by the ISR at each set
  46          
  47          static uint8 l_state = CAL_ST_IDLE;
  48          static uint8 l_row[CYDEV_EEPROM_ROW_SIZE];
  49          
  50          static uint8 Cal_Sum(const uint8 *p) {
  51   1          uint8 i, sum = 0;
  52   1      
C51 COMPILER V9.51   CALIBRATION                                                           10/26/2026 10:09:12 PAGE 2   

  53   1          for (i = 0; i < (CYDEV_EEPROM_ROW_SIZE - 1u); i++) sum += p[i];
  54   1          return sum;
  55   1      }
  56          
  57          static void Cal_Build_Row(uint8 band) {
  58   1          uint8 i, l_bit = (uint8)(1u << (band & 7u)), l_hi = band >> 3;
  59   1      
  60   1          l_row[0] = CAL_ROW_MAGIC;
  61   1          l_row[1] = CAL_ROW_VERSION;
  62   1          l_row[2] = band;
  63   1          l_row[3] = 0;
  64   1          if (E_cal.valid[0][l_hi] & l_bit) l_row[3] |= 1u;
  65   1          if (E_cal.valid[1][l_hi] & l_bit) l_row[3] |= 2u;
  66   1          if (E_cal.valid[2][l_hi] & l_bit) l_row[3] |= 4u;
  67   1          for (i = 0; i < 4u; i++) {
  68   2              l_row[4u + i] = E_cal.rx_iq[band][i];
  69   2              l_row[8u + i] = E_cal.tx_iq[band][i];
  70   2          }
  71   1          l_row[12] = E_cal.power[band][0];
  72   1          l_row[13] = E_cal.power[band][1];
  73   1          l_row[14] = 0;
  74   1          l_row[15] = Cal_Sum(l_row);
  75   1      }
  76          
  77          // Call after Settings_Init() (EEPROM_Start)
  78          void Cal_Init(void) {
  79   1          reg8 *l_ee;
  80   1          uint8 band, i, l_bit, l_hi;
  81   1      
  82   1          memset(&E_cal, 0, sizeof(E_cal));
  83   1          E_cal_status[1] = 0u;
  84   1          for (band = 0; band < CAL_BANDS; band++) {
  85   2              E_cal_dirty[band] = 0;
  86   2              l_ee = (reg8 *)(CYDEV_EE_BASE + ((uint16)(CAL_ROW_FIRST + band) * CYDEV_EEPROM_ROW_SIZE));
  87   2              for (i = 0; i < CYDEV_EEPROM_ROW_SIZE; i++) l_row[i] = l_ee[i];
  88   2              if (l_row[0] != CAL_ROW_MAGIC || l_row[1] != CAL_ROW_VERSION || l_row[2] != band ||
  89   2                  l_row[15] != Cal_Sum(l_row)) continue;
  90   2              l_bit = (uint8)(1u << (band & 7u));
  91   2              l_hi = band >> 3;
  92   2              if (l_row[3] & 1u) E_cal.valid[0][l_hi] |= l_bit;
  93   2              if (l_row[3] & 2u) E_cal.valid[1][l_hi] |= l_bit;
  94   2              if (l_row[3] & 4u) E_cal.valid[2][l_hi] |= l_bit;
  95   2              for (i = 0; i < 4u; i++) {
  96   3                  E_cal.rx_iq[band][i] = l_row[4u + i];
  97   3                  E_cal.tx_iq[band][i] = l_row[8u + i];
  98   3              }
  99   2              E_cal.power[band][0] = l_row[12];
 100   2              E_cal.power[band][1] = l_row[13];
 101   2              E_cal_status[1] = 1u;
 102   2          }
 103   1      }
 104          
 105          // Main loop: writes the rows of the bands the host set, one row at a time
 106          void Cal_Main(void) {
 107   1          cystatus l_status;
 108   1          uint8 band, l_int;
 109   1      
 110   1          switch (l_state) {
 111   2          case CAL_ST_IDLE:
 112   2              if (E_cal_quiet) {                      // a set just arrived: let the data stage land
 113   3                  E_cal_quiet--;
 114   3                  break;
C51 COMPILER V9.51   CALIBRATION                                                           10/26/2026 10:09:12 PAGE 3   

 115   3              }
 116   2              if (TX_Request || E_PTT || E_key_down) break;   // rows stay dirty until RX
 117   2              for (band = 0; band < CAL_BANDS; band++) {
 118   3                  if (E_cal_dirty[band]) break;
 119   3              }
 120   2              if (band >= CAL_BANDS) break;
 121   2              l_int = CyEnterCriticalSection();       // the ISR may set it again: that write follows
 122   2              E_cal_dirty[band] = 0;
 123   2              Cal_Build_Row(band);
 124   2              CyExitCriticalSection(l_int);
 125   2              E_cal_status[0] = CAL_SAVE_BUSY;
 126   2              l_status = EEPROM_StartWrite(l_row, (uint8)(CAL_ROW_FIRST + band));
 127   2              if (l_status == CYRET_STARTED) {
 128   3                  l_state = CAL_ST_WAIT;
 129   3              } else {
 130   3                  E_cal_dirty[band] = 1;              // SPC busy (e.g. temperature read): next pass
 131   3              }
 132   2              break;
 133   2      
 134   2          case CAL_ST_WAIT:
 135   2              l_status = EEPROM_Query();              // also releases the SPC when done
 136   2              if (l_status == CYRET_STARTED) break;   // row still being written
 137   2              E_cal_status[0] = (l_status == CYRET_SUCCESS) ? CAL_SAVE_OK : CAL_SAVE_FAILED;
 138   2              if (l_status == CYRET_SUCCESS) E_cal_status[1] = 1u;
 139   2              l_state = CAL_ST_IDLE;
 140   2              break;
 141   2      
 142   2          default:
 143   2              l_state = CAL_ST_IDLE;
 144   2              break;
 145   2          }
 146   1      }
