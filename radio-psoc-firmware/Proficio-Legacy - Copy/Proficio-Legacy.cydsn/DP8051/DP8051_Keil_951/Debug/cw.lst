 481          void Manage_Paddles_Port(void)  
 482          {
C51 COMPILER V9.51   CW                                                                    10/26/2026 10:09:12 PAGE 9   

 483   1          static uint8_t state = CW_ST_IDLE;
 484   1          static uint32 previous_CW_LO_Freq = 0;
 485   1          uint8 req;
 486   1          uint8 section;
 487   1      
 488   1          section = CyEnterCriticalSection();     //Take the ISR's DAC mute request
 489   1          req = dac_req;
 490   1          dac_req = DAC_REQ_NONE;
 491   1          CyExitCriticalSection(section);
 492   1          if (req == DAC_REQ_UNMUTE)
 493   1              cw_dac_mute(FALSE);
 494   1          else if (req == DAC_REQ_MUTE)
 495   1              cw_dac_mute(TRUE);
 496   1      
 497   1          switch(state){  //When in CW mode Manage_Paddles_Port manages the LO freq.
 498   2              case CW_ST_IDLE:
 499   2                  if (E_QSK == FALSE && !dac_muted)
 500   2                      cw_dac_mute(TRUE);  /* non-QSK: DAC muted in CW so each element can ramp up from mute */
 501   2                  /* Keep LO on dial when frequency changes; then arm key sample if CW allowed */
 502   2                  if (previous_CW_LO_Freq != CW_LO_Freq) {
 503   3                      SI5351_status = si5351aSetFrequency(CW_LO_Freq);
 504   3                      if (SI5351_status == 0)
 505   3                          previous_CW_LO_Freq = CW_LO_Freq;
 506   3                      else
 507   3                          break; /* retry LO next pass */
 508   3                  }
 509   2                  if (!TX_Inhibit && (E_host_mode == 'C'))
 510   2                      state = CW_ST_WAIT_KEY;
 511   2                  break;
 512   2              case CW_ST_WAIT_KEY:
 513   2                  if (cw_keys_down()) {
 514   3                      E_key_down = TRUE;
 515   3                      if (E_QSK == FALSE)
 516   3                          cw_delay_start(); /* relays on + record key now, before the LO change, so the first el
             -ement is not clipped */
 517   3                      state = CW_ST_SESSION_START;
 518   3                  } else {
 519   3                      state = CW_ST_IDLE;
 520   3                  }
 521   2                  break;
 522   2              case CW_ST_SESSION_START:
 523   2                  SI5351_status = cw_session_start();
 524   2                  if (SI5351_status == 0) {
 525   3                      if (E_QSK == TRUE) {
 526   4                          state = CW_ST_MARK;
 527   4                      } else {
 528   4                          key_delay_lo_ready = TRUE; /* LO on TX freq: let the ISR key DIN */
 529   4                          state = CW_ST_DLY_KEYING;
 530   4                      }
 531   3                  }
 532   2                  break;
 533   2              case CW_ST_MARK:
 534   2                  cw_mark_on();
 535   2                  state = CW_ST_MARK_HOLD;
 536   2                  break;
 537   2              case CW_ST_MARK_HOLD: // stay in mark while key down
 538   2                  if (!cw_keys_down())
 539   2                      state = CW_ST_SPACE;
 540   2                  break;
 541   2              case CW_ST_SPACE:
 542   2                  cw_mark_off();
 543   2                  state = CW_ST_HANG;
C51 COMPILER V9.51   CW                                                                    10/26/2026 10:09:12 PAGE 10  

 544   2                  break;
 545   2              case CW_ST_HANG: // wait hang timer or re-key
 546   2                  if (E_cw_hold == FALSE) {
 547   3                      SI5351_status = cw_session_end();
 548   3                      if (SI5351_status == 0)
 549   3                          state = CW_ST_IDLE;
 550   3                  } else {
 551   3                      state = CW_ST_HANG_POLL;
 552   3                  }
 553   2                  break;
 554   2              case CW_ST_HANG_POLL: // hang active: re-key only via mark_on (not relay-only path)
 555   2                  if (cw_keys_down())
 556   2                      state = CW_ST_MARK;
 557   2                  else
 558   2                      state = CW_ST_HANG;
 559   2                  break;
 560   2              case CW_ST_DLY_KEYING:
 561   2                  if (!key_delay_active) {            /* ISR stopped (left CW or TX_Inhibit) */
 562   3                      state = CW_ST_DLY_END;
 563   3                  } else if (!key_delay_busy) {
 564   3                      E_cw_hold = TRUE;               /* semi-break-in hang from end of RF */
 565   3                      CW_Hold_Control_Write(CW_CONTROL_RESET);
 566   3                      state = CW_ST_DLY_HANG;
 567   3                  }
 568   2                  break;
 569   2              case CW_ST_DLY_HANG:
 570   2                  if (!key_delay_active) {
 571   3                      state = CW_ST_DLY_END;
 572   3                  } else if (key_delay_busy) {
 573   3                      state = CW_ST_DLY_KEYING;       /* key down again during hang */
 574   3                  } else if (E_cw_hold == FALSE) {
 575   3                      key_delay_active = FALSE;
 576   3                      state = CW_ST_DLY_END;
 577   3                  }
 578   2                  break;
 579   2              case CW_ST_DLY_END:
 580   2                  SI5351_status = cw_session_end();
 581   2                  if (SI5351_status == 0)
 582   2                      state = CW_ST_IDLE;
 583   2                  break;
 584   2          }
 585   1      }
