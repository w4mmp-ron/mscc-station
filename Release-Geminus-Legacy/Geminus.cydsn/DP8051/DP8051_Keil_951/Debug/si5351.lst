 487          /*
 488           * si5351_output_enable(enum si5351_clock clk, uint8_t enable)
 489           *
 490           * Enable or disable a chosen clock
 491           * clk - Clock output
 492           *   (use the si5351_clock enum)
 493           * enable - Set to 1 to enable, 0 to disable
 494           */
 495          void si5351_output_enable(enum si5351_clock clk, uint8_t enable)
 496          {
 497   1              uint8_t reg_val;
 498   1      
 499   1              if(si5351_read(SI5351_OUTPUT_ENABLE_CTRL, &reg_val) != 0)
 500   1              {
 501   2                      return;
 502   2              }
 503   1      
 504   1              if(enable == 1)
 505   1              {
 506   2                      reg_val &= ~(1<<(uint8_t)clk);
 507   2              }
 508   1              else
 509   1              {
 510   2                      reg_val |= (1<<(uint8_t)clk);
 511   2              }
 512   1      
 513   1              si5351_write_init(SI5351_OUTPUT_ENABLE_CTRL, reg_val);
 514   1          
 515   1      }
