  25          #include <basic-plus.h>
  26          #define OPERATION_COMPLETED 3
  27          
  28          #define SYNC_SOF_CENTER 22000
  29          #define SYNC_FRAC_MIN (FracN_DEFAULT-1000)
  30          #define SYNC_FRAC_MAX (FracN_DEFAULT+500)
  31          #define SYNC_P_GAIN 0.0004
  32          #define SYNC_D_GAIN 0.5
  33          
  34          #define PLL_VERIFY_TIME 3000
  35          #define PLL_RESET_TIME 200
  36          uint8 E_sync_running = FALSE;
  37          
  38          void Sync_Start(void) {
  39   1          FracN_Start(P_DMA);
  40   1          SyncSOF_Start();
  41   1          // A pause is needed for the PLL to settle
  42   1          CyDelay(1);
  43   1      }
  44          
  45          void Sync_Main(void) {
  46   1          static uint16 frac = FracN_DEFAULT;
  47   1          static int16 prev_error = 0;
  48   1          
  49   1          static uint8 pll_resetting = 0;
  50   1          static uint16 pll_testing = PLL_VERIFY_TIME;
  51   1          static uint16 pll_diff_acc = 0, pll_error_count = 0;
  52   1          
C51 COMPILER V9.51   SYNC                                                                  08/15/2026 23:55:52 PAGE 2   

  53   1          int16 cur_error, diff, p_term, d_term;
  54   1          uint16 pos;
  55   1         
  56   1          pos = CY_GET_REG8(SyncSOF_FRAME_POS_LO__STATUS_REG);
  57   1          if (pos & 0x01) {
  58   2              pos += (uint16)CY_GET_REG8(SyncSOF_FRAME_POS_HI__STATUS_REG) << 8;
  59   2      
  60   2              cur_error = pos - SYNC_SOF_CENTER;
  61   2                  
  62   2              diff = cur_error - prev_error;
  63   2              p_term = cur_error * SYNC_P_GAIN;
  64   2              d_term = diff * SYNC_D_GAIN;
  65   2              prev_error = cur_error;
  66   2              
  67   2              frac += p_term + d_term;
  68   2              
  69   2              if (frac > SYNC_FRAC_MAX) frac = SYNC_FRAC_MAX;
  70   2              if (frac < SYNC_FRAC_MIN) frac = SYNC_FRAC_MIN;
  71   2              
  72   2              if (pll_testing) {
  73   3                  if (pll_resetting) {
  74   4                      frac = 0;
  75   4                      // Wait for PLL reset
  76   4                      if (!(--pll_resetting)) {
  77   5                          Control_Write(Control_Read() & ~CONTROL_LED);
  78   5                          frac = FracN_DEFAULT;
  79   5                          FRAC_CLK_SetDividerValue(13);
  80   5                      }
  81   4                  } else {
  82   4                      pll_testing--;
  83   4                      if (diff < 0) pll_diff_acc -= diff;
  84   4                      else pll_diff_acc += diff;
  85   4                      pll_diff_acc /= 2;
  86   4                      if (pll_diff_acc < 2) {
  87   5                          if (pll_error_count) pll_error_count--;
  88   5                      } else if (pll_diff_acc > 7) {
  89   5                          pll_error_count++;
  90   5                      }
  91   4                      if (pll_error_count > 50) {
  92   5                          pll_diff_acc = 0;
  93   5                          pll_error_count = 0;
  94   5                          pll_resetting = PLL_RESET_TIME;
  95   5                          pll_testing = PLL_VERIFY_TIME;
  96   5                          Control_Write(Control_Read() | CONTROL_LED);
  97   5                          FRAC_CLK_SetDividerValue(14);
  98   5                      }
  99   4                  }
 100   3              }
 101   2      
 102   2              FracN_Set(frac);
 103   2          }
 104   1      }
