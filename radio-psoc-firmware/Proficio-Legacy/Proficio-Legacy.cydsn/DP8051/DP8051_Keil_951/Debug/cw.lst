 488          void Manage_Paddles_Port(void)  
 489          {
 490   1          static uint8_t state = CW_ST_IDLE;
 491   1          static uint32 previous_CW_LO_Freq = 0;
 492   1          uint8 req;
 493   1          uint8 section;
 494   1      
 495   1          section = CyEnterCriticalSection();     //Take the ISR's DAC mute request
 496   1          req = dac_req;
 497   1          dac_req = DAC_REQ_NONE;
 498   1          CyExitCriticalSection(section);
 499   1          if (req == DAC_REQ_UNMUTE)
 500   1              cw_dac_mute(FALSE);
 501   1          else if (req == DAC_REQ_MUTE)
 502   1              cw_dac_mute(TRUE);
 503   1      
 504   1          switch(state){  //When in CW mode Manage_Paddles_Port manages the LO freq.
 505   2              case CW_ST_IDLE:
 506   2                  if (E_QSK == FALSE && !dac_muted)
 507   2                      cw_dac_mute(TRUE);  /* non-QSK: DAC muted in CW so each element can ramp up from mute */
 508   2                  /* Keep LO on dial when frequency changes; then arm key sample if CW allowed */
 509   2                  if (previous_CW_LO_Freq != CW_LO_Freq) {
 510   3                      SI5351_status = si5351aSetFrequency(CW_LO_Freq);
 511   3                      if (SI5351_status == 0)
 512   3                          previous_CW_LO_Freq = CW_LO_Freq;
 513   3                      else
 514   3                          break; /* retry LO next pass */
 515   3                  }
 516   2                  if (!TX_Inhibit && (E_host_mode == 'C'))
 517   2                      state = CW_ST_WAIT_KEY;
 518   2                  break;
 519   2              case CW_ST_WAIT_KEY:
 520   2                  if (cw_keys_down()) {
 521   3                      E_key_down = TRUE;
 522   3                      if (E_QSK == FALSE)
 523   3                          cw_delay_start(); /* relays on + record key now, before the LO change, so the first el
             -ement is not clipped */
 524   3                      state = CW_ST_SESSION_START;
 525   3                  } else {
 526   3                      state = CW_ST_IDLE;
 527   3                  }
 528   2                  break;
 529   2              case CW_ST_SESSION_START:
 530   2                  SI5351_status = cw_session_start();
 531   2                  if (SI5351_status == 0) {
 532   3                      if (E_QSK == TRUE) {
 533   4                          state = CW_ST_MARK;
 534   4                      } else {
 535   4                          key_delay_lo_ready = TRUE; /* LO on TX freq: let the ISR key DIN */
 536   4                          state = CW_ST_DLY_KEYING;
 537   4                      }
 538   3                  }
 539   2                  break;
 540   2              case CW_ST_MARK:
 541   2                  cw_mark_on();
 542   2                  state = CW_ST_MARK_HOLD;
 543   2                  break;
C51 COMPILER V9.51   CW                                                                    10/31/2026 18:53:24 PAGE 10  

 544   2              case CW_ST_MARK_HOLD: // stay in mark while key down
 545   2                  if (!cw_keys_down())
 546   2                      state = CW_ST_SPACE;
 547   2                  break;
 548   2              case CW_ST_SPACE:
 549   2                  cw_mark_off();
 550   2                  state = CW_ST_HANG;
 551   2                  break;
 552   2              case CW_ST_HANG: // wait hang timer or re-key
 553   2                  if (E_cw_hold == FALSE) {
 554   3                      SI5351_status = cw_session_end();
 555   3                      if (SI5351_status == 0)
 556   3                          state = CW_ST_IDLE;
 557   3                  } else {
 558   3                      state = CW_ST_HANG_POLL;
 559   3                  }
 560   2                  break;
 561   2              case CW_ST_HANG_POLL: // hang active: re-key only via mark_on (not relay-only path)
 562   2                  if (cw_keys_down())
 563   2                      state = CW_ST_MARK;
 564   2                  else
 565   2                      state = CW_ST_HANG;
 566   2                  break;
 567   2              case CW_ST_DLY_KEYING:
 568   2                  if (!key_delay_active) {            /* ISR stopped (left CW or TX_Inhibit) */
 569   3                      state = CW_ST_DLY_END;
 570   3                  } else if (!key_delay_busy) {
 571   3                      E_cw_hold = TRUE;               /* semi-break-in hang from end of RF */
 572   3                      CW_Hold_Control_Write(CW_CONTROL_RESET);
 573   3                      state = CW_ST_DLY_HANG;
 574   3                  }
 575   2                  break;
 576   2              case CW_ST_DLY_HANG:
 577   2                  if (!key_delay_active) {
 578   3                      state = CW_ST_DLY_END;
 579   3                  } else if (key_delay_busy) {
 580   3                      state = CW_ST_DLY_KEYING;       /* key down again during hang */
 581   3                  } else if (E_cw_hold == FALSE) {
 582   3                      key_delay_active = FALSE;
 583   3                      state = CW_ST_DLY_END;
 584   3                  }
 585   2                  break;
 586   2              case CW_ST_DLY_END:
 587   2                  SI5351_status = cw_session_end();
 588   2                  if (SI5351_status == 0)
 589   2                      state = CW_ST_IDLE;
 590   2                  break;
 591   2          }
