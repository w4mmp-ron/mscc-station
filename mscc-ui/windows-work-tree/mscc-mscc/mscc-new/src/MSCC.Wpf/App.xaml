<Application x:Class="MSCC.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MSCC.Wpf.Converters"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <converters:BoolToActiveBrushConverter x:Key="BoolToActiveBrushConverter"/>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToCalStatusBrushConverter x:Key="BoolToCalStatusBrushConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>

        <!-- Every tooltip wraps at 420 px (Ron 2026-11-27: a tooltip must never run wider than the window).
             Text tooltips get a wrapping TextBlock; &#x0a; line breaks still work. Element tooltips keep their own layout. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="420"/>
            <Style.Resources>
                <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Style.Resources>
        </Style>

        <!-- VFO LCD faces (from Stew's Avalonia cmd-098 look; UiVfo* keys so a skin can swap them) -->
        <SolidColorBrush x:Key="UiVfoBezelBrush" Color="#FF101214"/>
        <RadialGradientBrush x:Key="UiVfoLcdBrush" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Color="#FFFFF4C4" Offset="0"/>
            <GradientStop Color="#FFE3CF7C" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="UiVfoLcdShadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#59000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="UiVfoBevelDarkBrush" Color="#E0000000"/>
        <SolidColorBrush x:Key="UiVfoBevelLightBrush" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="UiVfoDigitBrush" Color="#FF1E1C12"/>
        <SolidColorBrush x:Key="UiVfoDigitHzBrush" Color="#FF3C3824"/>
        <SolidColorBrush x:Key="UiVfoLabelBrush" Color="#FF5A5438"/>
        <SolidColorBrush x:Key="UiVfoModeBrush" Color="#FF1E1C12"/>
        <SolidColorBrush x:Key="UiVfoRitBrush" Color="#FF8A3A00"/>
        <SolidColorBrush x:Key="UiVfoStripBrush" Color="#26000000"/>
        <SolidColorBrush x:Key="UiVfoStripTextBrush" Color="#FF2A281A"/>
        <!-- Backlight dimmer over the VFO and meter faces. Replaced at runtime from Settings -> BACKLIGHT (100 % = clear). -->
        <SolidColorBrush x:Key="UiBacklightDimBrush" Color="#00000000"/>
        <!-- Red LED dot by the active VFO's label (cmd-099). The S-meter and ALC frames also use the bezel + bevel brushes. -->
        <RadialGradientBrush x:Key="UiVfoActiveDotBrush" Center="0.5,0.5" GradientOrigin="0.4,0.35" RadiusX="0.55" RadiusY="0.55">
            <GradientStop Color="#FFFF5A4A" Offset="0"/>
            <GradientStop Color="#FFB01818" Offset="1"/>
        </RadialGradientBrush>

        <!-- PowerSDR-style "physical" slider (from Stew's Avalonia MsccPhysicalSliderTheme, 2026-11-27).
             Rails + RX/TX power sliders only; Settings and calibration sliders keep the standard look. -->
        <LinearGradientBrush x:Key="UiSliderTrackFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF050608"/>
            <GradientStop Offset="0.55" Color="#FF161920"/>
            <GradientStop Offset="1" Color="#FF2A2E36"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="UiSliderTrackBorderBrush" Color="#FF3A404A"/>
        <SolidColorBrush x:Key="UiSliderTrackHighlightBrush" Color="#FF6A7382"/>
        <LinearGradientBrush x:Key="UiSliderThumbFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFEEF1F6"/>
            <GradientStop Offset="0.16" Color="#FF8B929C"/>
            <GradientStop Offset="0.38" Color="#FF1A1C20"/>
            <GradientStop Offset="0.78" Color="#FF050506"/>
            <GradientStop Offset="1" Color="#FF3A3F48"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="UiSliderThumbBorderBrush" Color="#FFC5CAD3"/>

        <Style x:Key="MsccPhysicalTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" MinHeight="20"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MsccPhysicalThumb" TargetType="Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="1" BorderThickness="1"
                                BorderBrush="{StaticResource UiSliderThumbBorderBrush}"
                                Background="{StaticResource UiSliderThumbFillBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MsccPhysicalSlider" TargetType="Slider">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid MinHeight="22" VerticalAlignment="Center" Background="Transparent">
                            <Border Height="9" VerticalAlignment="Center" CornerRadius="1"
                                    Margin="1,0"
                                    Background="{StaticResource UiSliderTrackFillBrush}"
                                    BorderBrush="{StaticResource UiSliderTrackBorderBrush}"
                                    BorderThickness="1">
                                <Border Height="1" VerticalAlignment="Top" Margin="1,0"
                                        Background="{StaticResource UiSliderTrackHighlightBrush}"/>
                            </Border>
                            <Track x:Name="PART_Track" Orientation="Horizontal" VerticalAlignment="Center"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MsccPhysicalTrackButton}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MsccPhysicalTrackButton}"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MsccPhysicalThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
