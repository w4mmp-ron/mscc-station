<Window x:Class="MSCC.Wpf.RemoteAfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Audio"
        Height="520" Width="440"
        MinHeight="360" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource UiWindowBackgroundBrush}"
        Foreground="{DynamicResource UiPrimaryTextBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="UiWindowBackgroundBrush" Color="#FF1C1C1C"/>
        <SolidColorBrush x:Key="UiPanelBackgroundBrush" Color="#FF252525"/>
        <SolidColorBrush x:Key="UiPrimaryTextBrush" Color="White"/>
        <SolidColorBrush x:Key="UiMutedTextBrush" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="UiButtonFaceBrush" Color="#FFCC00"/>
        <SolidColorBrush x:Key="UiButtonBorderBrush" Color="#FFAA00"/>
        <SolidColorBrush x:Key="UiButtonHoverBrush" Color="#FFDD55"/>
        <SolidColorBrush x:Key="UiButtonHoverBorderBrush" Color="#FFCC00"/>
        <SolidColorBrush x:Key="UiButtonPressedBrush" Color="#FFAA00"/>
        <SolidColorBrush x:Key="UiButtonTextBrush" Color="Black"/>
        <Style x:Key="MsccGoldButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource UiButtonFaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource UiButtonTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="REMOTE AUDIO" FontWeight="SemiBold" FontSize="14"
                   Foreground="#00FFAA" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="{DynamicResource UiPanelBackgroundBrush}"
                BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="PHONES RX" FontWeight="SemiBold" Foreground="#00FFAA" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Device" VerticalAlignment="Center"
                               Foreground="{DynamicResource UiMutedTextBrush}"/>
                    <ComboBox x:Name="PlayDeviceCombo" Grid.Column="1" FontSize="11"
                              SelectionChanged="PlayDevice_Changed"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volume" VerticalAlignment="Center"
                               Foreground="{DynamicResource UiMutedTextBrush}"/>
                    <Slider x:Name="PlayVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                            Value="80" Margin="4,0" ValueChanged="PlayVolume_Changed"/>
                    <TextBlock x:Name="PlayVolumeLabel" Grid.Column="2" Text="80"
                               Foreground="#00FFAA" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
                <CheckBox x:Name="MuteCheck" Content="Mute phones" Foreground="{DynamicResource UiPrimaryTextBrush}"
                          Margin="0,0,0,4" Checked="Mute_Changed" Unchecked="Mute_Changed"/>
                <CheckBox Content="Monitor at radio" IsChecked="{Binding RemoteMonitorAtRadio}"
                          Foreground="{DynamicResource UiPrimaryTextBrush}"
                          ToolTip="Keep the shack speaker while remote RX is on (default off)."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource UiPanelBackgroundBrush}"
                BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="EQ / MIC TX" FontWeight="SemiBold" Foreground="#00FFAA" Margin="0,0,0,6"/>
                <CheckBox x:Name="EqEnableCheck" Content="Playback EQ" Foreground="{DynamicResource UiPrimaryTextBrush}"
                          Margin="0,0,0,4" Checked="Eq_Changed" Unchecked="Eq_Changed"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Low" VerticalAlignment="Center" Foreground="{DynamicResource UiMutedTextBrush}"/>
                    <Slider x:Name="EqLowSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0"
                            ValueChanged="EqSlider_Changed"/>
                </Grid>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mid" VerticalAlignment="Center" Foreground="{DynamicResource UiMutedTextBrush}"/>
                    <Slider x:Name="EqMidSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0"
                            ValueChanged="EqSlider_Changed"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="High" VerticalAlignment="Center" Foreground="{DynamicResource UiMutedTextBrush}"/>
                    <Slider x:Name="EqHighSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0"
                            ValueChanged="EqSlider_Changed"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mic" VerticalAlignment="Center" Foreground="{DynamicResource UiMutedTextBrush}"/>
                    <ComboBox x:Name="MicDeviceCombo" Grid.Column="1" FontSize="11"
                              SelectionChanged="MicDevice_Changed"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mic vol" VerticalAlignment="Center" Foreground="{DynamicResource UiMutedTextBrush}"/>
                    <Slider x:Name="MicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                            Value="80" Margin="4,0" ValueChanged="MicVolume_Changed"/>
                    <TextBlock x:Name="MicVolumeLabel" Grid.Column="2" Text="80"
                               Foreground="#00FFAA" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 Background="#111" Foreground="#D0D0D0" BorderBrush="#444"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <DockPanel Grid.Row="4">
            <Button Content="Reset EQ" Style="{StaticResource MsccGoldButtonStyle}"
                    Width="80" Click="ResetEq_Click" DockPanel.Dock="Left"/>
            <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource UiMutedTextBrush}" Text="—"/>
        </DockPanel>
    </Grid>
</Window>
