 422   5                              crc >>= 1u;
 423   5                          }
 424   4      
 425   4                          tmp >>= 1u;
 426   4                      }
 427   3      
 428   3                      size--;
 429   3                  }
 430   2                  while(0u != size);
 431   2      
 432   2                  crc = ~crc;
 433   2                  tmp = crc;
 434   2                  crc = ( uint16 )(crc << 8u) | (tmp >> 8u);
 435   2              }
 436   1      
