  24          #include <device.h>
  25          #include <basic-plus.h>
  26          //#include <si5351.h>
  27          #define N_DECIMAL_POINTS_PRECISION (1000000)
  28          
  29          uint32 convert_from_host(uint32 freq){
  30   1          volatile float fout;
  31   1          volatile uint32 int_freq, freq_in_hz/*,freq_in_hz_mhz*/,freq_in_hz_khz;
  32   1          volatile uint32 l_freq_from_host = 0;
  33   1          
  34   1          fout = (float)swap32(freq) / 0x200000;
  35   1          int_freq = (int32)fout;
  36   1          freq_in_hz_khz = ((int32)(fout*N_DECIMAL_POINTS_PRECISION)%N_DECIMAL_POINTS_PRECISION);
  37   1          freq_in_hz = (int_freq * 1000000) + freq_in_hz_khz;
  38   1          //freq_in_hz = freq_in_hz_mhz + freq_in_hz_khz;
  39   1          return freq_in_hz;
  40   1      }
  41          /* [] END OF FILE */
