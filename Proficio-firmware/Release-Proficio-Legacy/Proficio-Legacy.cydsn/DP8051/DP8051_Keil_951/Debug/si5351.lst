 242   1          
 243   1          
 244   1          
 245   1          if(ret){
 246   2                  // Change the ref osc freq if different from default
 247   2                  if (ref_osc_freq != 0)
 248   2                  {
 249   3                          E_xtal_freq = ref_osc_freq;
 250   3                  }
 251   2      
 252   2                  // Initialize the CLK outputs according to flowchart in datasheet
 253   2                  // First, turn them off
 254   2                  ret = si5351_write_init(16, 0x80);
 255   2              
 256   2                  ret = si5351_write_init(17, 0x80);
 257   2            
 258   2                  ret = si5351_write_init(18, 0x80);
