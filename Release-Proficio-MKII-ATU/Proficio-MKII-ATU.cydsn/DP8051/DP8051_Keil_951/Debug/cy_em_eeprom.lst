 659   3                              CalcChecksum((uint8 *) &writeRamBuffer[CY_EM_EEPROM_EEPROM_DATA_OFFSET_U32],
 660   3                                                        CY_EM_EEPROM_EEPROM_DATA_LEN);
 661   3              }
 662   2      
C51 COMPILER V9.51   CY_EM_EEPROM                                                          08/17/2026 08:28:33 PAGE 12  

