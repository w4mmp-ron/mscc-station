2399   1          {
2400   2              USBFS_deviceStatus |= (uint8)  USBFS_DEVICE_STATUS_SELF_POWERED;
2401   2          }
2402   1          else
2403   1          {
2404   2              USBFS_deviceStatus &= (uint8) ~USBFS_DEVICE_STATUS_SELF_POWERED;
2405   2          }
2406   1      }
