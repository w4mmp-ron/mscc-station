 175          /* ======================================================================================
 176           * Geminus 2.152 (2026-10-31): per-band calibration store, copied from Proficio MKII PTT
C51 COMPILER V9.51   SETTINGS01                                                            10/31/2026 10:02:10 PAGE 4   

 177           * calibration.c (3.238+). Kept in this file so the PSoC Creator project needs no new source.
 178           * EEPROM rows 8-19 (row 0 = crystal / PPM here; rows 8+ unused on the Geminus).
 179           * ====================================================================================== */
 180          // Per-band calibration stored in the radio (RX IQ, TX IQ, power). 3.235, 2026-10-21;
 181          // 3.236 adds clear (type 6, in usbvend01.c).
 182          // 3.237: no EEPROM_UpdateTemperature() before a save (as the PPM save in settings01.c).
 183          // 3.238: no save command. Done the PPM way (Ron: "something I know works"): a value set
 184          // from the host is written to EEPROM by the radio itself, ONE row per band, with one
 185          // EEPROM_StartWrite like Set_PPM(). 3.236/3.237 hung USB on Ron's MKII at an audio
 186          // interface change ~1-3 s after a save (9 rows + a no-data control request).
 187          // Same opcode / types / sizes as the Black Pill (CMD_CALIBRATION 0xC8, see basic-plus.h),
 188          // except type 4 write (save) is gone: it stalls here.
 189          // 3.239: clear (type 6) removed: a no-data control request like the 3.236/3.237 save, the
 190          // likely hang cause. Type 6 now stalls.
 191          // The radio only stores the values; the server applies them.
 192          //
 193          // The record lives in RAM (E_cal). usbvend01.c (USB ISR) reads and writes it directly:
 194          // a set lands straight in the record, marks the band valid and marks the band dirty.
 195          // Values are raw little-endian bytes as the host sent them (the 8051 is big endian, so
 196          // the firmware never treats them as numbers).
 197          //
 198          // EEPROM: one 16-byte row per band, rows CAL_ROW_FIRST .. CAL_ROW_FIRST + 11:
 199          //   [0] 'C'  [1] version  [2] band  [3] valid bits (1 RX IQ, 2 TX IQ, 4 power)
 200          //   [4..7] RX IQ  [8..11] TX IQ  [12..13] power  [14] 0  [15] checksum (sum of 0..14)
 201          // Cal_Main() (main loop) writes one dirty row, waits for it to finish (EEPROM_Query
 202          // releases the SPC), then the next. It waits CAL_QUIET_SET passes after the last set so the
 203          // USB data stage has landed, and does not write while transmitting (rows stay dirty).
 204          // Boot: Cal_Init() loads each good row; a bad row = that band 0, not valid.
 205          //
 206          // Variable naming conventions:     E_<variable> -> Externally defined global
 207          //                                  l_<variable> -> locally defined variable
 208          //                                  All UPPERCASE -> Define
 209          
 210          #include <usbvend.h>
 211          #include <STRING.H>
 212          
 213          #define CAL_ROW_FIRST   8u      // EEPROM row 0 = crystal / PPM / IQ channels (settings01.c), row 1 = keye
             -r
 214          #define CAL_ROW_MAGIC   'C'
 215          #define CAL_ROW_VERSION 2u
 216          
 217          #define CAL_ST_IDLE     0u
 218          #define CAL_ST_WAIT     1u
 219          
 220          cal_record_t E_cal;
 221          uint8 E_cal_status[2] = {CAL_SAVE_IDLE, 0u};   // [write status, 1 = loaded from EEPROM]
 222          volatile uint8 E_cal_dirty[CAL_BANDS];          // set by the ISR, cleared when the row write starts
 223          volatile uint8 E_cal_quiet = 0;                 // set by the ISR at each set
 224          
 225          static uint8 l_state = CAL_ST_IDLE;
 226          static uint8 l_row[CYDEV_EEPROM_ROW_SIZE];
 227          
 228          static uint8 Cal_Sum(const uint8 *p) {
 229   1          uint8 i, sum = 0;
 230   1      
 231   1          for (i = 0; i < (CYDEV_EEPROM_ROW_SIZE - 1u); i++) sum += p[i];
 232   1          return sum;
 233   1      }
 234          
 235          static void Cal_Build_Row(uint8 band) {
 236   1          uint8 i, l_bit = (uint8)(1u << (band & 7u)), l_hi = band >> 3;
 237   1      
C51 COMPILER V9.51   SETTINGS01                                                            10/31/2026 10:02:10 PAGE 5   

 238   1          l_row[0] = CAL_ROW_MAGIC;
 239   1          l_row[1] = CAL_ROW_VERSION;
 240   1          l_row[2] = band;
 241   1          l_row[3] = 0;
 242   1          if (E_cal.valid[0][l_hi] & l_bit) l_row[3] |= 1u;
 243   1          if (E_cal.valid[1][l_hi] & l_bit) l_row[3] |= 2u;
 244   1          if (E_cal.valid[2][l_hi] & l_bit) l_row[3] |= 4u;
 245   1          for (i = 0; i < 4u; i++) {
 246   2              l_row[4u + i] = E_cal.rx_iq[band][i];
 247   2              l_row[8u + i] = E_cal.tx_iq[band][i];
 248   2          }
 249   1          l_row[12] = E_cal.power[band][0];
 250   1          l_row[13] = E_cal.power[band][1];
 251   1          l_row[14] = 0;
 252   1          l_row[15] = Cal_Sum(l_row);
 253   1      }
 254          
 255          // Call after Settings_Init() (EEPROM_Start)
 256          void Cal_Init(void) {
 257   1          reg8 *l_ee;
 258   1          uint8 band, i, l_bit, l_hi;
 259   1      
 260   1          memset(&E_cal, 0, sizeof(E_cal));
 261   1          E_cal_status[1] = 0u;
 262   1          for (band = 0; band < CAL_BANDS; band++) {
 263   2              E_cal_dirty[band] = 0;
 264   2              l_ee = (reg8 *)(CYDEV_EE_BASE + ((uint16)(CAL_ROW_FIRST + band) * CYDEV_EEPROM_ROW_SIZE));
 265   2              for (i = 0; i < CYDEV_EEPROM_ROW_SIZE; i++) l_row[i] = l_ee[i];
 266   2              if (l_row[0] != CAL_ROW_MAGIC || l_row[1] != CAL_ROW_VERSION || l_row[2] != band ||
 267   2                  l_row[15] != Cal_Sum(l_row)) continue;
 268   2              l_bit = (uint8)(1u << (band & 7u));
 269   2              l_hi = band >> 3;
 270   2              if (l_row[3] & 1u) E_cal.valid[0][l_hi] |= l_bit;
 271   2              if (l_row[3] & 2u) E_cal.valid[1][l_hi] |= l_bit;
 272   2              if (l_row[3] & 4u) E_cal.valid[2][l_hi] |= l_bit;
 273   2              for (i = 0; i < 4u; i++) {
 274   3                  E_cal.rx_iq[band][i] = l_row[4u + i];
 275   3                  E_cal.tx_iq[band][i] = l_row[8u + i];
 276   3              }
 277   2              E_cal.power[band][0] = l_row[12];
 278   2              E_cal.power[band][1] = l_row[13];
 279   2              E_cal_status[1] = 1u;
 280   2          }
 281   1      }
 282          
 283          // Main loop: writes the rows of the bands the host set, one row at a time
 284          void Cal_Main(void) {
 285   1          cystatus l_status;
 286   1          uint8 band, l_int;
 287   1      
 288   1          switch (l_state) {
 289   2          case CAL_ST_IDLE:
 290   2              if (E_cal_quiet) {                      // a set just arrived: let the data stage land
 291   3                  E_cal_quiet--;
 292   3                  break;
 293   3              }
 294   2              if (TX_Request || E_PTT || E_key_down) break;   // rows stay dirty until RX
 295   2              for (band = 0; band < CAL_BANDS; band++) {
 296   3                  if (E_cal_dirty[band]) break;
 297   3              }
 298   2              if (band >= CAL_BANDS) break;
 299   2              l_int = CyEnterCriticalSection();       // the ISR may set it again: that write follows
C51 COMPILER V9.51   SETTINGS01                                                            10/31/2026 10:02:10 PAGE 6   

 300   2              E_cal_dirty[band] = 0;
 301   2              Cal_Build_Row(band);
 302   2              CyExitCriticalSection(l_int);
 303   2              E_cal_status[0] = CAL_SAVE_BUSY;
 304   2              l_status = EEPROM_StartWrite(l_row, (uint8)(CAL_ROW_FIRST + band));
 305   2              if (l_status == CYRET_STARTED) {
 306   3                  l_state = CAL_ST_WAIT;
 307   3              } else {
 308   3                  E_cal_dirty[band] = 1;              // SPC busy (e.g. temperature read): next pass
 309   3              }
 310   2              break;
 311   2      
 312   2          case CAL_ST_WAIT:
 313   2              l_status = EEPROM_Query();              // also releases the SPC when done
 314   2              if (l_status == CYRET_STARTED) break;   // row still being written
 315   2              E_cal_status[0] = (l_status == CYRET_SUCCESS) ? CAL_SAVE_OK : CAL_SAVE_FAILED;
 316   2              if (l_status == CYRET_SUCCESS) E_cal_status[1] = 1u;
 317   2              l_state = CAL_ST_IDLE;
 318   2              break;
 319   2      
 320   2          default:
 321   2              l_state = CAL_ST_IDLE;
 322   2              break;
 323   2          }
 324   1      }
