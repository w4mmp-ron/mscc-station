 623   1          while(0u == (CY_FLASH_SPC_FM_EE_CR_REG & CY_FLASH_EE_EE_AWAKE))
 624   1          {
 625   2              /* Non-zero status denotes that the EEPROM/Flash is awake & powered. */
 626   2          }
 627   1      
 628   1          CyExitCriticalSection(interruptState);
 629   1      }
