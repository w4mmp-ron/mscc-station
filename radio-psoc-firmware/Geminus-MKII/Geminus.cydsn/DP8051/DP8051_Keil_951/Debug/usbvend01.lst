  56          // Maps PSoC registers into one that looks like the AVR
  57          uint8 emulated_register(void) {
  58   1          uint8 reg = 0, key;
  59   1          if (TX_Request) reg |= 0x10;
  60   1          //key = Status_Read();
  61   1          key = E_key_down;
  62   1          if (key & STATUS_KEY_0) reg |= 0x20;
  63   1          if (key & STATUS_KEY_1) reg |= 0x02;
  64   1          return reg;
  65   1      }
