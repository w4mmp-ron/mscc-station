<UserControl x:Class="MSCC.Wpf.Controls.SwrMeterSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="560">
    <Border Background="#FF1A1A1A" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel>
            <TextBlock Text="SWR Meter" FontWeight="Bold" Foreground="#00FFAA" FontSize="13" Margin="0,0,0,4"/>
            <TextBlock Text="External WiFi SWR (HF/LF). Meter must unicast UDP to this PC. Profile follows Proficio/Geminus. Only one meter powered at a time — one listen port is enough. Auto IP from first packet."
                       Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <CheckBox x:Name="EnableCheck" Content="Enable external SWR meter"
                      FontSize="12" Foreground="#CCC" Margin="0,0,0,8"
                      Checked="OnEnableChanged" Unchecked="OnEnableChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="UDP listen port:" Width="110" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                <TextBox x:Name="PortBox" Width="70" Height="24" FontSize="11"
                         Background="#111" Foreground="#EEE" BorderBrush="#666"
                         LostFocus="OnPortLostFocus"/>
                <Button Content="Apply listen" Width="90" Height="24" Margin="8,0,0,0" FontSize="11"
                        Click="OnApplyListenClick"/>
            </StackPanel>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="HF (Proficio)" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="IP:" Width="28" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                        <TextBox x:Name="HfIpBox" Width="140" Height="24" FontSize="11"
                                 Background="#111" Foreground="#EEE" BorderBrush="#666"
                                 LostFocus="OnIpLostFocus"
                                 ToolTip="Optional. Auto-filled from UDP. Used for HTTP RESET."/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="LF (Geminus)" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="IP:" Width="28" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                        <TextBox x:Name="LfIpBox" Width="140" Height="24" FontSize="11"
                                 Background="#111" Foreground="#EEE" BorderBrush="#666"
                                 LostFocus="OnIpLostFocus"
                                 ToolTip="Optional. Auto-filled from UDP. Used for HTTP RESET."/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#00FFAA" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
