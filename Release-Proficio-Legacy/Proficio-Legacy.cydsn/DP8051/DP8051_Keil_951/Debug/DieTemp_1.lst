 203          /*******************************************************************************
 204          * Function Name: DieTemp_1_GetTempT
 205          ********************************************************************************
 206          *
 207          * Summary:
 208          *  Sends the command and parameters to the SPC to start a Die Temperature 
 209          *  reading and waits until it fails or completes. This is a blocking function.
 210          *  This function starts the temperature reading and returns the temperature 
 211          *  value after the SPC temperature command completes successfully.
 212          *
 213          * Parameters:
 214          *  temperature: Address to store the two byte temperature value.
 215          *
 216          * Return:
 217          *  CYRET_SUCCESS if the command completes successfully.
 218          *  The Status code from DieTemp_1_Start or DieTemp_1_Query.
 219          *
 220          *******************************************************************************/
 221          static cystatus DieTemp_1_GetTempT(int16 * temperature) 
 222          {
 223   1          uint16 us;
 224   1          cystatus status;
 225   1      
 226   1          /* Start the temp reading */
 227   1          status = DieTemp_1_Start();
 228   1      
 229   1          if(status == CYRET_STARTED)
 230   1          {
 231   2              /**************************************************************************
 232   2              * Wait for SPC to finish temperature reading. If state changes and SPC
 233   2              * finishes - break cycle.
 234   2              * DieTemp_1_MAX_WAIT_USEC is maximum time in usec to wait for SPC.
 235   2              **************************************************************************/
 236   2              for (us=(DieTemp_1_MAX_WAIT_USEC); us>0u; us-=DieTemp_1_USEC_STEP)
 237   2              {
 238   3                  if((CYRET_STARTED != status)&&(CY_SPC_IDLE))
 239   3                  {
C51 COMPILER V9.51   DIETEMP_1                                                             08/14/2026 10:16:40 PAGE 5   

 240   4                      break;
 241   4                  }
 242   3                  else if(CYRET_STARTED == status)
 243   3                  {
 244   4                      status = DieTemp_1_Query(temperature);
 245   4                  }
 246   3                  else
 247   3                  {
 248   4                      /* SPC has not finished reading or isn't idle */
 249   4                  }
 250   3                  CyDelayUs(DieTemp_1_USEC_STEP);
 251   3              }
 252   2          }
 253   1      
 254   1          return status;
 255   1      }
