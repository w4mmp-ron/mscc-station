 268   2                      
 269   2                  // Then reset the PLLs
 270   2                  si5351_pll_reset(SI5351_PLLA);
 271   2              
 272   2                  si5351_pll_reset(SI5351_PLLB);
 273   2             
 274   2              //Shutdown clock 1 and clock 2 outputs
