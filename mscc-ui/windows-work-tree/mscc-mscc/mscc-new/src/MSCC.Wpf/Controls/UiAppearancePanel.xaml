<UserControl x:Class="MSCC.Wpf.Controls.UiAppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="520">
    <!-- UI chrome (window bg / panel / button). Moved from S/W → Settings. -->
    <Border Background="#FF222222" BorderBrush="#444" BorderThickness="1" Padding="6">
        <StackPanel>
            <TextBlock Text="UI Appearance" FontWeight="SemiBold" Foreground="#00FFAA" Margin="0,0,0,2" FontSize="13"/>
            <TextBlock Text="Live preview. CUSTOM opens a color chart (click again to re-edit). CUSTOM background forces panel AUTO (slightly lighter)."
                       FontSize="9" Foreground="#D0D0D0" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="2,0,10,0">
                    <TextBlock Text="UI BACKGROUND" FontSize="9" Foreground="#D0D0D0" Margin="0,0,0,2"/>
                    <ListBox x:Name="UiBackgroundList" Width="80" Height="130" FontSize="10"
                             Background="#111" Foreground="White"
                             SelectionChanged="OnUiBackgroundSelectionChanged"
                             PreviewMouseLeftButtonDown="OnUiBackgroundListPreviewMouseDown"
                             ToolTip="Window background. CUSTOM = color chart. BLACK = Multus default.">
                        <ListBoxItem Content="RED"/>
                        <ListBoxItem Content="BLUE"/>
                        <ListBoxItem Content="GREEN"/>
                        <ListBoxItem Content="YELLOW"/>
                        <ListBoxItem Content="WHITE"/>
                        <ListBoxItem Content="BLACK"/>
                        <ListBoxItem Content="CUSTOM"/>
                    </ListBox>
                    <Border x:Name="UiBackgroundSwatch" Height="14" Margin="0,4,0,0" BorderBrush="#666" BorderThickness="1" Background="#1C1C1C"/>
                    <TextBlock x:Name="UiBackgroundRgbText" Text="#1C1C1C" FontSize="10" Foreground="#00FFAA" FontFamily="Consolas" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="2,0,10,0">
                    <TextBlock Text="UI PANEL" FontSize="9" Foreground="#D0D0D0" Margin="0,0,0,2"/>
                    <ListBox x:Name="UiPanelList" Width="80" Height="130" FontSize="10"
                             Background="#111" Foreground="White"
                             SelectionChanged="OnUiPanelSelectionChanged"
                             ToolTip="Rails / band bar / VFO strip. AUTO = lighter than BACKGROUND. Disabled when BACKGROUND is CUSTOM.">
                        <ListBoxItem Content="AUTO"/>
                        <ListBoxItem Content="RED"/>
                        <ListBoxItem Content="BLUE"/>
                        <ListBoxItem Content="GREEN"/>
                        <ListBoxItem Content="YELLOW"/>
                        <ListBoxItem Content="WHITE"/>
                        <ListBoxItem Content="BLACK"/>
                    </ListBox>
                    <Border x:Name="UiPanelSwatch" Height="14" Margin="0,4,0,0" BorderBrush="#666" BorderThickness="1" Background="#252525"/>
                    <TextBlock x:Name="UiPanelRgbText" Text="#252525" FontSize="10" Foreground="#00FFAA" FontFamily="Consolas" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="2,0,10,0">
                    <TextBlock Text="UI BUTTON" FontSize="9" Foreground="#D0D0D0" Margin="0,0,0,2"/>
                    <ListBox x:Name="UiButtonList" Width="80" Height="130" FontSize="10"
                             Background="#111" Foreground="White"
                             SelectionChanged="OnUiButtonSelectionChanged"
                             PreviewMouseLeftButtonDown="OnUiButtonListPreviewMouseDown"
                             ToolTip="Button face. CUSTOM = color chart. YELLOW = Multus gold.">
                        <ListBoxItem Content="RED"/>
                        <ListBoxItem Content="BLUE"/>
                        <ListBoxItem Content="GREEN"/>
                        <ListBoxItem Content="YELLOW"/>
                        <ListBoxItem Content="WHITE"/>
                        <ListBoxItem Content="BLACK"/>
                        <ListBoxItem Content="CUSTOM"/>
                    </ListBox>
                    <Border x:Name="UiButtonSwatch" Height="14" Margin="0,4,0,0" BorderBrush="#666" BorderThickness="1" Background="#FFCC00"/>
                    <TextBlock x:Name="UiButtonRgbText" Text="#FFCC00" FontSize="10" Foreground="#00FFAA" FontFamily="Consolas" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Top" Margin="4,16,0,0">
                    <TextBlock Text="RGB shows effective color. CUSTOM bg locks panel to AUTO lift."
                               FontSize="9" Foreground="#D0D0D0" TextWrapping="Wrap" Width="140" Margin="0,0,0,8"/>
                    <Button Content="Reset defaults"
                            Width="110" Height="26" FontSize="11"
                            Click="OnUiChromeResetClick"
                            ToolTip="BACKGROUND BLACK, PANEL AUTO, BUTTON YELLOW"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
