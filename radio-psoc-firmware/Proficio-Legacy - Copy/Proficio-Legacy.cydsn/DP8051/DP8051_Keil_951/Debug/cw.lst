 346          /*
 347           * Legacy CW (relay T/R):
 348           *  - CONTROL_RX / CONTROL_AMP: latched for the whole semi-break-in session
 349           *    (first key-down until CW hold timer expires). Avoids relay chatter.
 350           *  - CONTROL_DIN: element keying — enables audio/I/Q into PCM3060 (mark);
 351           *    clear blanks I/Q (space). Rig has no RF without I/Q.
 352           *  - CONTROL_DOUT: mute RX audio for the session (unchanged role).
 353           * PIN-diode MKII path keyed CONTROL_RX per element; that is wrong for relays.
 354           * Backup: cw.c.bak-pre-legacy-din-key
 355           */
 356          
 357          /* Manage_Paddles_Port state machine (legacy semi-break-in) */
 358          #define CW_ST_IDLE          0   /* track LO; wait to sample key */
 359          #define CW_ST_WAIT_KEY      1   /* sample key-down to start session */
 360          #define CW_ST_SESSION_START 2   /* mute DOUT, blank DIN, LO → TX */
 361          #define CW_ST_MARK          3   /* latch AMP+RX (if needed) + DIN on, restart hang */
C51 COMPILER V9.51   CW                                                                    10/20/2026 11:01:07 PAGE 7   

 362          #define CW_ST_MARK_HOLD     5   /* stay in mark while key down */
 363          #define CW_ST_SPACE         6   /* DIN off only */
 364          #define CW_ST_HANG          7   /* key up: hang timer or re-key */
 365          #define CW_ST_HANG_POLL     10  /* hang active: poll key */
 366          #define CW_ST_DLY_KEYING    20  /* non-QSK: ISR keying DIN; wait key up and delayed RF done */
 367          #define CW_ST_DLY_HANG      21  /* non-QSK: hang timer running, DIN off, AMP+PA on */
 368          #define CW_ST_DLY_END       22  /* non-QSK: back to RX */
 369          
 370          /* Sample paddle status bits into E_key_0 / E_key_1. Returns TRUE if key down. */
 371          static uint8_t cw_keys_down(void)
 372          {
 373   1          uint8 key;
 374   1          uint8 section;
 375   1      
 376   1          section = CyEnterCriticalSection();
 377   1          key = Status_Read();
 378   1          CyExitCriticalSection(section);
 379   1          if (key & STATUS_KEY_0)
 380   1              E_key_0 = TRUE;
 381   1          else
 382   1              E_key_0 = FALSE;
 383   1          if (key & STATUS_KEY_1)
 384   1              E_key_1 = TRUE;
 385   1          else
 386   1              E_key_1 = FALSE;
 387   1          /* Either contact closed → key down (same test as before) */
 388   1          return (uint8_t)(!E_key_0 || !E_key_1);
 389   1      }
 390          
 391          /* Mute RX (DOUT), blank TX I/Q (DIN), LO → CW TX offset. Returns SI5351 status (0=ok). */
 392          static uint8 cw_session_start(void)
 393          {
 394   1          uint8_t c;
 395   1      
 396   1          c = Control_Read();
 397   1          c = c & ~CONTROL_DOUT;   /* PCM3060 RX out OFF */
 398   1          c = c & ~CONTROL_DIN;    /* I/Q blank until mark */
 399   1          Control_Write(c);
 400   1          return si5351aSetFrequency(CW_LO_Freq + E_cw_pitch_freq);
 401   1      }
 402          
 403          /*
 404           * Latch AMP+RX for hang (idempotent if already on) + DIN mark.
 405           * Hang timer starts on key-up (cw_mark_off), not here — so a long hold
 406           * does not burn TX_HOLD before release.
 407           */
 408          static void cw_mark_on(void)
 409          {
 410   1          uint8_t c;
 411   1      
 412   1          c = Control_Read();
 413   1          c = c & ~CONTROL_AMP;    /* AMP ON (active low) */
 414   1          c = c & ~CONTROL_RX;     /* PA / T-R ON (active low) */
 415   1          c = c | CONTROL_DIN;     /* I/Q on → RF */
 416   1          Control_Write(c);
 417   1          /* Keep hold flag true while keying so we never "end session" mid-mark */
 418   1          E_cw_hold = TRUE;
 419   1      }
 420          
 421          /* Key-up space: blank I/Q; start/restart semi-break-in hang timer. */
 422          static void cw_mark_off(void)
 423          {
C51 COMPILER V9.51   CW                                                                    10/20/2026 11:01:07 PAGE 8   

 424   1          Control_Write(Control_Read() & ~CONTROL_DIN);
 425   1          E_cw_hold = TRUE;
 426   1          CW_Hold_Control_Write(CW_CONTROL_RESET);
 427   1      }
 428          
 429          /*
 430           * Non-QSK first key down: AMP + PA (T/R relays) on now, I/Q blanked, and start recording
 431           * the key so the ISR can open DIN key_delay_ms later, after the relays settle.
 432           */
 433          static void cw_delay_start(void)
 434          {
 435   1          uint8_t c;
 436   1          uint8 i;
 437   1      
 438   1          if (!dac_muted) cw_dac_mute(TRUE); //normally already muted in idle
 439   1          for(i = 0; i < KEY_DELAY_BUF_SIZE; i++) key_delay_buf[i] = 0; //ISR not active yet so no race
 440   1          key_delay_ms = E_key_delay_ms;
 441   1          if (key_delay_ms < KEY_DELAY_MIN_MS) key_delay_ms = KEY_DELAY_MIN_MS;   //ISR needs key_delay_ms > DAC
             -_RISE_LEAD_MS
 442   1          key_up_ms = 0;          //Key is down now
 443   1          key_delay_busy = TRUE;
 444   1          key_delay_lo_ready = FALSE;
 445   1          rf_on = FALSE;
 446   1          rf_off_ms = 255;
 447   1          dac_req = DAC_REQ_NONE;
 448   1          key_delay_active = TRUE;
 449   1          c = Control_Read();
 450   1          c = c & ~CONTROL_AMP;    /* AMP ON (active low) */
 451   1          c = c & ~CONTROL_RX;     /* PA / T-R ON (active low) */
 452   1          c = c & ~CONTROL_DIN;    /* I/Q blank until the ISR opens it */
 453   1          Control_Write(c);
 454   1          E_cw_hold = TRUE;
 455   1      }
 456          
 457          /* Hang expired: LO → RX, drop AMP/RX, restore RX audio. Returns SI5351 status (0=ok). */
 458          static uint8 cw_session_end(void)
 459          {
 460   1          uint8_t c;
 461   1          uint8 st;
 462   1      
 463   1          st = si5351aSetFrequency(CW_LO_Freq);
 464   1          if (st != 0)
 465   1              return st;
 466   1          /* DIN already blanked in cw_mark_off() / by the key delay ISR */
 467   1          c = Control_Read();
 468   1          c = c | CONTROL_AMP | CONTROL_RX | CONTROL_DOUT; /* AMP off, PA off, RX audio on */
 469   1          Control_Write(c);
 470   1          Control_Write(Control_Read() | CONTROL_DIN);     /* TX I/Q on again (power-up state) so SSB/digital wo
             -rk after CW */
 471   1          E_key_down = FALSE;
 472   1          return 0;
 473   1      }
