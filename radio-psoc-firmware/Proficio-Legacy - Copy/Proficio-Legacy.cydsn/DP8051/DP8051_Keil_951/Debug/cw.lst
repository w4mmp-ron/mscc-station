 475          void Manage_Paddles_Port(void)  
 476          {
 477   1          static uint8_t state = CW_ST_IDLE;
 478   1          static uint32 previous_CW_LO_Freq = 0;
 479   1          uint8 req;
 480   1          uint8 section;
 481   1      
 482   1          section = CyEnterCriticalSection();     //Take the ISR's DAC mute request
 483   1          req = dac_req;
C51 COMPILER V9.51   CW                                                                    10/20/2026 11:01:07 PAGE 9   

 484   1          dac_req = DAC_REQ_NONE;
 485   1          CyExitCriticalSection(section);
 486   1          if (req == DAC_REQ_UNMUTE)
 487   1              cw_dac_mute(FALSE);
 488   1          else if (req == DAC_REQ_MUTE)
 489   1              cw_dac_mute(TRUE);
 490   1      
 491   1          switch(state){  //When in CW mode Manage_Paddles_Port manages the LO freq.
 492   2              case CW_ST_IDLE:
 493   2                  if (E_QSK == FALSE && !dac_muted)
 494   2                      cw_dac_mute(TRUE);  /* non-QSK: DAC muted in CW so each element can ramp up from mute */
 495   2                  /* Keep LO on dial when frequency changes; then arm key sample if CW allowed */
 496   2                  if (previous_CW_LO_Freq != CW_LO_Freq) {
 497   3                      SI5351_status = si5351aSetFrequency(CW_LO_Freq);
 498   3                      if (SI5351_status == 0)
 499   3                          previous_CW_LO_Freq = CW_LO_Freq;
 500   3                      else
 501   3                          break; /* retry LO next pass */
 502   3                  }
 503   2                  if (!TX_Inhibit && (E_host_mode == 'C'))
 504   2                      state = CW_ST_WAIT_KEY;
 505   2                  break;
 506   2              case CW_ST_WAIT_KEY:
 507   2                  if (cw_keys_down()) {
 508   3                      E_key_down = TRUE;
 509   3                      if (E_QSK == FALSE)
 510   3                          cw_delay_start(); /* relays on + record key now, before the LO change, so the first el
             -ement is not clipped */
 511   3                      state = CW_ST_SESSION_START;
 512   3                  } else {
 513   3                      state = CW_ST_IDLE;
 514   3                  }
 515   2                  break;
 516   2              case CW_ST_SESSION_START:
 517   2                  SI5351_status = cw_session_start();
 518   2                  if (SI5351_status == 0) {
 519   3                      if (E_QSK == TRUE) {
 520   4                          state = CW_ST_MARK;
 521   4                      } else {
 522   4                          key_delay_lo_ready = TRUE; /* LO on TX freq: let the ISR key DIN */
 523   4                          state = CW_ST_DLY_KEYING;
 524   4                      }
 525   3                  }
 526   2                  break;
 527   2              case CW_ST_MARK:
 528   2                  cw_mark_on();
 529   2                  state = CW_ST_MARK_HOLD;
 530   2                  break;
 531   2              case CW_ST_MARK_HOLD: // stay in mark while key down
 532   2                  if (!cw_keys_down())
 533   2                      state = CW_ST_SPACE;
 534   2                  break;
 535   2              case CW_ST_SPACE:
 536   2                  cw_mark_off();
 537   2                  state = CW_ST_HANG;
 538   2                  break;
 539   2              case CW_ST_HANG: // wait hang timer or re-key
 540   2                  if (E_cw_hold == FALSE) {
 541   3                      SI5351_status = cw_session_end();
 542   3                      if (SI5351_status == 0)
 543   3                          state = CW_ST_IDLE;
 544   3                  } else {
C51 COMPILER V9.51   CW                                                                    10/20/2026 11:01:07 PAGE 10  

 545   3                      state = CW_ST_HANG_POLL;
 546   3                  }
 547   2                  break;
 548   2              case CW_ST_HANG_POLL: // hang active: re-key only via mark_on (not relay-only path)
 549   2                  if (cw_keys_down())
 550   2                      state = CW_ST_MARK;
 551   2                  else
 552   2                      state = CW_ST_HANG;
 553   2                  break;
 554   2              case CW_ST_DLY_KEYING:
 555   2                  if (!key_delay_active) {            /* ISR stopped (left CW or TX_Inhibit) */
 556   3                      state = CW_ST_DLY_END;
 557   3                  } else if (!key_delay_busy) {
 558   3                      E_cw_hold = TRUE;               /* semi-break-in hang from end of RF */
 559   3                      CW_Hold_Control_Write(CW_CONTROL_RESET);
 560   3                      state = CW_ST_DLY_HANG;
 561   3                  }
 562   2                  break;
 563   2              case CW_ST_DLY_HANG:
 564   2                  if (!key_delay_active) {
 565   3                      state = CW_ST_DLY_END;
 566   3                  } else if (key_delay_busy) {
 567   3                      state = CW_ST_DLY_KEYING;       /* key down again during hang */
 568   3                  } else if (E_cw_hold == FALSE) {
 569   3                      key_delay_active = FALSE;
 570   3                      state = CW_ST_DLY_END;
 571   3                  }
 572   2                  break;
 573   2              case CW_ST_DLY_END:
 574   2                  SI5351_status = cw_session_end();
 575   2                  if (SI5351_status == 0)
 576   2                      state = CW_ST_IDLE;
 577   2                  break;
 578   2          }
 579   1      }
