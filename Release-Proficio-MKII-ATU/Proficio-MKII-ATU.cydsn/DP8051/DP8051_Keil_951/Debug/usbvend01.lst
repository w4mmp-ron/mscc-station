  54          // Maps PSoC registers into one that looks like the AVR
  55          uint8 emulated_register(void) {
  56   1          uint8 reg = 0, key;
  57   1          if (TX_Request) reg |= 0x10;
  58   1          //key = Status_Read();
  59   1          key = E_key_down;
  60   1          if (key & STATUS_KEY_0) reg |= 0x20;
  61   1          if (key & STATUS_KEY_1) reg |= 0x02;
  62   1          return reg;
  63   1      }
