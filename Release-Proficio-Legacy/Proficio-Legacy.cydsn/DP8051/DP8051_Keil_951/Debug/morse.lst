 118          // Example usage:
 119          // Morse_Main("Repeating Message ");for(;;){sleep(240);Morse_Main(0);}
 120          void Morse_Main(char* msg) {
 121   1          static uint8 pos, codes, len, state, timer, *message;
 122   1          uint8 i;
 123   1      
 124   1          if (msg) {
 125   2              state = pos = 0;
 126   2              message = (uint8 *)msg;
 127   2          }
 128   1          else switch (state) {
 129   2          case 0:
 130   2              if (!message[pos]) pos = 0;
 131   2              i = message[pos++];
 132   2              if (i >= 0x61 && i <= 0x7A) i -= 32;
 133   2              if (i < 0x22 || i > 0x5A) codes = 7;
 134   2              else codes = MCODES[i-0x22];
 135   2              len = codes & 0x07;
 136   2              if (len==0) len = 6;
 137   2              if (codes==7) {
 138   3                  timer = MORSE_WORD - MORSE_CHAR - 2;
 139   3                  len = 0;
 140   3                  state = 3;
 141   3                  break;
 142   3              }
 143   2          case 1:
 144   2              if (codes & 0x80) timer = MORSE_DASH;
 145   2              else timer = MORSE_DOT;
 146   2              codes <<= 1;
 147   2              len--;
 148   2              Control_Write(Control_Read() & ~CONTROL_LED);
 149   2              state = 2;
 150   2          case 2:
 151   2              if (!timer) {
 152   3                  state = 3;
 153   3                  if (!len) timer = MORSE_CHAR - 1;
 154   3                  else timer = MORSE_DOT - 1;
 155   3                  Control_Write(Control_Read() | CONTROL_LED);
 156   3              }
 157   2              else {
 158   3                  timer--;
 159   3                  break;
 160   3              }
 161   2          case 3:
 162   2              if (!timer) {
 163   3                  if (!len) state = 0;
 164   3                  else state = 1;
 165   3              }
 166   2              else timer--;
 167   2          }
 168   1      }
