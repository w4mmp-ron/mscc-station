 272   2                      denom = 1048575;                                // For simplicity we set the denominator to the maximum 1048575
 273   2                  state++;
 274   2                  break;
 275   2              case 2:
 276   2                      pll_status = setupPLL(SI_SYNTH_PLL_A, mult, num, denom);
