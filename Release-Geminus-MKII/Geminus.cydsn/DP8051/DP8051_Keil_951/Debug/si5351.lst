 961   1              int_status->LOL_B_STKY = (reg_val >> 6) & 0x01;
 962   1              int_status->LOL_A_STKY = (reg_val >> 5) & 0x01;
 963   1              int_status->LOS_STKY = (reg_val >> 4) & 0x01;
 964   1      }
