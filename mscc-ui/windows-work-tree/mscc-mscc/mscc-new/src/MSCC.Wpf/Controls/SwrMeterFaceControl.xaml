<UserControl x:Class="MSCC.Wpf.Controls.SwrMeterFaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="120"
             MinWidth="164" MinHeight="110">
    <!-- TX-slot external SWR face (same footprint as AnalogSMeterControl). -->
    <Border Background="#FF0C0C0C" BorderBrush="#FF666666" BorderThickness="1" CornerRadius="4" Padding="6,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" Text="SWR"
                       FontSize="11" FontWeight="Bold" Foreground="#D0D0D0"
                       HorizontalAlignment="Center"/>

            <!-- Normal: big digital; Fault: red RESET button -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Button x:Name="ResetButton" Content="RESET" Visibility="Collapsed"
                        Height="40" Margin="8,4" FontSize="16" FontWeight="Bold"
                        Background="#FFB71C1C" Foreground="White" BorderBrush="#FFFF5252"
                        Click="OnResetClick"
                        ToolTip="SWR fault latched — press to HTTP reset meter (RF must be off)"/>
                <StackPanel x:Name="ReadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="MainReading" Text="1.00"
                               FontSize="28" FontWeight="Bold" Foreground="#FFB74D"
                               FontFamily="Consolas" HorizontalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="OnReadingClick"
                               ToolTip="Click to cycle SWR ↔ FWD"/>
                    <TextBlock x:Name="SubReading" Text="FWD —  REF —"
                               FontSize="11" Foreground="#00FFAA" FontFamily="Consolas"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusLine" Grid.Row="2" Text=""
                       FontSize="9" Foreground="#D0D0D0" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
