 144   1          if (arrayId > CY_SPC_LAST_FLASH_ARRAYID)
 145   1          {
 146   2              status = CYRET_BAD_PARAM;
 147   2          }
 148   1          else if(rowAddress > (CY_FLASH_NUMBER_ROWS/CY_FLASH_NUMBER_ARRAYS))
 149   1          {
 150   2              status = CYRET_BAD_PARAM;
 151   2          }        
