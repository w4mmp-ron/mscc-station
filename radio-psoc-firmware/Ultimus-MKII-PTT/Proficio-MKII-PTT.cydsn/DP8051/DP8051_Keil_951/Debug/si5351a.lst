 174          /*
 175           * Si5351 soft-tune strategy (Si570-like):
C51 COMPILER V9.51   SI5351A                                                               08/22/2026 15:13:55 PAGE 4   

 176           *
 177           * Old approach recomputed Multisynth every step as even(900e6 / fout). That
 178           * changes MS at fixed clock boundaries (~14.0625 / 28.125 MHz LO-class edges),
 179           * which matched the observed mid-band pops (e.g. 14.080 / 28.140 with offsets).
 180           * On LF the same edges occur every ~100 Hz (2200 m) / ~1 kHz (630 m).
 181           *
 182           * New approach:
 183           *  - SOFT: hold Multisynth divider fixed; only rewrite PLL fractional.
 184           *          Skip MS register writes and SI_PLL_RESET. Valid while VCO stays
 185           *          in [VCO_MIN, VCO_MAX] and PLL mult in 15..90.
 186           *  - HARD: pick a new even MS divider targeting ~VCO_CENTER (not the 900 MHz
 187           *          ceiling), rewrite MS+PLL, then PLL_RESET once.
 188           *
 189           * Centering VCO puts ham-band MS edges outside typical amateur segments so
 190           * a whole band can soft-tune after one hard entry.
 191           */
 192          #define SI5351_VCO_MIN     600000000UL
 193          #define SI5351_VCO_MAX     900000000UL
 194          #define SI5351_VCO_CENTER  750000000UL
 195          #define SI5351_MS_MIN      6UL
 196          #define SI5351_MS_MAX      1800UL
 197          /* Extra SetFrequency() visits with CLK0 off after hard PLL_RESET.
 198           * SetFrequency runs ~once per full main beater cycle (~4 ms @ 2 kHz BEAT).
 199           * 6 ≈ 24 ms post-reset hold (125 ≈ 500 ms was a test — too long for normal use).
 200           * Soft path never blanks. Does not touch CW timers / CONTROL_RX / PTT. */
 201          #define SI5351_HARD_BLANK_HOLD  6u
 202          #define SI5351_CLK0_OFF         0x80u
 203          #define SI5351_CLK0_ON          (0x4Fu | SI_CLK_SRC_PLL_A)
 204          
 205          // 
