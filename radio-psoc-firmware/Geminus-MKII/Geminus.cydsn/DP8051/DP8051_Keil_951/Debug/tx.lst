  24          #include <basic-plus.h>
  25          #include <si5351.h>
  26          #include <si5351a.h>
  27          
  28          #define TX_LED_BLINK_ON_MS 40
  29          #define TX_LED_BLINK_OFF_MS 50
  30          
  31          uint8 TX_Request = 0;
  32          uint8 TX_Inhibit = 0;
  33          
  34          /*
  35           * Geminus 2.153 (2026-10-31): TUN / PTT edges shaped with the PCM3060 DAC soft mute, as the
  36           * Proficio MKII PTT 3.241. Before, the T/R relay, BS2 and AMP switched with RF at full level
  37           * and the I/Q went straight to full: broadband noise at the TUN / PTT edges.
  38           *   Key:     I/Q blank (DIN) + DAC mute, T/R + BS2 + AMP on, TX_KEY_DELAY_MS (relays settle,
  39           *            DAC fully muted), I/Q on into the muted DAC, DAC unmute (ramps up).
  40           *   Release: DAC mute, TX_DAC_RAMP_MS, AMP + BS2 off, AMP_RELEASE_MS, T/R off, I/Q path and
  41           *            DAC back for RX.
  42           */
  43          static uint8 state = 0;
  44          static uint8 start_tick = 0;
  45          
  46          /* Main loop: TX_Main back to idle (entering CW, where cw.c owns the DAC mute) */
  47          void TX_Reset(void) {
  48   1          state = 0;
  49   1      }
  50          
  51          /* TRUE when TX_Main is receiving (relays off, DAC unmuted) */
  52          uint8 TX_Idle(void) {
C51 COMPILER V9.51   TX                                                                    10/31/2026 10:02:06 PAGE 2   

  53   1          return (state == 0);
  54   1      }
  55          
  56          static void tx_relays_off(void) {
  57   1          Control_Write((Control_Read() & ~CONTROL_LED) | CONTROL_RX | CONTROL_DIN);  //T/R off, I/Q path back
  58   1          TX_DAC_Mute(FALSE);
  59   1      }
  60          
  61          void TX_Main(void) {
  62   1          switch (state) {
  63   2              case 0: // receiving
  64   2                  if (TX_Request && !TX_Inhibit) {
  65   3                      Control_Write(Control_Read() & ~CONTROL_DIN);   //I/Q blank: no RF while the relays switch
  66   3                      TX_DAC_Mute(TRUE);
  67   3                      Control_Write(Control_Read() & ~CONTROL_RX);    //T/R on - Negative logic level
  68   3                      Band_Control_Write(Band_Control_Read() | CONTROL_BAND_TX);
  69   3                      Control_Write(Control_Read() & ~CONTROL_AMP);   //AMP on - Negative logic level
  70   3                      start_tick = E_ms_tick;
  71   3                      state = 3;
  72   3                  }
  73   2                  break;
  74   2              case 3: // relays settling, I/Q blank, DAC muting
  75   2                  if (!TX_Request || TX_Inhibit) {
  76   3                      Control_Write(Control_Read() | CONTROL_AMP);
  77   3                      Band_Control_Write(Band_Control_Read() & ~CONTROL_BAND_TX);
  78   3                      tx_relays_off();                                //No RF was sent
  79   3                      state = 0;
  80   3                  } else if ((uint8)(E_ms_tick - start_tick) >= TX_KEY_DELAY_MS) {
  81   3                      Control_Write(Control_Read() | CONTROL_DIN);    //I/Q into the muted DAC
  82   3                      TX_DAC_Mute(FALSE);                             //RF ramps up
  83   3                      state = 10;
  84   3                  }
  85   2                  break;
  86   2              case 10: // transmitting
  87   2                  if (!TX_Request && !TX_Inhibit) {
  88   3                      TX_DAC_Mute(TRUE);                              //Ramp RF down first, relays stay
  89   3                      start_tick = E_ms_tick;
  90   3                      state = 13;
  91   3                  }
  92   2                  break;
  93   2              case 13: // DAC ramping down
  94   2                  if (TX_Request) {
  95   3                      TX_DAC_Mute(FALSE);                             //Re-keyed during the ramp
  96   3                      state = 10;
  97   3                  } else if ((uint8)(E_ms_tick - start_tick) >= TX_DAC_RAMP_MS) {
  98   3                      Control_Write(Control_Read() & ~CONTROL_DIN);   //I/Q blank
  99   3                      Control_Write(Control_Read() | CONTROL_AMP);    //AMP off
 100   3                      Band_Control_Write(Band_Control_Read() & ~CONTROL_BAND_TX);
 101   3                      start_tick = E_ms_tick;
 102   3                      state = 12;
 103   3                  }
 104   2                  break;
 105   2              case 12: // AMP off, waiting before the T/R relay
 106   2                  if ((uint8)(E_ms_tick - start_tick) >= AMP_RELEASE_MS) {
 107   3                      tx_relays_off();
 108   3                      state = 0;
 109   3                  }
 110   2                  break;
 111   2              default:
 112   2                  state = 0;
 113   2                  break;
 114   2          }
