  55          uint8 keyer_write(uint8_t buffer)
  56          {
  57   1              uint8_t msg_buffer = 0;
  58   1              uint8_t ret_status = 0;
  59   1              uint8_t write_status = 0;
  60   1          uint8 buffer_written = 0;
  61   1          uint8 attempt;
  62   1      
  63   1          /*
  64   1           * PIC may NACK while busy (e.g. EEPROM write on STORE_END). Retry a few
  65   1           * times so a following PLAY is not dropped and keyer not marked missing.
  66   1           */
  67   1          msg_buffer = buffer;
  68   1          for (attempt = 0; attempt < 8u; attempt++) {
  69   2              write_status = I2C_DISPLAY_MasterWriteBuf(KEYER_SLAVE_ADDRESS, &msg_buffer, 1u,
  70   2                  I2C_DISPLAY_MODE_COMPLETE_XFER);
  71   2              while ((I2C_DISPLAY_MasterStatus() & I2C_DISPLAY_MSTAT_WR_CMPLT) == 0u) {
  72   3              }
  73   2              buffer_written = I2C_DISPLAY_MasterGetWriteBufSize();
  74   2              if (buffer_written == 1u) {
  75   3                  ret_status = 1;
  76   3                  break;
  77   3              }
  78   2              CyDelay(5u);
  79   2          }
  80   1          return ret_status;
  81   1      }
