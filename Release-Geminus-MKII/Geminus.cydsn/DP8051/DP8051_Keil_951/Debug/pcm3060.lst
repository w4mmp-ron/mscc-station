 147          uint8 PCM3060_SetRegister(uint8 reg, uint8 val) {
 148   1          uint8 pcm3060_cmd[2], i, state = 0;
 149   1          uint16 err = 0;
 150   1      
 151   1          while (state < 2) {
 152   2              switch (state) {
 153   3              case 0:
 154   3                  pcm3060_cmd[0] = reg;
 155   3                  pcm3060_cmd[1] = val;
 156   3                  I2C_DISPLAY_MasterWriteBuf(PCM3060_I2C_ADDR, pcm3060_cmd, 2, I2C_DISPLAY_MODE_COMPLETE_XFER);
 157   3                  state++;
 158   3                  break;
 159   3              case 1:
 160   3                  i = I2C_DISPLAY_MasterStatus();
 161   3                  if (i & I2C_DISPLAY_MSTAT_ERR_XFER) {
 162   4                      state--;
 163   4                  } else if (i & I2C_DISPLAY_MSTAT_WR_CMPLT) {
 164   4                      state++;
 165   4                  }
 166   3                  if (!--err) return 1;
 167   3                  break;
 168   3              }
 169   2          }
 170   1          return 0;
 171   1      }
