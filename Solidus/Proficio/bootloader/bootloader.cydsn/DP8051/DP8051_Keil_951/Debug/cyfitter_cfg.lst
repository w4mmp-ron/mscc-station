                  /* we will end up here to allow the customer to implement something to  */
                  /* deal with the clock condition.                                       */
              
                  /* `#END` */
              
                  while(1) {}
              #endif /* CY_CFG_CLOCK_STARTUP_ERROR_CALLBACK */
              }
              #endif
