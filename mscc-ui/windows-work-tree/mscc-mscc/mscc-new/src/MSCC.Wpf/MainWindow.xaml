<Window x:Class="MSCC.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MSCC.Wpf.Controls"
        Title="{Binding WindowTitle, FallbackValue=MSCC WPF}" Height="760" Width="1400"
        WindowStartupLocation="Manual"
        Icon="mscc-icon-1.ico"
        Background="{DynamicResource UiWindowBackgroundBrush}" Foreground="{DynamicResource UiPrimaryTextBrush}">

    <Window.Resources>
        <!-- UI chrome brushes — live-updated from Settings → UI Appearance. -->
        <SolidColorBrush x:Key="UiWindowBackgroundBrush" Color="#FF1C1C1C"/>
        <SolidColorBrush x:Key="UiPanelBackgroundBrush" Color="#FF252525"/>
        <!-- Labels on panels (Volume, Temps, Versions, …) — flips black/white with panel luminance -->
        <SolidColorBrush x:Key="UiPrimaryTextBrush" Color="White"/>
        <SolidColorBrush x:Key="UiMutedTextBrush" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="UiButtonFaceBrush" Color="#FFCC00"/>
        <SolidColorBrush x:Key="UiButtonBorderBrush" Color="#FFAA00"/>
        <SolidColorBrush x:Key="UiButtonHoverBrush" Color="#FFDD55"/>
        <SolidColorBrush x:Key="UiButtonHoverBorderBrush" Color="#FFCC00"/>
        <SolidColorBrush x:Key="UiButtonPressedBrush" Color="#FFAA00"/>
        <SolidColorBrush x:Key="UiButtonTextBrush" Color="Black"/>
        <!-- Selected / latched (darker shade of button face) -->
        <SolidColorBrush x:Key="UiButtonSelectedBrush" Color="#FFAA00"/>
        <SolidColorBrush x:Key="UiButtonSelectedBorderBrush" Color="#FF8800"/>
        <!-- TX-critical latched: PTT / TUN / AMP when on -->
        <SolidColorBrush x:Key="UiButtonAlertBrush" Color="#FFE53935"/>
        <SolidColorBrush x:Key="UiButtonAlertBorderBrush" Color="#FFB71C1C"/>

        <!-- Shared themed button: rounded corners + slightly thicker border (raised look).
             Use BasedOn + DataTrigger with UiButtonSelected* or UiButtonAlert* for latched states.
             Template required so CornerRadius is honored (default Button chrome ignores it). -->
        <Style x:Key="MsccGoldButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource UiButtonFaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource UiButtonTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Single Border: simpler layout; nested borders inflated content and clipped edges. -->
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiButtonHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiButtonHoverBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <!-- Gray-out for radio-model gating (Proficio vs Geminus band sets). -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF555555"/>
                    <Setter Property="BorderBrush" Value="#FF444444"/>
                    <Setter Property="Foreground" Value="#FF999999"/>
                    <Setter Property="Opacity" Value="0.65"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab content fills client area. Header group is laid out in the spectrum (*)
             column only (200px right gutter matches MAIN PTT column) so the tab group
             center aligns with the spectrum center line. -->
        <Style x:Key="MsccTabControlStyle" TargetType="TabControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Headers centered in spectrum-column TabControl -->
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Panel.ZIndex="1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="Transparent"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,0"/>
                            <Border x:Name="ContentHost"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>  <!-- Left controls (equal to operate right rail) -->
            <ColumnDefinition Width="*"/>    <!-- VFO / bands / tabs -->
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: full window height; compact sliders (label→control tight) -->
        <Border Grid.Column="0"
                Background="{DynamicResource UiPanelBackgroundBrush}" BorderBrush="#444" BorderThickness="1"
                CornerRadius="4" Padding="6,4,6,6" Margin="0,0,4,0"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
            <StackPanel VerticalAlignment="Top">

    <!-- Start / connection — top of left panel (PowerSDR-style: start top-left) -->
    <TextBlock Text="SERVER" FontWeight="Bold" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,4"/>
    <Button x:Name="StartStopButton"
            Content="{Binding StartStopButtonText}"
            IsEnabled="{Binding CanStartLocalRadioSession}"
            Width="120" Click="StartStop_Click" FontSize="11" Height="28"
            HorizontalAlignment="Left" Margin="0,0,0,4"
            ToolTip="Start: connect (and launch backends if Launch Servers is on). Disabled until COM + operator speaker/mic are set in Settings. Stop: end session / stop backends this app launched. Stop then Start after COM/audio changes.">
        <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                <Style.Triggers>
                    <!-- Running = green Stop -->
                    <DataTrigger Binding="{Binding IsRadioRunning}" Value="True">
                        <Setter Property="Background" Value="#FF2E7D32"/>
                        <Setter Property="BorderBrush" Value="#FF1B5E20"/>
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                        <Setter Property="ToolTip" Value="Set COM port and operator Out/Mic in Settings → Audio (leave blank until you choose), then Apply. Start enables when setup is complete."/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Button.Style>
    </Button>
    <TextBlock Text="{Binding SetupStatusLine}"
               Foreground="#FFCC66" FontSize="9" FontWeight="Bold"
               TextWrapping="Wrap" MaxWidth="150" Margin="0,0,0,4"
               Visibility="{Binding SetupStatusLine, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
               ToolTip="Set COM port and operator speaker under Settings before starting local servers."/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
        <CheckBox Content="Auto Start"
                  IsChecked="{Binding AutoStartServers}"
                  Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9" FontWeight="Bold"
                  VerticalAlignment="Center"
                  ToolTip="When checked, press Start automatically when the MSCC window loads (saved in MSCC_Client.ini)"/>
        <CheckBox Content="Launch Servers"
                  IsChecked="{Binding LaunchServersOnStart}"
                  Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9" FontWeight="Bold"
                  Margin="6,0,0,0" VerticalAlignment="Center"
                  ToolTip="When checked, Start also spawns ms-sdr / recv / trans. Uncheck if backends are already running (e.g. Start-MsccServers.bat). Saved as LAUNCH_SERVERS."/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
        <TextBlock Text="Server" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
        <TextBox Text="{Binding BackendIp, UpdateSourceTrigger=LostFocus}" Width="100" FontSize="9" Background="#FF333333" Foreground="{DynamicResource UiPrimaryTextBrush}" BorderBrush="#FF666666" BorderThickness="1" ToolTip="IP address or domain name (e.g. 127.0.0.1 or server.local)" PreviewKeyDown="ServerAddress_PreviewKeyDown"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
        <TextBlock Text="Port" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
        <TextBox Text="{Binding BackendPort, UpdateSourceTrigger=LostFocus}" Width="50" FontSize="9" Background="#FF333333" Foreground="{DynamicResource UiPrimaryTextBrush}" BorderBrush="#FF666666" BorderThickness="1" PreviewKeyDown="ServerAddress_PreviewKeyDown"/>
    </StackPanel>

    <!-- P group (operator/phones) — tight label→slider→value for narrower rail -->
    <TextBlock Text="Phones" FontWeight="Bold" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,2"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
        <TextBlock Text="Volume" Width="52" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="11"/>
        <Slider Width="68" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding RadioState.PVolume, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel" Margin="2,0,0,0"/>
        <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="2,0,0,0" Padding="2,1" MinWidth="32">
            <TextBlock Text="{Binding RadioState.PVolume, StringFormat={}{0}}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
        <TextBlock Text="Mic Gain" Width="52" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="11"/>
        <Slider Width="68" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding RadioState.PMicGain, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel" Margin="2,0,0,0"/>
        <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="2,0,0,0" Padding="2,1" MinWidth="32">
            <TextBlock Text="{Binding RadioState.PMicGain, StringFormat={}{0}}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>

    <!-- D group (digital) -->
    <TextBlock Text="Digital" FontWeight="Bold" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,2"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
        <TextBlock Text="Volume" Width="52" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="11"/>
        <Slider Width="68" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding RadioState.DVolume, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel" Margin="2,0,0,0"/>
        <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="2,0,0,0" Padding="2,1" MinWidth="32">
            <TextBlock Text="{Binding RadioState.DVolume, StringFormat={}{0}}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
        <TextBlock Text="Mic Gain" Width="52" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="11"/>
        <Slider Width="68" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding RadioState.DMicGain, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel" Margin="2,0,0,0"/>
        <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="2,0,0,0" Padding="2,1" MinWidth="32">
            <TextBlock Text="{Binding RadioState.DMicGain, StringFormat={}{0}}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>

    <!-- Audio path toggle: Phones (operator) ↔ Digital (VAC / digi apps) -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
        <TextBlock Text="Audio" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}"/>
        <Button Width="72" Height="24" Margin="2,0,0,0" FontSize="10"
                Command="{Binding ToggleAudioDigitalCommand}"
                ToolTip="Phones = operator speaker/mic (P)&#x0a;Digital = VAC / digital apps (D)">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                    <Setter Property="Content" Value="Phones"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDigitalAudio}" Value="True">
                            <Setter Property="Content" Value="Digital"/>
                            <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>

    <!-- Main tab filter/step buttons (replacing Lo/Hi sliders; cycle presets like original) -->
    <TextBlock Text="FILTERS / STEP" FontWeight="SemiBold" Margin="0,5,0,3" Foreground="#00FFAA" FontSize="10"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
        <TextBlock Text="Lo" Width="25" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
        <Button Content="{Binding LowCutLabel}" Width="55" Height="20" Command="{Binding CycleLowCutCommand}" FontSize="9" Style="{StaticResource MsccGoldButtonStyle}" ToolTip="LOW CUT FILTER"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
        <TextBlock Text="Hi" Width="25" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
        <Button Content="{Binding HighCutLabel}" Width="55" Height="20" Command="{Binding CycleHighCutCommand}" FontSize="9" Style="{StaticResource MsccGoldButtonStyle}" ToolTip="HIGH CUT FILTER"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
        <TextBlock Text="CW" Width="25" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
        <Button Content="{Binding CwFilterLabel}" Width="55" Height="20" Command="{Binding CycleCwFilterCommand}" FontSize="9" Style="{StaticResource MsccGoldButtonStyle}" ToolTip="CW BANDWIDTH"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
        <TextBlock Text="Step" Width="25" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
        <Button Content="{Binding StepLabel}" Width="55" Height="20" Command="{Binding CycleStepCommand}" FontSize="9" Style="{StaticResource MsccGoldButtonStyle}"/>
    </StackPanel>

    <!-- Spectrum display zoom (client viewport; no mouse-wheel zoom on spectrum) -->
    <TextBlock Text="SPECTRUM ZOOM" FontWeight="Bold" Foreground="#00FFAA" FontSize="9"
               Margin="0,0,0,2"
               ToolTip="Display zoom of the panadapter (1×–4×). Same RF data; magnifies center around VFO."/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center"
                ToolTip="Display zoom of the panadapter (1×–4×). Same RF data; magnifies center around VFO.">
        <Slider Width="90" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                SmallChange="1" LargeChange="1"
                Value="{Binding SpectrumZoom, Mode=TwoWay}"
                PreviewMouseWheel="Slider_PreviewMouseWheel" VerticalAlignment="Center"/>
        <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="2,0,0,0" Padding="2,1" MinWidth="32">
            <TextBlock Text="{Binding SpectrumZoom, StringFormat={}{0:0}×}" FontSize="11" FontWeight="Bold"
                       Foreground="#00FFAA" HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>

    <CheckBox Content="RIT" IsChecked="{Binding RadioState.ActiveVfo.RitOn, Mode=TwoWay}" Margin="0,0,0,5" Foreground="{DynamicResource UiPrimaryTextBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
        <TextBlock Text="RIT Offset" Width="52" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="11"/>
        <Slider Width="68" Minimum="-500" Maximum="500" SmallChange="10" Value="{Binding RadioState.ActiveVfo.RitOffsetHz, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel" Margin="2,0,0,0"/>
        <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="2,0,0,0" Padding="2,1" MinWidth="36">
            <TextBlock Text="{Binding RadioState.ActiveVfo.RitOffsetHz, StringFormat={}{0}}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>
    <Button Content="Clear RIT" Width="80" Click="ClearRit_Click" Margin="0,0,0,5" FontSize="9" Style="{StaticResource MsccGoldButtonStyle}"/>
            </StackPanel>
            <!-- Temps moved to SETTINGS (Proficio for legacy XO; PA reserved for future amp face). -->
            </Grid>
        </Border>

        <!-- Center: spectrum column (*) + operate rail (equal width to left panel = 180). -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Top VFO Bar -->
                <RowDefinition Height="Auto"/>   <!-- Controls Bar -->
                <RowDefinition Height="*"/>      <!-- Main Area -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- Spectrum column -->
                <ColumnDefinition Width="180"/>  <!-- Operate right rail (matches left rail) -->
            </Grid.ColumnDefinitions>

        <!-- Top bar: S-meter | VFO A | VFO B | ALC
             * | Auto… | *  → wide window: meters float out evenly; narrow: * collapses so the
             cluster tightens as a group (no separate VFO toggle — click a VFO box to select). -->
        <!-- Top bar: equal * gutters between S / VFO A / VFO B / ALC so they spread on maximize
             and pull together at MinWidth 1140. No fixed side margins (stars provide spacing). -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource UiPanelBackgroundBrush}" CornerRadius="4" Padding="4,4" Margin="0,0,0,6"
                ClipToBounds="False">
            <Grid ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>  <!-- S-meter -->
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>  <!-- VFO A -->
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>  <!-- VFO B -->
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>  <!-- ALC -->
                    <ColumnDefinition Width="*" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- Analog S-meter (RX) or FWD 0–10 + SWR digital (TX / fault) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <controls:AnalogSMeterControl Value="{Binding SMeter}"
                                                  HoldEnabled="{Binding SmeterHold, Mode=TwoWay}"
                                                  PeakEnabled="{Binding PeakNeedleOn, Mode=TwoWay}"
                                                  PeakHoldSeconds="2"
                                                  PowerMode="{Binding ShowExternalSwrFace}"
                                                  ForwardWatts="{Binding SwrForwardWatts}"
                                                  Swr="{Binding SwrValue}"
                                                  Fault="{Binding SwrFault}"
                                                  SwrThreshold="{Binding SwrThreshold}"
                                                  ResetRequested="SwrMeterFace_ResetRequested"/>
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#00FFAA"
                               HorizontalAlignment="Center" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="S-METER"/>
                                <Setter Property="ToolTip" Value="S-meter"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowExternalSwrFace}" Value="True">
                                        <Setter Property="Text" Value="FWD / SWR"/>
                                        <Setter Property="ToolTip" Value="FWD power needle + SWR digital (external WiFi meter). Fault keeps this face for RESET."/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowExternalSwrFace}" Value="True"/>
                                            <Condition Binding="{Binding SwrFault}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="SWR FAULT"/>
                                        <Setter Property="Foreground" Value="#FFFF5252"/>
                                        <Setter Property="ToolTip" Value="High SWR fault — press red RESET on the digital readout"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- VFO A — compact padding so ALC Peak fits at MinWidth 1140 -->
                <Border Grid.Column="3" Background="#FF1A1A1A" CornerRadius="4" Padding="6,3"
                        VerticalAlignment="Center" Cursor="Hand"
                        BorderThickness="3" BorderBrush="{Binding IsVfoAActive, Converter={StaticResource BoolToActiveBrushConverter}}"
                        ToolTip="Click to select VFO A (wheel tunes frequency when active)">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectVfoACommand}"/>
                    </Border.InputBindings>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="VFO A" FontSize="10" Foreground="{DynamicResource UiMutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RadioState.VfoA.FrequencyDisplay}"
                                   FontSize="36" FontWeight="Bold" FontFamily="Consolas" Foreground="#00FFAA"
                                   HorizontalAlignment="Center"
                                   PreviewMouseWheel="VfoFrequency_PreviewMouseWheel" Tag="A"/>
                        <TextBlock Text="{Binding RadioState.VfoA.RitDisplay}"
                                   Height="13" FontSize="11" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="#FFCC00" HorizontalAlignment="Center"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   ToolTip="RIT offset (Hz)"/>
                        <TextBlock Text="{Binding RadioState.VfoA.ModeDisplay}" Foreground="#D0D0D0" FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- VFO B — click to select -->
                <Border Grid.Column="5" Background="#FF1A1A1A" CornerRadius="4" Padding="6,2"
                        VerticalAlignment="Center" Cursor="Hand"
                        BorderThickness="2" BorderBrush="{Binding IsVfoBActive, Converter={StaticResource BoolToActiveBrushConverter}}"
                        ToolTip="Click to select VFO B (wheel tunes frequency when active)">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectVfoBCommand}"/>
                    </Border.InputBindings>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="VFO B" FontSize="9" Foreground="{DynamicResource UiMutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RadioState.VfoB.FrequencyDisplay}"
                                   FontSize="18" FontWeight="Bold" FontFamily="Consolas" Foreground="#88CCFF"
                                   HorizontalAlignment="Center"
                                   PreviewMouseWheel="VfoFrequency_PreviewMouseWheel" Tag="B"/>
                        <TextBlock Text="{Binding RadioState.VfoB.RitDisplay}"
                                   Height="12" FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="#FFCC00" HorizontalAlignment="Center"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   ToolTip="RIT offset (Hz)"/>
                        <TextBlock Text="{Binding RadioState.VfoB.ModeDisplay}" Foreground="#D0D0D0" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Analog ALC meter -->
                <StackPanel Grid.Column="7" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <controls:AnalogAlcMeterControl Value="{Binding AlcValue}"
                                                    HoldEnabled="{Binding AlcHold, Mode=TwoWay}"
                                                    PeakEnabled="{Binding AlcPeakNeedleOn, Mode=TwoWay}"
                                                    PeakHoldSeconds="2"/>
                    <TextBlock Text="ALC"
                               FontSize="12" FontWeight="Bold" Foreground="#00FFAA"
                               HorizontalAlignment="Center" Margin="0,2,0,0"
                               ToolTip="ALC meter"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Radio model + band buttons — centered on spectrum column. -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource UiPanelBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Left of band bar: radio family (Proficio ↔ Geminus). Outside BandButtonsPanel so band highlight logic ignores it. -->
                <Button x:Name="RadioModelButton"
                        Content="Proficio"
                        Width="72"
                        Margin="1,1,6,1"
                        Click="RadioModelButton_Click"
                        Style="{StaticResource MsccGoldButtonStyle}"
                        ToolTip="Select radio family: grays out bands that cannot TX on that model. (Model not sent to hardware yet.)"/>
                <Rectangle Width="1" Height="18" Fill="#FF666666" Margin="0,0,6,0" VerticalAlignment="Center"/>

                <StackPanel x:Name="BandButtonsPanel" Orientation="Horizontal">
                    <!-- LF (Geminus): defaults = digital-mode freqs 136.0 kHz / 474.2 kHz -->
                    <Button x:Name="Band2200Button"
                            Content="2200"
                            Width="48"
                            Margin="1"
                            Click="BandButton_Click"
                            Tag="136000"
                            Style="{StaticResource MsccGoldButtonStyle}"
                            ToolTip="2200m — default 136.000 kHz (digital); Geminus only"/>
                    <Button x:Name="Band630Button"
                            Content="630"
                            Width="40"
                            Margin="1"
                            Click="BandButton_Click"
                            Tag="474200"
                            Style="{StaticResource MsccGoldButtonStyle}"
                            ToolTip="630m — default 474.200 kHz (digital); Geminus only"/>
                    <!-- HF (Proficio) bands — same gold style; active band via UpdateBandButtonVisuals. -->
                    <Button Content="160" Width="40" Margin="1" Click="BandButton_Click" Tag="1800000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="80" Width="40" Margin="1" Click="BandButton_Click" Tag="3500000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="60" Width="40" Margin="1" Click="BandButton_Click" Tag="5350000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="40" Width="40" Margin="1" Click="BandButton_Click" Tag="7000000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="30" Width="40" Margin="1" Click="BandButton_Click" Tag="10100000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="20" Width="40" Margin="1" Click="BandButton_Click" Tag="14000000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="17" Width="40" Margin="1" Click="BandButton_Click" Tag="18100000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="15" Width="40" Margin="1" Click="BandButton_Click" Tag="21000000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="12" Width="40" Margin="1" Click="BandButton_Click" Tag="24900000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button Content="10" Width="40" Margin="1" Click="BandButton_Click" Tag="28000000" Style="{StaticResource MsccGoldButtonStyle}"/>
                    <Button x:Name="GenBandButton" Content="USER" Width="48" Margin="1" Click="GenBandButton_Click" Tag="10000000" Style="{StaticResource MsccGoldButtonStyle}"
                            ToolTip="GEN: Proficio = WWV/CHU/RWM/USER; Geminus = 198 / 660 / 880 kHz (freq cal). Click again to rotate."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tab content in spectrum (*) column only; operate right panel is sibling Grid.Column 1 -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" Grid.Column="0"
                    FontSize="12" FontWeight="Bold"
                    Style="{StaticResource MsccTabControlStyle}"
                    Background="#FF1C1C1C"
                    BorderThickness="0"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabControl.Resources>
                <!-- Compact tab headers — more vertical room for MAIN side panels.
                     IsEnabled=False dims the header (AMP CAL / TRANS CAL / TX IQ gates). -->
                <!-- Slightly less horizontal padding so all tabs stay one row near ~1050 px -->
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="7,2"/>
                    <Setter Property="MinHeight" Value="22"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF333333"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#555"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="3,3,0,0"
                                        Margin="1,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="HeaderContent"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#FF2A2A2A"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00FFAA"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#FF3A3A3A"/>
                                    </Trigger>
                                    <!-- Dim disabled tabs (AMP off → AMP CAL grey; AMP on → TRANS CAL / TX IQ grey) -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#FF666666"/>
                                        <Setter TargetName="TabBorder" Property="Background" Value="#FF1A1A1A"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FF333333"/>
                                        <Setter TargetName="TabBorder" Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- Main Tab (current spectrum view) -->
            <TabItem Header="MAIN" ToolTip="Main transceiver controls and spectrum">
                                    <!-- Spectrum + time (operate right panel is window-level, always visible) -->
                    <Grid PreviewMouseWheel="MainTab_PreviewMouseWheel"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="4,0,4,4" HorizontalAlignment="Stretch"
                                Visibility="{Binding TimeDisplayOn, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#FF1A1A1A" Padding="4" CornerRadius="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LOCAL " Foreground="{DynamicResource UiMutedTextBrush}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding LocalTimeDisplay}" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LocalDateDisplay}" Foreground="{DynamicResource UiMutedTextBrush}" FontSize="9" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                <TextBlock Text="UTC " Foreground="{DynamicResource UiMutedTextBrush}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding UtcTimeDisplay}" Foreground="#00FFAA" FontSize="13" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding UtcDateDisplay}" Foreground="{DynamicResource UiMutedTextBrush}" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#FF0A0A0A" BorderBrush="#444" BorderThickness="1" CornerRadius="4">
                            <controls:SpectrumDisplayControl SpectrumUpdate="{Binding CurrentSpectrum}"
                                                           ZoomFactor="{Binding SpectrumZoom}"
                                                           FrequencyClicked="SpectrumControl_FrequencyClicked"
                                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </Grid>
            </TabItem>

            <!-- CW Tab - implements the original mscc CW tab functions (keyer mode, speed, spacing, paddle, weight, pitch, hold, QSK/Potentia, phones) -->
            <TabItem Header="CW" ToolTip="CW KEYER, SPEED, PITCH, HOLD, QSK, PHONES, CQ MEMORY">
                <Border Background="#FF1A1A1A" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="CW CONTROLS" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#00FFAA"/>
                        <CheckBox Content="Use external electronic keyer (legacy)"
                                  FontSize="12" Foreground="#CCC" Margin="0,0,0,4"
                                  IsChecked="{Binding ExternalElectronicKeyer, Mode=TwoWay}"
                                  ToolTip="Checked = PROFICIO-MKII=0 (legacy / external keyer). Unchecked (default) = MKII internal keyer. Sticky; written to mscc.ini. Flip while running offers Stop/Start. Grays PIC keyer controls; HOLD stays live."/>
                        <TextBlock Text="Legacy mode: PIC keyer controls grayed — HOLD stays live. Change applies after Stop/Start (prompted when session is running)."
                                   FontSize="10" Foreground="#FFAA66" TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExternalElectronicKeyer}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Lists row: Mode, Spacing, Paddle, Weight, Pitch -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Margin="5,0" IsEnabled="{Binding PicKeyerControlsEnabled}">
                                <TextBlock Text="KEYER MODE" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                <ListBox Height="75" ItemsSource="{Binding CwKeyerModeOptions}" SelectedIndex="{Binding CwKeyerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Margin="5,0" IsEnabled="{Binding PicKeyerControlsEnabled}">
                                <TextBlock Text="SPACING" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                <ListBox Height="60" ItemsSource="{Binding CwSpacingOptions}" SelectedIndex="{Binding CwSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Margin="5,0" IsEnabled="{Binding PicKeyerControlsEnabled}">
                                <TextBlock Text="PADDLE" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                <ListBox Height="60" ItemsSource="{Binding CwPaddleOptions}" SelectedIndex="{Binding CwPaddle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Margin="5,0" IsEnabled="{Binding PicKeyerControlsEnabled}">
                                <TextBlock Text="WEIGHT" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                <ListBox Height="75" ItemsSource="{Binding CwWeightOptions}" SelectedIndex="{Binding CwWeightIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Margin="5,0">
                                <TextBlock Text="PITCH" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                <ListBox Height="100" ItemsSource="{Binding CwPitchOptions}" SelectedIndex="{Binding CwPitchIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                        <!-- Speed, Hold, toggles -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center"
                                        IsEnabled="{Binding PicKeyerControlsEnabled}">
                                <TextBlock Text="SPEED" Width="55" Foreground="White" VerticalAlignment="Center" FontSize="10"/>
                                <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Padding="3,1" MinWidth="35">
                                    <TextBlock Text="{Binding CwSpeed}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
                                </Border>
                                <Button Content="-" Width="18" Height="18" Margin="2,0" Command="{Binding DecCwSpeedCommand}" Foreground="White" FontSize="9">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#FF333333"/>
                                            <Setter Property="BorderBrush" Value="#FF666666"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="+" Width="18" Height="18" Margin="0,0,2,0" Command="{Binding IncCwSpeedCommand}" Foreground="White" FontSize="9">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#FF333333"/>
                                            <Setter Property="BorderBrush" Value="#FF666666"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="WPM" Foreground="#D0D0D0" FontSize="9" VerticalAlignment="Center" Margin="4,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                <TextBlock Text="HOLD" Width="40" Foreground="White" VerticalAlignment="Center" FontSize="10"/>
                                <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Padding="3,1" MinWidth="35">
                                    <TextBlock Text="{Binding CwHold}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
                                </Border>
                                <Button Content="-" Width="18" Height="18" Margin="2,0" Command="{Binding DecCwHoldCommand}" Foreground="White" FontSize="9">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#FF333333"/>
                                            <Setter Property="BorderBrush" Value="#FF666666"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="+" Width="18" Height="18" Margin="0,0,2,0" Command="{Binding IncCwHoldCommand}" Foreground="White" FontSize="9">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#FF333333"/>
                                            <Setter Property="BorderBrush" Value="#FF666666"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="ms" Foreground="#D0D0D0" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                            </StackPanel>
                            <CheckBox Content="PHONES" IsChecked="{Binding CwPhones, Mode=TwoWay}" Foreground="White" Margin="10,0" VerticalAlignment="Center" FontSize="10"/>
                            <CheckBox Content="POTENTIA / QSK" IsChecked="{Binding CwQsk, Mode=TwoWay}" Foreground="White" Margin="10,0" VerticalAlignment="Center" FontSize="10"/>
                        </StackPanel>

                        <!-- CQ / keyer memory: 4×48; R=store 0x9C, P=play 0x9C (see KEYER-MEMORY-GUI-UDP-BEHAVIOR.md) -->
                        <TextBlock Text="CQ MEMORY" FontWeight="SemiBold" Foreground="#00FFAA" Margin="0,14,0,4"/>
                        <TextBlock Text="R stores that slot to the keyer (EEPROM). P plays once (CW: keyer line, not host PTT). Paddle aborts play. Max 48 printable ASCII. Text is sticky in the client only — not read back from the radio."
                                   FontSize="10" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Grid IsEnabled="{Binding KeyerMemPanelEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Slot 0 -->
                            <TextBox Grid.Row="0" Grid.Column="0" Margin="0,2,6,2" MaxLength="48"
                                     Text="{Binding KeyerMem0, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" FontFamily="Consolas" Background="#FF222222" Foreground="#00FFAA"
                                     CaretBrush="#00FFAA" BorderBrush="#FF666666" BorderThickness="1" Padding="4,3"
                                     ToolTip="Slot 0 message (max 48)"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding KeyerMem0Count}" Foreground="#888888"
                                       FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="36"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="R" Width="32" Height="26" Margin="0,2,4,2"
                                    FontWeight="Bold" FontSize="11" Style="{StaticResource MsccGoldButtonStyle}"
                                    Command="{Binding RecordKeyerMemCommand}" CommandParameter="0"
                                    IsEnabled="{Binding IsRadioRunning}"
                                    ToolTip="Store slot 0 to keyer (0x9C SELECT+BEGIN+chars+END)"/>
                            <Button Grid.Row="0" Grid.Column="3" Content="P" Width="32" Height="26" Margin="0,2,0,2"
                                    FontWeight="Bold" FontSize="11" Style="{StaticResource MsccGoldButtonStyle}"
                                    Command="{Binding PlayKeyerMemCommand}" CommandParameter="0"
                                    IsEnabled="{Binding IsRadioRunning}"
                                    ToolTip="Play slot 0 once (0x9C SELECT+PLAY). Paddle aborts."/>
                            <!-- Slot 1 -->
                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,2,6,2" MaxLength="48"
                                     Text="{Binding KeyerMem1, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" FontFamily="Consolas" Background="#FF222222" Foreground="#00FFAA"
                                     CaretBrush="#00FFAA" BorderBrush="#FF666666" BorderThickness="1" Padding="4,3"
                                     ToolTip="Slot 1 message (max 48)"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KeyerMem1Count}" Foreground="#888888"
                                       FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="36"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="R" Width="32" Height="26" Margin="0,2,4,2"
                                    FontWeight="Bold" FontSize="11" Style="{StaticResource MsccGoldButtonStyle}"
                                    Command="{Binding RecordKeyerMemCommand}" CommandParameter="1"
                                    IsEnabled="{Binding IsRadioRunning}"
                                    ToolTip="Store slot 1 to keyer"/>
                            <Button Grid.Row="1" Grid.Column="3" Content="P" Width="32" Height="26" Margin="0,2,0,2"
                                    FontWeight="Bold" FontSize="11" Style="{StaticResource MsccGoldButtonStyle}"
                                    Command="{Binding PlayKeyerMemCommand}" CommandParameter="1"
                                    IsEnabled="{Binding IsRadioRunning}"
                                    ToolTip="Play slot 1 once"/>
                            <!-- Slot 2 -->
                            <TextBox Grid.Row="2" Grid.Column="0" Margin="0,2,6,2" MaxLength="48"
                                     Text="{Binding KeyerMem2, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" FontFamily="Consolas" Background="#FF222222" Foreground="#00FFAA"
                                     CaretBrush="#00FFAA" BorderBrush="#FF666666" BorderThickness="1" Padding="4,3"
                                     ToolTip="Slot 2 message (max 48)"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KeyerMem2Count}" Foreground="#888888"
                                       FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="36"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="R" Width="32" Height="26" Margin="0,2,4,2"
                                    FontWeight="Bold" FontSize="11" Style="{StaticResource MsccGoldButtonStyle}"
                                    Command="{Binding RecordKeyerMemCommand}" CommandParameter="2"
                                    IsEnabled="{Binding IsRadioRunning}"
                                    ToolTip="Store slot 2 to keyer"/>
                            <Button Grid.Row="2" Grid.Column="3" Content="P" Width="32" Height="26" Margin="0,2,0,2"
                                    FontWeight="Bold" FontSize="11" Style="{StaticResource MsccGoldButtonStyle}"
                                    Command="{Binding PlayKeyerMemCommand}" CommandParameter="2"
                                    IsEnabled="{Binding IsRadioRunning}"
                                    ToolTip="Play slot 2 once"/>
                            <!-- Slot 3 -->
                            <TextBox Grid.Row="3" Grid.Column="0" Margin="0,2,6,2" MaxLength="48"
                                     Text="{Binding KeyerMem3, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" FontFamily="Consolas" Background="#FF222222" Foreground="#00FFAA"
                                     CaretBrush="#00FFAA" BorderBrush="#FF666666" BorderThickness="1" Padding="4,3"
                                     ToolTip="Slot 3 message (max 48)"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding KeyerMem3Count}" Foreground="#888888"
                                       FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="36"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="R" Width="32" Height="26" Margin="0,2,4,2"
                                    FontWeight="Bold" FontSize="11" Style="{StaticResource MsccGoldButtonStyle}"
                                    Command="{Binding RecordKeyerMemCommand}" CommandParameter="3"
                                    IsEnabled="{Binding IsRadioRunning}"
                                    ToolTip="Store slot 3 to keyer"/>
                            <Button Grid.Row="3" Grid.Column="3" Content="P" Width="32" Height="26" Margin="0,2,0,2"
                                    FontWeight="Bold" FontSize="11" Style="{StaticResource MsccGoldButtonStyle}"
                                    Command="{Binding PlayKeyerMemCommand}" CommandParameter="3"
                                    IsEnabled="{Binding IsRadioRunning}"
                                    ToolTip="Play slot 3 once"/>
                        </Grid>
                        <TextBlock Text="{Binding KeyerMemStatus}" FontSize="10" Foreground="#AAAAAA"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="16"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Rx/Tx Tab (content width = spectrum column; operate panel is window-level to the right) -->
            <TabItem Header="RX/TX" ToolTip="RECEIVE AND TRANSMIT SETTINGS, POWER, NB/NR/AN/AGC">
                    <Border Background="#FF1A1A1A" Padding="10" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /> <!-- Power Levels + Default Filters -->
                            <ColumnDefinition Width="*" /> <!-- TX Options & Processing -->
                        </Grid.ColumnDefinitions>

                        <!-- Left: Power Levels + Default Filters (former right panel merged here) -->
                        <Border Grid.Column="0" Background="#FF222222" CornerRadius="4" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="POWER LEVELS" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#00FFAA"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                                    <TextBlock Text="Tune Power" Width="90" VerticalAlignment="Center" Foreground="White"/>
                                    <Slider Width="140" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding TunePowerPercent, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel"/>
                                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="5,0,0,0" Padding="3,1" MinWidth="40">
                                        <TextBlock Text="{Binding TunePowerPercent, StringFormat={}{0}%}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                                    <TextBlock Text="CW Power" Width="90" VerticalAlignment="Center" Foreground="White"/>
                                    <Slider Width="140" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding CwPowerPercent, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel"/>
                                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="5,0,0,0" Padding="3,1" MinWidth="40">
                                        <TextBlock Text="{Binding CwPowerPercent, StringFormat={}{0}%}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                                    <TextBlock Text="SSB Power" Width="90" VerticalAlignment="Center" Foreground="White"/>
                                    <Slider Width="140" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding SsbPowerPercent, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel"/>
                                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="5,0,0,0" Padding="3,1" MinWidth="40">
                                        <TextBlock Text="{Binding SsbPowerPercent, StringFormat={}{0}%}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="AM Carrier" Width="90" VerticalAlignment="Center" Foreground="White"/>
                                    <Slider Width="140" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding AmCarrierPercent, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel"/>
                                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="5,0,0,0" Padding="3,1" MinWidth="40">
                                        <TextBlock Text="{Binding AmCarrierPercent, StringFormat={}{0}%}" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="DEFAULT FILTERS" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#00FFAA"/>
                                <!-- Top row: LOW, HIGH, CW -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <StackPanel Margin="0,0,8,0" Width="70">
                                        <TextBlock Text="LOW" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                        <ListBox Height="115" ItemsSource="{Binding LowCutOptions}" SelectedIndex="{Binding LowCutDefaultIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0" Width="70">
                                        <TextBlock Text="HIGH" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                        <ListBox Height="115" ItemsSource="{Binding HighCutOptions}" SelectedIndex="{Binding HighCutDefaultIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0" Width="70">
                                        <TextBlock Text="CW" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                        <ListBox Height="80" ItemsSource="{Binding CwFilterOptions}" SelectedIndex="{Binding CwFilterDefaultIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                    <StackPanel Width="70">
                                        <TextBlock Text="TX" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                        <ListBox Height="115" ItemsSource="{Binding TxOptions}" SelectedIndex="{Binding TxDefaultIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FF222222" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TX Options: TX BW | Processing side-by-side; buttons 2×2 below -->
                        <Border Grid.Column="1" Background="#FF222222" CornerRadius="4" Padding="8" Margin="0,0,0,0">
                            <StackPanel>
                                <!-- Section headers on one row so they line up -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TX OPTIONS" FontWeight="SemiBold" Foreground="#00FFAA"/>
                                    <TextBlock Grid.Column="2" Text="PROCESSING" FontWeight="SemiBold" Foreground="#00FFAA"/>
                                </Grid>

                                <!-- TX BW list | AGC list (tops aligned) | dim notes to the right of AGC -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10"
                                            VerticalAlignment="Top">
                                    <StackPanel Width="70" Margin="0,0,12,0">
                                        <TextBlock Text="TX BW" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                        <ListBox Height="115" ItemsSource="{Binding TxOptions}"
                                                 SelectedIndex="{Binding TxBandwidthIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#FF222222" Foreground="White"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </StackPanel>

                                    <!-- AGC: label above box (same font as TX BW); list top aligns with TX BW list -->
                                    <StackPanel Width="70" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <TextBlock Text="AGC" Foreground="White" HorizontalAlignment="Center" FontSize="10"/>
                                        <ListBox Height="115" ItemsSource="{Binding AgcOptions}"
                                                 SelectedIndex="{Binding AgcLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#FF222222" Foreground="White"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </StackPanel>

                                    <!-- Dim helper text to the right of AGC selection box -->
                                    <StackPanel VerticalAlignment="Top" Margin="0,14,0,0" MaxWidth="200">
                                        <TextBlock Text="NB, NR, and AN controls are on the right operate panel."
                                                   Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="AGC FAST RELEASE is on the right operate panel."
                                                   Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="AGC mode (SLO/MED/FAST) is also on the right panel button."
                                                   Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Row 2: buttons in 2×2 (QRP | Full Power / Tune | ALC) -->
                                <Grid HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Content="QRP"
                                            Command="{Binding ToggleQrpCommand}"
                                            Margin="0,0,6,6" Width="100" HorizontalAlignment="Left"
                                            Foreground="Black" FontWeight="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                <Setter Property="Height" Value="28"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QrpMode}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="1" Content="Full Power"
                                            Command="{Binding ToggleFullPowerCommand}"
                                            Margin="0,0,0,6" Width="100" HorizontalAlignment="Left"
                                            Foreground="Black" FontWeight="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                <Setter Property="Height" Value="28"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FullPower}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="0" Content="Tune"
                                            Command="{Binding ToggleTuneCommand}"
                                            IsEnabled="{Binding CanUserControlTransmit}"
                                            Margin="0,0,6,0" Width="100" HorizontalAlignment="Left"
                                            Foreground="Black" FontWeight="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                <Setter Property="Height" Value="28"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TuneMode}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource UiButtonAlertBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonAlertBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Content="ALC"
                                            Command="{Binding ToggleAlcCommand}"
                                            Width="100" HorizontalAlignment="Left"
                                            Foreground="Black" FontWeight="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                <Setter Property="Height" Value="28"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlcOn}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Border>
            </TabItem>

            <!-- Favorites: per-band client-side snapshots (same name allowed on different bands) -->
            <TabItem Header="FAVORITES" ToolTip="SAVE AND RECALL NAMED OPERATING CONDITIONS BY BAND (CLIENT ONLY)">
                <Border Background="#FF222222" CornerRadius="4" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="FAVORITES (BY BAND)"
                                   FontWeight="SemiBold" Foreground="#00FFAA" FontSize="14" Margin="0,0,0,8"/>

                        <!-- Band filter + name + actions -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Band" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="80" Height="26"
                                      ItemsSource="{Binding FavoriteBandChoices}"
                                      SelectedItem="{Binding FavoriteBandFilter, Mode=TwoWay}"
                                      Background="#444" Foreground="Black" FontWeight="Bold"
                                      ToolTip="Show favorites for this band only. Same name (e.g. FT-8) can exist on each band."/>
                            <TextBlock Text="Name" Foreground="White" VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <TextBox Width="160" Height="26" VerticalContentAlignment="Center"
                                     Text="{Binding FavoriteNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="32" Background="#444" Foreground="#00FFAA"
                                     BorderBrush="#888" BorderThickness="1" FontWeight="Bold"
                                     ToolTip="Name for this band only (e.g. FT-8 on 20m and FT-8 on 15m are separate)"/>
                            <Button Content="SAVE" Width="70" Height="26" Margin="8,0,0,0"
                                    Command="{Binding SaveFavoriteCommand}"
                                    Style="{StaticResource MsccGoldButtonStyle}"
                                    ToolTip="Store current conditions under this name for the radio's current band"/>
                            <Button Content="RECALL" Width="75" Height="26" Margin="6,0,0,0"
                                    Command="{Binding RecallFavoriteCommand}"
                                    Style="{StaticResource MsccGoldButtonStyle}"
                                    ToolTip="Apply the selected favorite on this band's list"/>
                            <Button Content="DELETE" Width="75" Height="26" Margin="6,0,0,0"
                                    Command="{Binding DeleteFavoriteCommand}"
                                    Style="{StaticResource MsccGoldButtonStyle}"
                                    ToolTip="Remove the selected favorite from this band only"/>
                        </StackPanel>

                        <!-- List for the selected band only — all stored fields -->
                        <Border Grid.Row="2" Background="#FF1A1A1A" BorderBrush="#444" BorderThickness="1" CornerRadius="4">
                            <DataGrid ItemsSource="{Binding FavoritesForBand}"
                                      SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#333"
                                      Background="#FF1A1A1A"
                                      Foreground="White"
                                      RowBackground="#FF1A1A1A"
                                      AlternatingRowBackground="#FF252525"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FontSize="12">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#FF2A2A2A"/>
                                        <Setter Property="Foreground" Value="#00FFAA"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="BorderBrush" Value="#444"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="6,3"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E3A2A"/>
                                                <Setter Property="Foreground" Value="#00FFAA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="100"/>
                                    <DataGridTextColumn Header="VFO" Binding="{Binding Vfo}" Width="50"/>
                                    <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="60"/>
                                    <DataGridTextColumn Header="Frequency" Binding="{Binding FrequencyDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="60"/>
                                    <DataGridTextColumn Header="Low Cut" Binding="{Binding LowCutLabel}" Width="80"/>
                                    <DataGridTextColumn Header="High Cut" Binding="{Binding HighCutLabel}" Width="80"/>
                                    <DataGridTextColumn Header="CW Filter" Binding="{Binding CwFilterLabel}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap"
                                   Text="Per-band lists: e.g. FT-8 on 20m and FT-8 on 15m are separate. SAVE uses the radio's current band. Client-only (MSCC_Favorites.ini) — not sent to ms-sdr."/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- QRP CAL: transceiver (QRP) power calibration. Only active when AMP is off. -->
            <TabItem x:Name="PwrCalTabItem" Header="QRP CAL" ToolTip="QRP / TRANSCEIVER POWER CALIBRATION (AMP must be off)"
                     IsEnabled="{Binding DataContext.IsPowerCalTabEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Background="#FF222222" CornerRadius="4" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- QRP / transceiver group -->
                            <Border Background="#FF1A1A1A" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="QRP / TRANSCEIVER" FontWeight="Bold" Foreground="#00FFAA" FontSize="14" Margin="0,0,0,10"/>

                                    <!-- CALIBRATION STATUS -->
                                    <Border Background="#FF252525" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="CALIBRATION STATUS" FontWeight="Bold" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,8"/>
                                            <!-- UniformGrid: lamps share width and tighten when the window narrows -->
                                            <ItemsControl ItemsSource="{Binding PowerCalBandStatuses}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="1,0" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding BandLabel}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                            <Border Width="14" Height="14" CornerRadius="2" HorizontalAlignment="Center"
                                                                    BorderBrush="#888" BorderThickness="1"
                                                                    Background="{Binding IsCalibrated, Converter={StaticResource BoolToCalStatusBrushConverter}}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Green = calibrated (client-side status). White = not calibrated."
                                                       Foreground="#D0D0D0" FontSize="10" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- BAND SELECTION -->
                                    <Border Background="#FF252525" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="BAND SELECTION" FontWeight="Bold" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding PowerCalBandStatuses}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding BandLabel}" Height="26" Margin="1,0"
                                                                MinWidth="28" HorizontalAlignment="Stretch"
                                                                Command="{Binding DataContext.SelectPowerCalBandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding BandNumber}"
                                                                FontSize="10" FontWeight="Bold" Foreground="Black"
                                                                ToolTip="{Binding BandNumber, StringFormat={}{0}m}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                                    <Setter Property="Padding" Value="2,2"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Slider + step label (0xA2 while CALIBRATE session active) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10" VerticalAlignment="Center">
                                        <TextBlock Text="POWER" Foreground="White" VerticalAlignment="Center" Width="60" FontWeight="Bold"/>
                                        <Slider Width="320" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                                Value="{Binding PowerCalSliderValue, Mode=TwoWay}"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                IsEnabled="{Binding PowerCalCalibrating}"
                                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                                ToolTip="Adjust calibration drive (0xA2) while CALIBRATE is active"/>
                                        <Border Background="#444" BorderBrush="#888" BorderThickness="1" Padding="8,4" Margin="12,0,0,0" MinWidth="160">
                                            <TextBlock Text="{Binding PowerCalStepLabel}" Foreground="#00FFAA" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="TX" Width="90" Height="28" Margin="0,0,8,0"
                                                Command="{Binding TogglePowerCalTxCommand}"
                                                FontWeight="Bold" FontSize="12" Foreground="Black">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerCalTxOn}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource UiButtonAlertBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonAlertBorderBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="Content" Value="TX ON"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerCalCalibrating}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="CALIBRATE" Width="120" Height="28"
                                                Command="{Binding TogglePowerCalCalibrateCommand}"
                                                FontSize="12" FontWeight="Bold" Foreground="Black"
                                                ToolTip="Start/stop manual power calibration (0xA2 + 0xAC)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerCalCalibrating}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="Content" Value="CALIBRATING"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Bands: 2200/630 + 160–10. Band select: 0xA1 → step 0xB4. CALIBRATE: 0xA2 + TX 0xAC. Status: client-settings.ini (PROFICIO_B* / GEMINUS_B*)."
                                       Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- AMP CAL: POWER AMPLIFIER calibration. Only active when AMP is on (original AMP_groupBox3). -->
            <TabItem x:Name="AmpCalTabItem" Header="AMP CAL" ToolTip="POWER AMPLIFIER CALIBRATION (AMP must be on)"
                     IsEnabled="{Binding DataContext.IsAmpCalTabEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Background="#FF222222" CornerRadius="4" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#FF1A1A1A" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="POWER AMPLIFIER" FontWeight="Bold" Foreground="#00FFAA" FontSize="14" Margin="0,0,0,10"/>

                                    <!-- CALIBRATION STATUS (client-side amp-cal-status.ini AMP_B*) -->
                                    <Border Background="#FF252525" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="CALIBRATION STATUS" FontWeight="Bold" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding AmpCalBandStatuses}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="1,0" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding BandLabel}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                            <Border Width="14" Height="14" CornerRadius="2" HorizontalAlignment="Center"
                                                                    BorderBrush="#888" BorderThickness="1"
                                                                    Background="{Binding IsCalibrated, Converter={StaticResource BoolToCalStatusBrushConverter}}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Green = calibrated (client-side status). White = not calibrated."
                                                       Foreground="#D0D0D0" FontSize="10" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- BAND SELECTION -->
                                    <Border Background="#FF252525" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="BAND SELECTION" FontWeight="Bold" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding AmpCalBandStatuses}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding BandLabel}" Height="26" Margin="1,0"
                                                                MinWidth="28" HorizontalAlignment="Stretch"
                                                                Command="{Binding DataContext.SelectAmpCalBandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding BandNumber}"
                                                                FontSize="10" FontWeight="Bold" Foreground="Black"
                                                                ToolTip="{Binding BandNumber, StringFormat={}{0}m}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                                    <Setter Property="Padding" Value="2,2"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- POWER slider + TX/CALIBRATE aligned under the slider track -->
                                    <Grid Margin="0,4,0,4" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="320"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="POWER" Foreground="White"
                                                   VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="-99" Maximum="0"
                                                SmallChange="1" LargeChange="5"
                                                Value="{Binding AmpCalSliderValue, Mode=TwoWay}"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                IsEnabled="{Binding AmpCalCalibrating}"
                                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                                ToolTip="Adjust amp cal step (0x08). Enabled during CALIBRATE. STEP = 100 + value."/>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#444" BorderBrush="#888" BorderThickness="1" Padding="8,4" Margin="12,0,0,0" MinWidth="72">
                                                <TextBlock Text="{Binding AmpCalSliderValue}" Foreground="#00FFAA" FontWeight="Bold"
                                                           FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Background="#444" BorderBrush="#888" BorderThickness="1" Padding="8,4" Margin="12,0,0,0" MinWidth="100">
                                                <TextBlock Text="{Binding AmpCalStepLabel}" Foreground="#00FFAA" FontWeight="Bold"
                                                           FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Same column as the 320px slider → centered under the track -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <Button Content="TX" Width="120" Height="28" Margin="0,0,16,0"
                                                    Command="{Binding ToggleAmpCalTxCommand}"
                                                    FontSize="12" FontWeight="Bold" Foreground="Black"
                                                    ToolTip="Amp cal TX: TUNE mode + RIG_TUNE (original PA_TX_button8)">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AmpCalTxOn}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource UiButtonAlertBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource UiButtonAlertBorderBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="Content" Value="TX ON"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AmpCalCalibrating}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="CALIBRATE" Width="120" Height="28"
                                                    Command="{Binding ToggleAmpCalCalibrateCommand}"
                                                    FontSize="12" FontWeight="Bold" Foreground="Black"
                                                    ToolTip="Manual amp cal: TUNE + RIG_TUNE + potentiia slider (0x08)">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AmpCalCalibrating}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="Content" Value="CALIBRATING"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Status lamps: amp-cal-status.ini. Band: 0xF9+0xFA. TX: RIG_TUNE. CALIBRATE: 0x08 slider (−99…0). Needs QRP CAL lamp green for that band."
                                       Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- RX IQ: controls top (compact), spectrum below — same arrangement idea as FREQ CAL / original. -->
            <TabItem x:Name="RxIqTabItem" Header="RX IQ"
                     ToolTip="RECEIVE I/Q CALIBRATION — controls top, spectrum below">
                <Border Background="#FF222222" CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Compact control strip -->
                            <RowDefinition Height="*"/>   <!-- Spectrum (no waterfall) -->
                        </Grid.RowDefinitions>

                        <!-- Top control strip -->
                        <Border Grid.Row="0" Background="#FF1A1A1A" BorderBrush="#555" BorderThickness="1"
                                CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <TextBlock Text="RECEIVE I/Q" FontWeight="Bold" Foreground="#00FFAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="BAND" Foreground="#D0D0D0" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Border Background="#444" BorderBrush="#888" BorderThickness="1" Padding="8,2" MinWidth="48" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding RxIqBandLabel}" Foreground="#00FFAA" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="FREQ" Foreground="#D0D0D0" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Border Background="#444" BorderBrush="#888" BorderThickness="1" Padding="8,2" MinWidth="110" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding RxIqFreqDisplay}" FontFamily="Consolas" Foreground="#00FFAA" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button Content="START" Width="88" Height="26" Margin="0,0,10,0"
                                            Command="{Binding StartRxIqCommand}"
                                            FontSize="11" FontWeight="Bold" Foreground="Black"
                                            ToolTip="START: 0x58 band + 0x55 RX_IQBD + LO (last-used). Click again to end session.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                <Setter Property="Height" Value="26"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RxIqSessionActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="Content" Value="ACTIVE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <CheckBox Content="UP 24 kHz"
                                              IsChecked="{Binding RxIqUp24k, Mode=TwoWay}"
                                              Foreground="White" FontWeight="Bold" FontSize="11"
                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                              IsEnabled="{Binding RxIqSessionActive}"
                                              ToolTip="Add +24 kHz to LO (image nulling aid)"/>
                                    <Button Content="APPLY" Width="58" Height="26" Margin="0,0,4,0"
                                            Command="{Binding ApplyRxIqCommand}"
                                            Style="{StaticResource MsccGoldButtonStyle}"
                                            FontSize="10" FontWeight="Bold" Foreground="Black"
                                            IsEnabled="{Binding RxIqSessionActive}"
                                            ToolTip="Commit I/Q value (0x57 → wait 0x56)"/>
                                    <Button Content="RESET ALL" Width="72" Height="26"
                                            Command="{Binding ResetAllRxIqCommand}"
                                            Style="{StaticResource MsccGoldButtonStyle}"
                                            FontSize="10" FontWeight="Bold" Foreground="Black"
                                            IsEnabled="{Binding RxIqSessionActive}"
                                            ToolTip="Apply current I/Q offset to all bands (0x55 RX + 0x8D)"/>
                                </StackPanel>

                                <!-- I/Q OFFSET row -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                                    <TextBlock Text="I/Q OFFSET" Foreground="#00FFAA" FontWeight="Bold" FontSize="11"
                                               Width="88" VerticalAlignment="Center"/>
                                    <Slider Width="220" Minimum="-200" Maximum="200"
                                            SmallChange="1" LargeChange="10"
                                            Value="{Binding RxIqOffset, Mode=TwoWay}"
                                            IsEnabled="{Binding RxIqSessionActive}"
                                            VerticalAlignment="Center"
                                            PreviewMouseWheel="Slider_PreviewMouseWheel"
                                            ToolTip="I/Q balance offset (CMD_SET_IQ_OFFSET 0x52)"/>
                                    <Border Background="#444" BorderBrush="#888" BorderThickness="1" Padding="6,2" Margin="8,0,0,0" MinWidth="48">
                                        <TextBlock Text="{Binding RxIqOffset}" Foreground="#00FFAA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button Content="ZERO" Width="56" Height="24" Margin="8,0,0,0"
                                            Command="{Binding ZeroRxIqOffsetCommand}"
                                            Style="{StaticResource MsccGoldButtonStyle}"
                                            FontSize="10" FontWeight="Bold" Foreground="Black"
                                            IsEnabled="{Binding RxIqSessionActive}"
                                            ToolTip="Offset 0 + COMMIT (0x52, 0x57)"/>
                                </StackPanel>

                                <!-- LO FINE row -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                                    <TextBlock Text="LO FINE (Hz)" Foreground="#00FFAA" FontWeight="Bold" FontSize="11"
                                               Width="88" VerticalAlignment="Center"/>
                                    <Slider Width="220" Minimum="-1000" Maximum="2009"
                                            SmallChange="1" LargeChange="100"
                                            Value="{Binding RxIqFreqOffsetHz, Mode=TwoWay}"
                                            IsEnabled="{Binding RxIqSessionActive}"
                                            VerticalAlignment="Center"
                                            PreviewMouseWheel="Slider_PreviewMouseWheel"
                                            ToolTip="Fine LO offset (Hz) — retunes SET_MAIN_FREQ"/>
                                    <Border Background="#444" BorderBrush="#888" BorderThickness="1" Padding="6,2" Margin="8,0,0,0" MinWidth="56">
                                        <TextBlock Text="{Binding RxIqFreqOffsetHz}" Foreground="#00FFAA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button Content="RESET FREQ" Width="88" Height="24" Margin="8,0,0,0"
                                            Command="{Binding ResetRxIqFreqCommand}"
                                            Style="{StaticResource MsccGoldButtonStyle}"
                                            FontSize="10" FontWeight="Bold" Foreground="Black"
                                            IsEnabled="{Binding RxIqSessionActive}"
                                            ToolTip="Clear LO fine offset and retune base [+24 kHz]"/>
                                </StackPanel>

                                <TextBlock Text="{Binding RxIqStatus}" Foreground="#00FFAA" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Spectrum below controls (FREQ CAL style: live feed, no waterfall) -->
                        <controls:SpectrumDisplayControl Grid.Row="1"
                                                       SpectrumUpdate="{Binding CurrentSpectrum}"
                                                       IsInteractive="False"
                                                       ShowWaterfall="False"
                                                       MinHeight="280"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TX IQ: transmit I/Q balance (manual). QRP only (AMP off). Original IQBD_TX on MFC tab. -->
            <TabItem x:Name="TxIqTabItem" Header="TX IQ" ToolTip="TRANSMIT I/Q BALANCE — QRP only (AMP off). Manual offset, no auto cal."
                     IsEnabled="{Binding DataContext.IsTxIqTabEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Background="#FF222222" CornerRadius="4" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#FF1A1A1A" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="TRANSMIT I/Q BALANCE" FontWeight="Bold" Foreground="#00FFAA" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="QRP only (AMP must be off). Select band → set power → TX ON → adjust OFFSET (external RX for image) → APPLY."
                                               Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <!-- BAND SELECTION (same squeeze layout as QRP/AMP CAL) -->
                                    <Border Background="#FF252525" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="BAND SELECTION" FontWeight="Bold" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding TxIqBandItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding BandLabel}" Height="26" Margin="1,0"
                                                                MinWidth="28" HorizontalAlignment="Stretch"
                                                                Command="{Binding DataContext.SelectTxIqBandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding BandNumber}"
                                                                FontSize="10" FontWeight="Bold" Foreground="Black"
                                                                ToolTip="{Binding BandNumber, StringFormat={}{0}m}"
                                                                IsEnabled="{Binding DataContext.TxIqTxOn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                                    <Setter Property="Padding" Value="2,2"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- POWER -->
                                    <Grid Margin="0,4,0,8" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="POWER" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                SmallChange="1" LargeChange="5"
                                                Value="{Binding TxIqPower, Mode=TwoWay}"
                                                VerticalAlignment="Center"
                                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                                ToolTip="Tune power for TX IQ cal (CMD_SET_TUNE_POWER)"/>
                                        <Border Grid.Column="2" Background="#444" BorderBrush="#888" BorderThickness="1" Padding="8,4" Margin="12,0,0,0" MinWidth="48">
                                            <TextBlock Text="{Binding TxIqPower}" Foreground="#00FFAA" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- OFFSET -->
                                    <Grid Margin="0,4,0,8" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="OFFSET" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Slider Grid.Column="1" Minimum="-200" Maximum="200"
                                                SmallChange="1" LargeChange="10"
                                                Value="{Binding TxIqOffset, Mode=TwoWay}"
                                                IsEnabled="{Binding TxIqTxOn}"
                                                VerticalAlignment="Center"
                                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                                ToolTip="TX IQ offset (0x52). Enabled while TX ON. −200…+200."/>
                                        <Border Grid.Column="2" Background="#444" BorderBrush="#888" BorderThickness="1" Padding="8,4" Margin="12,0,0,0" MinWidth="56">
                                            <TextBlock Text="{Binding TxIqOffset}" Foreground="#00FFAA" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- TX / APPLY / RESET -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <Button Content="TX" Width="110" Height="28" Margin="0,0,12,0"
                                                Command="{Binding ToggleTxIqTxCommand}"
                                                FontSize="12" FontWeight="Bold" Foreground="Black"
                                                ToolTip="Start/stop TX IQ tune carrier (TUNE + RIG_TUNE). Use APPLY separately to commit.">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TxIqTxOn}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="Content" Value="TX ON"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="APPLY" Width="110" Height="28" Margin="0,0,12,0"
                                                Command="{Binding ApplyTxIqCommand}"
                                                Style="{StaticResource MsccGoldButtonStyle}"
                                                FontSize="12" FontWeight="Bold" Foreground="Black"
                                                ToolTip="Commit current I/Q value (0x57). Wait for IQ_OPERATION_COMPLETE."/>
                                        <Button Content="RESET ALL" Width="110" Height="28"
                                                Command="{Binding ResetAllTxIqCommand}"
                                                Style="{StaticResource MsccGoldButtonStyle}"
                                                FontSize="12" FontWeight="Bold" Foreground="Black"
                                                ToolTip="Factory reset all I/Q band values (0x8D). Confirmation required."/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding TxIqStatus}" Foreground="#00FFAA" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Bands: 2200/630 + 160–10 (same as QRP/AMP CAL). Band: 0x58 + cal freq. TX: 0x55 TX_IQBD, TUNE, RIG_TUNE. Offset: 0x52. Apply: 0x57 → 0x56. QRP only. External RX to null the image."
                                       Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>


            <!-- Freq Cal Tab (recreated from original for Frequency Calibration) -->
            <TabItem Header="FREQ CAL" ToolTip="FREQUENCY CALIBRATION">
                <Border Background="#FF222222" CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Compact header + buttons + slider -->
                            <RowDefinition Height="*"/>   <!-- Much larger spectrum (no waterfall) -->
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="FREQUENCY CALIBRATION" FontWeight="SemiBold" Foreground="#00FFAA" Margin="0,0,0,3" FontSize="14"/>

                            <!-- Larger buttons: LOOSE, AUTO, MANUAL, CHECK, RESET -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Button x:Name="FreqCalLooseButton" Content="LOOSE" Width="80" Height="28" Margin="2" FontSize="12" FontWeight="Bold" Click="FreqCalLooseButton_Click"/>
                                <Button x:Name="FreqCalAutoButton" Content="AUTO" Width="70" Height="28" Margin="2" FontSize="12" FontWeight="Bold" Click="FreqCalAutoButton_Click"/>
                                <Button x:Name="FreqCalManualButton" Content="MANUAL" Width="85" Height="28" Margin="2" FontSize="12" FontWeight="Bold" Click="FreqCalManualButton_Click"/>
                                <Button x:Name="FreqCalCheckButton" Content="CHECK" Width="70" Height="28" Margin="2" FontSize="12" FontWeight="Bold" Click="FreqCalCheckButton_Click"/>
                                <Button x:Name="FreqCalResetButton" Content="RESET" Width="70" Height="28" Margin="2" FontSize="12" FontWeight="Bold" Click="FreqCalResetButton_Click"/>
                            </StackPanel>

                            <!-- Manual PPM: ± buttons (rate-limited) — slider flooded USB/LO and could freeze -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="PPM:" Width="35" FontSize="12" VerticalAlignment="Center"
                                           ToolTip="Manual coarse PPM offset (relative to current cal). Use − / + one step at a time."/>
                                <Button x:Name="FreqCalPPMMinus" Content="−" Width="32" Height="26" Margin="2,0" FontSize="14" FontWeight="Bold"
                                        IsEnabled="False" Click="FreqCalPPMMinus_Click"
                                        ToolTip="Decrease PPM by 1 (rate-limited to protect radio)"/>
                                <TextBlock x:Name="FreqCalPPMValue" Text="0" Width="36" FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center" TextAlignment="Center" Foreground="#00FFAA"/>
                                <Button x:Name="FreqCalPPMPlus" Content="+" Width="32" Height="26" Margin="2,0" FontSize="14" FontWeight="Bold"
                                        IsEnabled="False" Click="FreqCalPPMPlus_Click"
                                        ToolTip="Increase PPM by 1 (rate-limited to protect radio)"/>
                                <TextBlock Text="ST:" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock x:Name="FreqCalStatusLabel" Text="OK" Width="130" FontSize="12" Foreground="#00FFAA" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="FreqCalProgress" Width="80" Height="18" Minimum="0" Maximum="100" Value="0" Margin="4,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Spectrum - visual only, no waterfall (reduced height to make room for larger controls) -->
                        <controls:SpectrumDisplayControl Grid.Row="1" 
                                                       SpectrumUpdate="{Binding CurrentSpectrum}" 
                                                       IsInteractive="False"
                                                       ShowWaterfall="False"
                                                       MinHeight="280"/>
                    </Grid>
                </Border>
            </TabItem>
            <!-- SETTINGS: UI appearance + future Audio/COM/SWR/keyer + config reset -->
            <TabItem Header="SETTINGS" ToolTip="UI APPEARANCE, COM PORT, AUDIO DEVICES, SWR METER, CONFIGURATION RESET">
                <Border Background="#FF222222" CornerRadius="4" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontWeight="Bold" Foreground="#00FFAA" FontSize="14" Margin="0,0,0,10"/>

                            <!-- UI Appearance (moved from S/W) -->
                            <controls:UiAppearancePanel Margin="0,0,0,12"/>

                            <!-- Audio (active — operator + digital pairs → Multus audio INIs) -->
                            <controls:AudioSettingsPanel Margin="0,0,0,8"/>

                            <!-- COM port (active — writes comm-port.ini for ms-sdr) -->
                            <controls:CommPortSettingsPanel Margin="0,0,0,8"/>

                            <!-- External WiFi SWR meter (UDP listen + HF/LF IP profiles) -->
                            <controls:SwrMeterSettingsPanel x:Name="SwrSettingsPanel" Margin="0,0,0,8"
                                                            ApplyRequested="SwrSettingsPanel_ApplyRequested"/>

                            <!-- Radio temperatures / diagnostics (not on main face — MKII uses TCXO) -->
                            <Border Background="#FF1A1A1A" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Radio temperatures" FontWeight="Bold" Foreground="#00FFAA" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Proficio board temp was used for classic XO drift compensation. MKII TCXO does not need continuous display; kept here for legacy radios and diagnostics. PA temp/current reserved for a future amp-centric UI."
                                               Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding ProficioTempC, StringFormat=Proficio: {0:F1} °C}"
                                               Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="12"
                                               ToolTip="Radio/board temperature report (legacy XO compensation path)"/>
                                    <!-- Future amp monitoring (front-and-center when used) — keep bindings ready:
                                    <TextBlock Text="{Binding AmpTempC, StringFormat=PA temp: {0:F1} °C}"
                                               Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="12" Margin="0,4,0,0"
                                               ToolTip="Amplifier temperature (future amp status face)"/>
                                    <TextBlock Text="{Binding AmpCurrentMa, StringFormat=PA current: {0} mA}"
                                               Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="12" Margin="0,2,0,0"
                                               ToolTip="Amplifier current (future amp status face)"/>
                                    -->
                                    <TextBlock Text="PA temp / PA current — reserved (not shown)"
                                               Foreground="#888" FontSize="10" Margin="0,6,0,0"
                                               ToolTip="Uncomment PA bindings above when amp monitoring is productized"/>
                                </StackPanel>
                            </Border>

                            <!-- Configuration reset -->
                            <Border Background="#FF1A1A1A" BorderBrush="#664444" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Configuration" FontWeight="Bold" Foreground="#FFAA66" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Reset restores default config files under %LocalAppData%\MSCC-NET9\ (keeps logs). Requires MSCC restart. First launch also seeds missing files automatically — Initialize.bat / mscc-init are not required."
                                               Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Button Content="Reset configuration to defaults…"
                                            Width="240" Height="28" HorizontalAlignment="Left"
                                            FontSize="12" FontWeight="Bold"
                                            Click="SettingsConfigReset_Click"
                                            Background="#553333" Foreground="White" BorderBrush="#884444"
                                            ToolTip="Delete MSCC-NET9 config files (not logs), reseed from install init-files if present, then restart MSCC"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Operate right panel — same width as left (180); compact button grid. -->
        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                Background="{DynamicResource UiPanelBackgroundBrush}" BorderBrush="#444" BorderThickness="1"
                CornerRadius="4" Padding="6,4,6,6" Margin="4,0,0,0"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel VerticalAlignment="Top">
                <!-- Buttons: PTT | TUN / AGC | AMP / CMP | S/W -->
                <Grid HorizontalAlignment="Stretch" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1, Col 0: PTT — alert red when on -->
                    <Button Grid.Row="0" Grid.Column="0" Content="PTT" Height="20" Command="{Binding TogglePttCommand}" Margin="0,0,2,2" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEnabled="{Binding CanUserControlTransmit}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PttOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonAlertBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonAlertBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Row 0, Col 1: TUN — alert red when on -->
                    <Button Grid.Row="0" Grid.Column="1" Content="TUN" Height="20" HorizontalAlignment="Stretch" Command="{Binding ToggleTuneCommand}" Margin="2,0,0,2" FontSize="9" VerticalAlignment="Center" IsEnabled="{Binding CanUserControlTransmit}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TuneMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonAlertBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonAlertBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Row 1, Col 0: ALC (under PTT) — selected = darker themed -->
                    <Button Grid.Row="1" Grid.Column="0" Content="{Binding AgcButtonText}" Height="20" HorizontalAlignment="Stretch" Command="{Binding CycleAgcCommand}" Margin="0,2,2,0" FontSize="9" Style="{StaticResource MsccGoldButtonStyle}" VerticalAlignment="Center" ToolTip="AGC"/>

                    <!-- Row 1, Col 1: AMP — alert red when on -->
                    <Button Grid.Row="1" Grid.Column="1" Content="AMP" Height="20" HorizontalAlignment="Stretch" Command="{Binding ToggleAmpCommand}" Margin="2,2,0,0" FontSize="9" VerticalAlignment="Center" ToolTip="EXTERNAL AMP">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AmpOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonAlertBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonAlertBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Row 2, Col 0: CMP — selected darker; disabled when digital audio -->
                    <Button Grid.Row="2" Grid.Column="0" Content="CMP" Height="20" HorizontalAlignment="Stretch"
                            Command="{Binding ToggleCompressionCommand}" Margin="0,2,2,0" FontSize="9"
                            VerticalAlignment="Center"
                            ToolTip="COMPRESSION">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompressionOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDigitalAudio}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Row 2, Col 1: S/W — selected darker when popup open -->
                    <Button Grid.Row="2" Grid.Column="1" Content="S/W" Height="20" HorizontalAlignment="Stretch" Command="{Binding ShowSpecWaterfallCommand}" Margin="2,2,0,0" FontSize="9" VerticalAlignment="Center" ToolTip="SPECTRUM / WATERFALL CONTROLS">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpecWfVisible}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- MAIN operate power: same stores as RX/TX tab; bank follows TUN / mode -->
                <TextBlock Text="{Binding MainOperatePowerLabel}" FontWeight="Bold" Foreground="#00FFAA" FontSize="9"
                           Margin="0,4,0,1" HorizontalAlignment="Left"
                           ToolTip="Drive power for the current context: TUN→Tune, CW→CW, AM→AM carrier, USB/LSB→SSB. Same values as RX/TX Power Levels."/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,1" VerticalAlignment="Center"
                            ToolTip="Drive power for the current context: TUN→Tune, CW→CW, AM→AM carrier, USB/LSB→SSB. Same values as RX/TX Power Levels.">
                    <Slider Width="108" Minimum="0" Maximum="100" SmallChange="1"
                            Value="{Binding MainOperatePowerPercent, Mode=TwoWay}"
                            PreviewMouseWheel="Slider_PreviewMouseWheel" VerticalAlignment="Center"/>
                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="3,0,0,0" Padding="2,1" MinWidth="36">
                        <TextBlock Text="{Binding MainOperatePowerPercent, StringFormat={}{0}%}" FontSize="10" FontWeight="Bold"
                                   Foreground="#00FFAA" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Compression level (enable = CMP button above; phones/P only) -->
                <TextBlock Text="COMPRESSION" FontWeight="Bold" Foreground="#00FFAA" FontSize="9"
                           Margin="0,3,0,1" HorizontalAlignment="Left"
                           ToolTip="Compression level (dB). Phones (P) only — disabled while Audio is D."/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,1" VerticalAlignment="Center"
                            IsEnabled="{Binding IsDigitalAudio, Converter={StaticResource InverseBoolConverter}}"
                            ToolTip="Compression level (dB). Phones (P) only — disabled while Audio is D.">
                    <Slider Width="108" Minimum="0" Maximum="24" SmallChange="1"
                            Value="{Binding CompressionLevel, Mode=TwoWay}"
                            PreviewMouseWheel="Slider_PreviewMouseWheel" VerticalAlignment="Center"/>
                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="3,0,0,0" Padding="2,1" MinWidth="36">
                        <TextBlock Text="{Binding CompressionLevel, StringFormat={}{0}}" FontSize="10" FontWeight="Bold"
                                   Foreground="#00FFAA" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- AGC FAST RELEASE (under COMPRESSION; AGC mode cycle = SLO/MED/FAST button above) -->
                <TextBlock Text="AGC FAST RELEASE" FontWeight="Bold" Foreground="#00FFAA" FontSize="9"
                           Margin="0,3,0,1" HorizontalAlignment="Left"
                           ToolTip="AGC fast release time (ms)"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,1" VerticalAlignment="Center"
                            ToolTip="AGC fast release time (ms)">
                    <Slider Width="108" Minimum="0" Maximum="2000" SmallChange="10"
                            Value="{Binding AgcFastRelease, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel"
                            VerticalAlignment="Center"/>
                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="3,0,0,0" Padding="2,1" MinWidth="48">
                        <TextBlock Text="{Binding AgcFastRelease, StringFormat={}{0} ms}" FontSize="10" FontWeight="Bold"
                                   Foreground="#00FFAA" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- MODE: 3×2, band-button size; active latched; FM reserved (grayed) -->
                <TextBlock Text="MODE" FontWeight="Bold" Foreground="#00FFAA" FontSize="9"
                           Margin="0,5,0,2" HorizontalAlignment="Left"
                           ToolTip="Operating mode for the active VFO. DIG-U uses its own Lo/Hi filters and Audio D."/>
                <Grid HorizontalAlignment="Stretch" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Row 0: LSB USB DIG-U -->
                    <Button Grid.Row="0" Grid.Column="0" Content="LSB" Height="22" Margin="1"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SelectModeCommand}" CommandParameter="LSB"
                            FontSize="9" ToolTip="LSB">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveMode}" Value="LSB">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="1" Content="USB" Height="22" Margin="1" HorizontalAlignment="Stretch"
                            Command="{Binding SelectModeCommand}" CommandParameter="USB"
                            FontSize="9" ToolTip="USB">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveMode}" Value="USB">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="2" Content="DIG-U" Height="22" Margin="1" HorizontalAlignment="Stretch"
                            Command="{Binding SelectModeCommand}" CommandParameter="DIG-U"
                            FontSize="8" ToolTip="DIG-U — digital upper; own Lo/Hi filters; Audio D">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveMode}" Value="DIG-U">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Row 1: CW AM FM(disabled) -->
                    <Button Grid.Row="1" Grid.Column="0" Content="CW" Height="22" Margin="1" HorizontalAlignment="Stretch"
                            Command="{Binding SelectModeCommand}" CommandParameter="CW"
                            FontSize="9" ToolTip="CW">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveMode}" Value="CW">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Content="AM" Height="22" Margin="1" HorizontalAlignment="Stretch"
                            Command="{Binding SelectModeCommand}" CommandParameter="AM"
                            FontSize="9" ToolTip="AM">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveMode}" Value="AM">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="2" Content="FM" Height="22" Margin="1" HorizontalAlignment="Stretch"
                            FontSize="9" IsEnabled="False" Opacity="0.45"
                            ToolTip="FM — not implemented yet"/>
                </Grid>

                <!-- First-wave operate controls (full NB controls live here; NR/MON/TX BW also) -->
                <TextBlock Text="RX / TX" FontWeight="Bold" Foreground="#00FFAA" FontSize="10"
                           Margin="0,5,0,3" HorizontalAlignment="Left"/>

                <!-- NB | NR | AN -->
                <Grid HorizontalAlignment="Left" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="NB" Height="20" HorizontalAlignment="Stretch"
                            Command="{Binding ToggleNbCommand}" Margin="0,0,2,0"
                            Foreground="Black" FontSize="9" FontWeight="Bold"
                            ToolTip="Noise Blanker enable (0x80)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NbOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="NR" Height="20" HorizontalAlignment="Stretch"
                            Command="{Binding ToggleNrCommand}" Margin="2,0,2,0"
                            Foreground="Black" FontSize="9" FontWeight="Bold"
                            ToolTip="Noise Reduction enable (0xA3)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NrOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="AN" Height="20" HorizontalAlignment="Stretch"
                            Command="{Binding ToggleAnCommand}" Margin="2,0,0,0"
                            Foreground="Black" FontSize="9" FontWeight="Bold"
                            ToolTip="Auto Notch enable (0x8E) — same select style as NB/NR">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <!-- Same as NB/NR: bright gold = off; darker selected = on -->
                                    <DataTrigger Binding="{Binding AnOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- NB pulse + threshold (moved from RX/TX) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center"
                            ToolTip="NB pulse width (µs). CMD_GET_SET_NB_PULSE_WIDTH 0x81">
                    <TextBlock Text="Pulse" Width="36" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
                    <Slider Width="72" Minimum="10" Maximum="510" SmallChange="1" LargeChange="10"
                            Value="{Binding NbPulse, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel"
                            VerticalAlignment="Center"/>
                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="3,0,0,0" Padding="2,1" MinWidth="40">
                        <TextBlock Text="{Binding NbPulse, StringFormat={}{0}}" FontSize="10" FontWeight="Bold"
                                   Foreground="#00FFAA" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center"
                            ToolTip="NB threshold. CMD_GET_SET_NB_THRESHOLD 0x82">
                    <TextBlock Text="Thr" Width="36" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
                    <Slider Width="72" Minimum="1" Maximum="1009" SmallChange="5" LargeChange="20"
                            Value="{Binding NbThreshold, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel"
                            VerticalAlignment="Center"/>
                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="3,0,0,0" Padding="2,1" MinWidth="40">
                        <TextBlock Text="{Binding NbThreshold}" FontSize="10" FontWeight="Bold"
                                   Foreground="#00FFAA" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- NR level (moved from RX/TX) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center"
                            ToolTip="Noise reduction level (0–100)">
                    <TextBlock Text="NR" Width="36" VerticalAlignment="Center" Foreground="{DynamicResource UiPrimaryTextBrush}" FontSize="9"/>
                    <Slider Width="72" Minimum="0" Maximum="100" SmallChange="1"
                            Value="{Binding NrLevel, Mode=TwoWay}" PreviewMouseWheel="Slider_PreviewMouseWheel"
                            VerticalAlignment="Center"/>
                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888" Margin="3,0,0,0" Padding="2,1" MinWidth="40">
                        <TextBlock Text="{Binding NrLevel}" FontSize="10" FontWeight="Bold"
                                   Foreground="#00FFAA" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- MON | TX BW (cycle) -->
                <Grid HorizontalAlignment="Left" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="MON" Height="20" HorizontalAlignment="Stretch"
                            Command="{Binding ToggleMonitorCommand}" Margin="0,0,3,0"
                            Foreground="Black" FontSize="9" FontWeight="Bold"
                            ToolTip="Mic monitor (same as AUD/SYS)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MonitorOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="{Binding TxBwButtonText}" Height="20" HorizontalAlignment="Stretch"
                            Command="{Binding CycleTxBandwidthCommand}" Margin="3,0,0,0"
                            FontSize="9" Style="{StaticResource MsccGoldButtonStyle}"
                            ToolTip="Cycle TX bandwidth (same as RX/TX list)"/>
                </Grid>

                <!-- CW SPEED (WPM) — always available; most useful in CW -->
                <TextBlock Text="CW SPEED" FontWeight="Bold" Foreground="#00FFAA" FontSize="10"
                           Margin="0,3,0,2" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,2">
                    <Border Background="#FF444444" BorderThickness="1" BorderBrush="#FF888888"
                            Padding="3,1" MinWidth="36" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CwSpeed}" FontSize="12" FontWeight="Bold"
                                   Foreground="#00FFAA" HorizontalAlignment="Center"/>
                    </Border>
                    <Button Content="-" Width="24" Height="22" Margin="4,0,2,0"
                            Command="{Binding DecCwSpeedCommand}"
                            Style="{StaticResource MsccGoldButtonStyle}"
                            ToolTip="Decrease CW speed (WPM)"/>
                    <Button Content="+" Width="24" Height="22" Margin="0,0,4,0"
                            Command="{Binding IncCwSpeedCommand}"
                            Style="{StaticResource MsccGoldButtonStyle}"
                            ToolTip="Increase CW speed (WPM)"/>
                    <TextBlock Text="WPM" Foreground="{DynamicResource UiMutedTextBrush}" FontSize="9" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- CW PITCH — copy of CW tab control (cycle; same CwPitchIndex binding) -->
                <TextBlock Text="CW PITCH" FontWeight="Bold" Foreground="#00FFAA" FontSize="10"
                           Margin="0,6,0,2" HorizontalAlignment="Left"/>
                <Button Content="{Binding CwPitchButtonText}" Width="100" Height="22"
                        HorizontalAlignment="Left" Margin="0,0,0,6"
                        Command="{Binding CycleCwPitchCommand}"
                        Style="{StaticResource MsccGoldButtonStyle}"
                        ToolTip="Cycle CW pitch (400 / 600 / 800 / 1000 Hz) — same as CW tab"/>

                <!-- LOG — fixed under CW pitch (not bottom-docked; avoids overlap when window is short) -->
                <Button Content="LOG" Height="22" HorizontalAlignment="Stretch" Margin="0,0,0,0"
                        Command="{Binding ShowDebugLogCommand}"
                        Foreground="Black" FontSize="9" FontWeight="Bold"
                        ToolTip="Open debug log viewer (RESET LOGS / Pause)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MsccGoldButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DebugLogVisible}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource UiButtonSelectedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource UiButtonSelectedBorderBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
