 841           *   (use the si5351_clock_disable enum)
 842           *
 843           * Set the state of the clock output when it is disabled. Per page 27
 844           * of AN619 (Registers 24 and 25), there are four possible values: low,
 845           * high, high impedance, and never disabled.
 846           */
 847          void si5351_set_clock_disable(enum si5351_clock clk, enum si5351_clock_disable dis_state)
 848          {
 849   1              uint8_t reg_val, reg = 0;
 850   1      
 851   1              if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 852   1              {
 853   2                      reg = SI5351_CLK3_0_DISABLE_STATE;
 854   2              }
 855   1              else if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 856   1              {
C51 COMPILER V9.51   SI5351                                                                07/22/2026 12:45:12 PAGE 15  

 857   2                      reg = SI5351_CLK7_4_DISABLE_STATE;
 858   2              }
 859   1      
 860   1              si5351_read(reg, &reg_val);
 861   1      
 862   1              if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 863   1              {
 864   2                      reg_val &= ~(0x03 << (clk * 2));
 865   2                      reg_val |= dis_state << (clk * 2);
 866   2              }
 867   1              else if (clk >= SI5351_CLK0 && clk <= SI5351_CLK3)
 868   1              {
 869   2                      reg_val &= ~(0x03 << ((clk - 4) * 2));
 870   2                      reg_val |= dis_state << ((clk - 4) * 2);
 871   2              }
 872   1      
 873   1              si5351_write_init(reg, reg_val);
 874   1          
 875   1      }
