;---- Variable 'interruptState' assigned to Register 'R7' ----
  593: 
  594: 
  595:     /***************************************************************************
  596:     * Enable SPC clock. This also internally enables the 36MHz IMO, since this
  597:     * is required for the SPC to function.
  598:     ***************************************************************************/
  599:     CY_FLASH_PM_ACT_CFG0_REG    |= CY_FLASH_PM_ACT_CFG0_EN_CLK_SPC;
002254 9043A0            MOV      DPTR,#043A0H
002257 E0                MOVX     A,@DPTR
002258 4408              ORL      A,#08H
00225A F0                MOVX     @DPTR,A
  600:     CY_FLASH_PM_ALTACT_CFG0_REG |= CY_FLASH_PM_ALTACT_CFG0_EN_CLK_SPC;
00225B 9043B0            MOV      DPTR,#043B0H
00225E E0                MOVX     A,@DPTR
00225F 4408              ORL      A,#08H
002261 F0                MOVX     @DPTR,A
LX51 LINKER/LOCATER V4.64.0.0                                                         12/15/2017  11:38:08  PAGE 114


  601: 
  602: 
  603:     /***************************************************************************
  604:     * The wake count defines the number of Bus Clock cycles it takes for the
  605:     * flash or EEPROM to wake up from a low power mode independent of the chip
  606:     * power mode. Wake up time for these blocks is 5 us.
  607:     * The granularity of this register is 2 Bus Clock cycles, so a value of 0x1E
  608:     * (30d) defines the wake up time as 60 cycles of the Bus Clock.
  609:     * This register needs to be written with a value dependent on the Bus Clock
  610:     * frequency so that the duration of the cycles is equal to or greater than
  611:     * the 5 us delay required.
  612:     ***************************************************************************/
  613:     CY_FLASH_SPC_FM_EE_WAKE_CNT_REG = CY_FLASH_SPC_FM_EE_WAKE_CNT_80MHZ;
002262 904701            MOV      DPTR,#04701H
002265 74C8              MOV      A,#0C8H
002267 F0                MOVX     @DPTR,A
  614: 
  615: 
  616:     /***************************************************************************
  617:     * Enable EEPROM. Re-enabling an EEPROM macro takes 5us. During this time,
  618:     * the EE will not acknowledge a PHUB request.
  619:     ***************************************************************************/
  620:     CY_FLASH_PM_ACT_CFG12_REG    |= CY_FLASH_PM_ACT_CFG12_EN_EE;
