 535   2              }
 536   1      
 537   1              switch(drive)
 538   1              {
 539   2              case SI5351_DRIVE_2MA:
 540   2                      reg_val &= ~(mask);
 541   2                      reg_val |= 0x00;
 542   2                      break;
 543   2              case SI5351_DRIVE_4MA:
 544   2                      reg_val &= ~(mask);
 545   2                      reg_val |= 0x01;
