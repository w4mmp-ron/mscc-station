<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MSCC.Avalonia.ViewModels"
        x:Class="MSCC.Avalonia.Views.RemoteAfWindow"
        x:DataType="vm:MainViewModel"
        Title="Remote Audio"
        Width="440" Height="520" MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#FF1C1C1C" Foreground="White">
  <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <TextBlock x:Name="TitleBlock" Text="REMOTE AUDIO" FontWeight="SemiBold" FontSize="14"
               Foreground="#00FFAA" Margin="0,0,0,8"/>

    <Border Grid.Row="1" Background="#FF252525" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock x:Name="RxHeading" Text="PHONES RX" FontWeight="SemiBold" Foreground="#00FFAA" Margin="0,0,0,6"/>
        <TextBlock x:Name="VacHint" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#D0D0D0" Margin="0,0,0,4" IsVisible="False"/>
        <TextBlock x:Name="CatHint" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#00FFAA" Margin="0,0,0,6"/>
        <Grid ColumnDefinitions="72,*" Margin="0,0,0,4">
          <TextBlock Text="Device" VerticalAlignment="Center" Foreground="#D0D0D0"/>
          <ComboBox x:Name="PlayDeviceCombo" Grid.Column="1" FontSize="11" SelectionChanged="PlayDevice_Changed"/>
        </Grid>
        <Grid ColumnDefinitions="72,*,40" Margin="0,0,0,4">
          <TextBlock Text="Volume" VerticalAlignment="Center" Foreground="#D0D0D0"/>
          <Slider x:Name="PlayVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" Margin="4,0"
                  ValueChanged="PlayVolume_Changed"/>
          <TextBlock x:Name="PlayVolumeLabel" Grid.Column="2" Text="80" Foreground="#00FFAA" FontWeight="Bold"
                     HorizontalAlignment="Center"/>
        </Grid>
        <CheckBox x:Name="MuteCheck" Content="Mute phones" Foreground="White" Margin="0,0,0,4"
                  IsCheckedChanged="Mute_Changed"/>
        <CheckBox Content="Monitor at radio" IsChecked="{Binding RemoteMonitorAtRadio}" Foreground="White"
                  ToolTip.Tip="Keep the shack speaker while remote RX is on (default off)."/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#FF252525" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock x:Name="MicHeading" Text="EQ / MIC TX" FontWeight="SemiBold" Foreground="#00FFAA" Margin="0,0,0,6"/>
        <StackPanel x:Name="EqPanel">
          <CheckBox x:Name="EqEnableCheck" Content="Playback EQ" Foreground="White" Margin="0,0,0,4"
                    IsCheckedChanged="Eq_Changed"/>
          <Grid ColumnDefinitions="72,*" Margin="0,0,0,2">
            <TextBlock Text="Low" VerticalAlignment="Center" Foreground="#D0D0D0"/>
            <Slider x:Name="EqLowSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_Changed"/>
          </Grid>
          <Grid ColumnDefinitions="72,*" Margin="0,0,0,2">
            <TextBlock Text="Mid" VerticalAlignment="Center" Foreground="#D0D0D0"/>
            <Slider x:Name="EqMidSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_Changed"/>
          </Grid>
          <Grid ColumnDefinitions="72,*" Margin="0,0,0,6">
            <TextBlock Text="High" VerticalAlignment="Center" Foreground="#D0D0D0"/>
            <Slider x:Name="EqHighSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_Changed"/>
          </Grid>
        </StackPanel>
        <Grid ColumnDefinitions="72,*" Margin="0,0,0,4">
          <TextBlock Text="Mic" VerticalAlignment="Center" Foreground="#D0D0D0"/>
          <ComboBox x:Name="MicDeviceCombo" Grid.Column="1" FontSize="11" SelectionChanged="MicDevice_Changed"/>
        </Grid>
        <Grid ColumnDefinitions="72,*,40">
          <TextBlock Text="Mic vol" VerticalAlignment="Center" Foreground="#D0D0D0"/>
          <Slider x:Name="MicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" Margin="4,0"
                  ValueChanged="MicVolume_Changed"/>
          <TextBlock x:Name="MicVolumeLabel" Grid.Column="2" Text="80" Foreground="#00FFAA" FontWeight="Bold"
                     HorizontalAlignment="Center"/>
        </Grid>
      </StackPanel>
    </Border>

    <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
             Background="#111" Foreground="#D0D0D0" BorderBrush="#444"
             AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"/>

    <DockPanel Grid.Row="4">
      <Button Content="Reset EQ" Classes="mscc-gold" Width="80" Click="ResetEq_Click" DockPanel.Dock="Left"/>
      <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#D0D0D0" Text="—"/>
    </DockPanel>
  </Grid>
</Window>
