;---- Variable 'interruptState' assigned to Register 'R7' ----
  666: 
  667: 
  668:     /***************************************************************************
  669:     * Enable SPC clock. This also internally enables the 36MHz IMO, since this
  670:     * is required for the SPC to function.
  671:     ***************************************************************************/
  672:     CY_FLASH_PM_ACT_CFG0_REG    |= CY_FLASH_PM_ACT_CFG0_EN_CLK_SPC;
008D64 9043A0            MOV      DPTR,#043A0H
008D67 E0                MOVX     A,@DPTR
008D68 4408              ORL      A,#08H
008D6A F0                MOVX     @DPTR,A
