 469   1          for (i = 0u; i < USBFS_MAX_INTERFACES_NUMBER; i++)
 470   1          {
 471   2              USBFS_hidProtocol[i] = USBFS_PROTOCOL_REPORT;
 472   2          }
 473   1      #endif /* USBFS_ENABLE_HID_CLASS */
 474   1      
 475   1          /* Store device number to access descriptor. */
 476   1          USBFS_device = device;
 477   1      
 478   1          /* Reset component internal variables. */
 479   1          USBFS_transferState   = USBFS_TRANS_STATE_IDLE;
 480   1          USBFS_configurationChanged = 0u;
 481   1          USBFS_configuration   = 0u;
 482   1          USBFS_interfaceNumber = 0u;
