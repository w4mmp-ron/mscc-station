 844   4                      USBFS_EP[curEp].attrib     = pEP->attributes;
 845   4                      USBFS_EP[curEp].bufferSize = pEP->bufferSize;
 846   4      
 847   4                      if (0u != (pEP->addr & USBFS_DIR_IN))
 848   4                      {
 849   5                          /* IN Endpoint */
 850   5                          USBFS_EP[curEp].epMode     = USBFS_GET_ACTIVE_IN_EP_CR0_MODE(epType);
