008DBF 4410              ORL      A,#010H
008DC1 F0                MOVX     @DPTR,A
008DC2         ?C0085?CYFLASH:
  695: 
  696:     while(0u == (CY_FLASH_SPC_FM_EE_CR_REG & CY_FLASH_EE_EE_AWAKE))
008DC2 904700            MOV      DPTR,#04700H
008DC5 E0                MOVX     A,@DPTR
008DC6 5420              ANL      A,#020H
008DC8 60F8              JZ       ?C0085?CYFLASH
  697:     {
  698:         /* Non-zero status denotes that the EEPROM/Flash is awake & powered. */
  699:     }
