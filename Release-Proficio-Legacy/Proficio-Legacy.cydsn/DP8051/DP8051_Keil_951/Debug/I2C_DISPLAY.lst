 161          /*******************************************************************************
 162          * Function Name: I2C_DISPLAY_Start
 163          ********************************************************************************
 164          *
 165          * Summary:
 166          *  Starts the I2C hardware. Enables Active mode power template bits or clock
 167          *  gating as appropriate. It is required to be executed before I2C bus
 168          *  operation.
 169          *
 170          * Parameters:
 171          *  None.
 172          *
 173          * Return:
 174          *  None.
 175          *
 176          * Side Effects:
 177          *  This component automatically enables its interrupt.  If I2C is enabled !
C51 COMPILER V9.51   I2C_DISPLAY                                                           08/14/2026 10:16:37 PAGE 4   

 178          *  without the interrupt enabled, it can lock up the I2C bus.
 179          *
 180          * Global variables:
 181          *  I2C_DISPLAY_initVar - This variable is used to check the initial
 182          *                             configuration, modified on the first
 183          *                             function call.
 184          *
 185          * Reentrant:
 186          *  No.
 187          *
 188          *******************************************************************************/
 189          void I2C_DISPLAY_Start(void) 
 190          {
 191   1          if (0u == I2C_DISPLAY_initVar)
 192   1          {
 193   2              I2C_DISPLAY_Init();
 194   2              I2C_DISPLAY_initVar = 1u; /* Component initialized */
 195   2          }
 196   1      
 197   1          I2C_DISPLAY_Enable();
 198   1          I2C_DISPLAY_EnableInt();
 199   1      }
