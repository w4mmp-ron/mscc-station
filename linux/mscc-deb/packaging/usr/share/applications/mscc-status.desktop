[Desktop Entry]
Type=Application
Name=MSCC Status
GenericName=MSCC status and install check
Comment=Show MSCC servers, config, PortAudio device match, CAT port
# Wrapper holds the window open (GNOME quoting of bash -lc is unreliable).
Exec=mscc-status-window
Icon=dialog-information
Terminal=true
Categories=X-MSCC;
Keywords=MSCC;SDR;Proficio;Multus;status;check;
StartupNotify=false
