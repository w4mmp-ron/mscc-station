 871   1              {
 872   2                      reg_val &= ~(0x03 << ((clk - 4) * 2));
 873   2                      reg_val |= dis_state << ((clk - 4) * 2);
 874   2              }
 875   1      
 876   1              si5351_write_init(reg, reg_val);
 877   1          
 878   1      }
