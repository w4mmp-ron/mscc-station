 290   2              /* Restore state of USB regulator and wait until it supples stable power. */
 291   2              USBFS_CR1_REG |= USBFS_backup.mode;
 292   2              CyDelayUs(USBFS_WAIT_VREF_STABILITY);   /*~50ns delay. */
 293   2      
