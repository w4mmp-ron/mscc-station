 224   1      
 225   1      #if (I2C_DISPLAY_FF_IMPLEMENTED)
 226   1          {
 227   2              uint8 intState;
 228   2              uint16 blockResetCycles;
 229   2      
 230   2              /* Store registers effected by block disable */
 231   2              I2C_DISPLAY_backup.addr    = I2C_DISPLAY_ADDR_REG;
 232   2              I2C_DISPLAY_backup.clkDiv1 = I2C_DISPLAY_CLKDIV1_REG;
 233   2              I2C_DISPLAY_backup.clkDiv2 = I2C_DISPLAY_CLKDIV2_REG;
