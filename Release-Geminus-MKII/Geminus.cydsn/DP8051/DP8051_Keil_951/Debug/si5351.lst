 220           * si5351_init(uint8_t xtal_load_c, uint32 ref_osc_freq)
 221           *
 222           * Setup communications to the Si5351 and set the crystal
 223           * load capacitance.
 224           *
 225           * xtal_load_c - Crystal load capacitance. Use the SI5351_CRYSTAL_LOAD_*PF
 226           * defines in the header file
 227           * ref_osc_freq - Crystal/reference oscillator frequency in 1 Hz increments.
 228           * Defaults to 25000000 if a 0 is used here.
 229           *
 230           */
 231          int si5351_init(uint8_t xtal_load_c, uint32 ref_osc_freq)
 232          {
 233   1              uint8_t ret = 0;
 234   1          
 235   1          //Fake Si570_Xtal so ExtIO_Si570 does not complain
 236   1          Si570_Xtal = swap32((uint32)(SI570_STARTUP_FREQ * 112 / (float)(56.0) * 0x01000000));               
 237   1              /* Set crystal load capacitance */
 238   1              ret = si5351_write_init(SI5351_CRYSTAL_LOAD, xtal_load_c);
