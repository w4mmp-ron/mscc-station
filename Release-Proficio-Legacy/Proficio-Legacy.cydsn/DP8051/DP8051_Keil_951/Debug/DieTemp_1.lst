 119          /*******************************************************************************
 120          * Function Name: DieTemp_1_Query
 121          ********************************************************************************
 122          *
 123          * Summary:
 124          *  Checks to see if the SPC command started by DieTemp_Start() has finished. 
 125          *  If the command has not finished, the temperature value is not read and
 126          *  returned. The caller will need to poll this function while the return status 
 127          *  remains CYRET_STARTED.
 128          *  This can be used only in conjunction with the DieTemp_Start() API to 
 129          *  successfully get the correct Die Temperature.
 130          *  The Die Temperature reading returned on the first sequence of DieTemp_Start() 
 131          *  followed by DieTemp_Query() can be unreliable, so you must do this sequence
 132          *  twice and use the value returned from the second sequence.
 133          *
 134          * Parameters:
 135          *  temperature: Address to store the two-byte temperature value.
 136          *
 137          * Return:
 138          *  CYRET_SUCCESS if the temperature command completes successfully.
 139          *  CYRET_UNKNOWN if the spc failures.
 140          *  CYRET_STARTED if the temperature command has not completed.
 141          *  CYRET_TIMEOUT if waites too long before reading data.
 142          *
 143          *******************************************************************************/
 144          cystatus DieTemp_1_Query(int16 * temperature) 
 145          {
 146   1          uint8 temp[2u];
 147   1          cystatus status;
 148   1      
 149   1          if(CY_SPC_BUSY)
 150   1          {
 151   2              if((CY_SPC_STATUS_REG>>2u) == CYRET_SUCCESS)
 152   2              {
 153   3                  /* See if any data is ready. */
 154   3                  if(CY_SPC_DATA_READY)
 155   3                  {
 156   4                      temp[0u] = CY_SPC_CPU_DATA_REG;
 157   4                      /* Wait for second byte to be ready */
 158   4                      while(!CY_SPC_DATA_READY)
 159   4                      {
 160   5                          CyDelayUs(1u);
 161   5                      }
 162   4                      temp[1u] = CY_SPC_CPU_DATA_REG;
 163   4                      status = CYRET_SUCCESS;
 164   4                  }
 165   3                  else
 166   3                  {
 167   4                      status = CYRET_STARTED;
 168   4                  }
 169   3      
 170   3                  if (status == CYRET_SUCCESS)
 171   3                  {
 172   4                      if(temp[0u] == 1u)
 173   4                      {
 174   5                          *temperature = (int16) ((uint16) temp[1]);
 175   5                      }
 176   4                      else
 177   4                      {
C51 COMPILER V9.51   DIETEMP_1                                                             08/14/2026 10:16:40 PAGE 4   

 178   5                          *temperature = (int16) - ((int16) temp[1]);
 179   5                      }
 180   4                      status = CYRET_SUCCESS;
 181   4                  }
 182   3              }
 183   2              else
 184   2              {
 185   3                  status = CYRET_STARTED;
 186   3              }
 187   2          }
 188   1          else
 189   1          {
 190   2              status = CYRET_TIMEOUT;
 191   2          }
 192   1      
 193   1          if(status != CYRET_STARTED)
 194   1          {
 195   2              /* Unlock the SPC so someone else can use it. */
 196   2              CySpcUnlock();
 197   2          }
 198   1      
 199   1          return (status);
 200   1      }
