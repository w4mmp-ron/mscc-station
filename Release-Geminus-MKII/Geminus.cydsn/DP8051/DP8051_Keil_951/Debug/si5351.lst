  96          /*
  97           * Host-side soft-tune hint for E_smooth.
  98           *
  99           * Primary pop elimination is Multisynth-hold in si5351aSetFrequency()
 100           * (si5351a.c), which overrides E_smooth when the VCO can stay legal.
 101           * This function only biases large LO hops; MS-hold is authoritative.
 102           *
 103           * Math: max_ppm = ((freq/1000)*TUNING_PPM)/1000 + MIN_SMOOTH_HZ floor.
 104           * First LO after boot returns hard.
 105           * (Ported from Proficio-MKII-ATU smooth-tune work 2026-07.)
 106           */
 107          uint8 smooth_tuning(uint32 freq){
 108   1          static uint32 previous_freq = 0;
 109   1          uint8 smooth = TRUE;
 110   1          uint32 abs_freq;
 111   1          int32 freq_diff;
 112   1          uint32 max_ppm_freq;
 113   1      
 114   1          /* First LO after boot / unknown previous: force hard retune */
C51 COMPILER V9.51   SI5351                                                                07/22/2026 12:45:12 PAGE 3   

 115   1          if (previous_freq == 0) {
 116   2              previous_freq = freq;
 117   2              return FALSE;
 118   2          }
 119   1      
 120   1          freq_diff = (int32)(freq - previous_freq);
 121   1          abs_freq = labs(freq_diff);
 122   1          if (abs_freq >= MAX_FREQ_DELTA) {
 123   2              smooth = FALSE;
 124   2          } else {
 125   2              /* ppm window in Hz without uint64 (8051/Keil C51) */
 126   2              max_ppm_freq = ((freq / 1000u) * (uint32)TUNING_PPM) / 1000u;
 127   2              if (max_ppm_freq < MIN_SMOOTH_HZ) {
 128   3                  max_ppm_freq = MIN_SMOOTH_HZ;
 129   3              }
 130   2              if (abs_freq > max_ppm_freq) {
 131   3                  smooth = FALSE;
 132   3              }
 133   2          }
 134   1          previous_freq = freq;
 135   1          return smooth;
 136   1      }
