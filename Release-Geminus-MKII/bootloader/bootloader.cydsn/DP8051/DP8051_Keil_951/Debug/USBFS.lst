 775   1          #endif /* (USBFS_SOF_ISR_ACTIVE) */
 776   1      
 777   1          #if (USBFS_EP1_ISR_ACTIVE)
 778   1              CyIntDisable(USBFS_EP_1_VECT_NUM);
