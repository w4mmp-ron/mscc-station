void Audio_Device_Error(PaError err) {
    /*
     * Fatal audio init failure. Must not return — callers used to fall through
     * and dereference Pa_GetDeviceInfo(paNoDevice) → segfault.
     */
    G_all_threads_run = 0;
    if (G_fp_logfile != NULL) {
        print_time();
        fprintf(G_fp_logfile, "[%d] An error occured while using the portaudio stream\n", line_number++);
        print_time();
        fprintf(G_fp_logfile, "[%d] Error number: %d\n", line_number++, err);
        print_time();
        fprintf(G_fp_logfile, "[%d] Error message: %s\n", line_number++,
            err != paNoError ? Pa_GetErrorText(err) : "(no PortAudio error — missing device)");
        print_time();
        fprintf(G_fp_logfile, "[%d] sdrcore-recv terminating (audio init failed)\n", line_number++);
        fflush(G_fp_logfile);
    }
    MessageBoxA(NULL, "SDRcore-recv initialization FAILED.  Send logs to Multus SDR, LLC", "SDRcore-recv",
            MB_OK | MB_ICONEXCLAMATION);
    Pa_Terminate();
    exit(1);
}

int manage_stream(int start_stop, int device, int channels) {
    PaError err = 0;
    int status = 0;
    static int started = FALSE;
    double sr = (double)mystate.samplerate;

    if (channels < 1)
        channels = 2;
    if (channels > 2) {
        print_time();
        fprintf(G_fp_logfile, "[%d] Main Thread. manage_stream. Device %d. Channel Number: %d greater than 2. Setting channels to 2.\n",
                line_number++, device, channels);
        channels = 2;
    }
    if (start_stop == TRUE) {
        if (started == FALSE) {
            const PaDeviceInfo *odi = Pa_GetDeviceInfo((PaDeviceIndex)device);
            print_time();
            fprintf(G_fp_logfile, "[%d] Main Thread. manage_stream. STARTED.  Device: %d, Channels %d\n",
                    line_number++, device, channels);
            print_time();
            fprintf(G_fp_logfile,
                "[%d] Main Thread. manage_stream. starting FULL-DUPLEX: "
                "in_dev=%d in_ch=%d out_dev=%d out_ch=%d rate=%.0f out_name='%s'\n",
                line_number++,
                (int)inputParameters.device, inputParameters.channelCount,
                device, channels, sr,
                (odi && odi->name) ? odi->name : "?");
            outputParameters.device = device;
            outputParameters.channelCount = channels;
            outputParameters.sampleFormat = PA_SAMPLE_TYPE;
            if (Pa_GetDeviceInfo(outputParameters.device) == NULL) {
                print_time();
                fprintf(G_fp_logfile, "[%d] manage_stream. invalid output device %d\n",
                    line_number++, device);
                return paInvalidDevice;
            }
            if (Pa_GetDeviceInfo(inputParameters.device) == NULL) {
                print_time();
                fprintf(G_fp_logfile, "[%d] manage_stream. invalid I/Q input device %d\n",
                    line_number++, (int)inputParameters.device);
                return paInvalidDevice;
            }
            outputParameters.suggestedLatency =
                Pa_GetDeviceInfo(outputParameters.device)->defaultLowOutputLatency;
            outputParameters.hostApiSpecificStreamInfo = NULL;
            err = Pa_IsFormatSupported(&inputParameters, &outputParameters, sr);
            if (err != paNoError) {
                const PaHostErrorInfo* format_error = Pa_GetLastHostErrorInfo();
                print_time();
                fprintf(G_fp_logfile,
                    "[%d] Main Thread. manage_stream. Pa_IsFormatSupported WARN rate=%.0f "
                    "Device: %d ch=%d: %s — still trying Pa_OpenStream\n",
                    line_number++, sr, device, channels,
                    format_error && format_error->errorText ? format_error->errorText : Pa_GetErrorText(err));
                /* ALSA often rejects IsFormatSupported but OpenStream still works */
            }
            err = Pa_OpenStream(
                &stream,
                &inputParameters,
                &outputParameters,
                sr,
                mystate.frames,
                0, /* paClipOff */
                sdrAudioCallback,
                NULL);
            if (err != paNoError) {
                const PaHostErrorInfo* lpError = Pa_GetLastHostErrorInfo();
                print_time();
                fprintf(G_fp_logfile,
                    "[%d] Main Thread. manage_stream. Open Stream Failed: PA %d '%s' host='%s'\n",
                    line_number++, err, Pa_GetErrorText(err),
                    lpError && lpError->errorText ? lpError->errorText : "");
            } else {
                print_time();
                fprintf(G_fp_logfile,
                    "[%d] Main Thread. manage_stream. Pa_OpenStream OK — starting\n",
                    line_number++);
                err = Pa_StartStream(stream);
                if (err != paNoError) {
                    const PaHostErrorInfo* lpError = Pa_GetLastHostErrorInfo();
                    print_time();
                    fprintf(G_fp_logfile,
                        "[%d] Main Thread. manage_stream. Start Stream Failed: PA %d '%s' host='%s'\n",
                        line_number++, err, Pa_GetErrorText(err),
                        lpError && lpError->errorText ? lpError->errorText : "");
                    Pa_CloseStream(stream);
                    stream = NULL;
                } else {
                    print_time();
                    fprintf(G_fp_logfile,
                        "[%d] Main Thread. manage_stream. Pa_StartStream OK (I/Q capture live)\n",
                        line_number++);
                }
            }
        }
        if (err == paNoError) {
            started = TRUE;
        }
    } else {
        if (started == TRUE) {
            print_time();
            fprintf(G_fp_logfile, "[%d] Main Thread. manage_stream. STARTED.  Device: %d, Channels %d\n",
                line_number++, device, channels);
            print_time();
            fprintf(G_fp_logfile, "[%d] Main Thread. manage_stream. Stoping Stream.  New device: %d, New Channels %d\n",
                    line_number++, device, channels);
            if (stream != NULL) {
                Pa_StopStream(stream);
                Pa_CloseStream(stream);
                stream = NULL;
            }
            started = FALSE;
            Sleep(80); /* ALSA settle before reopen */
        } else {
            print_time();
            fprintf(G_fp_logfile, "[%d] Main Thread. manage_stream. start_stop: %d, started: %d\n",
                    line_number++, start_stop, started);
            err = 0;
        }
    }
    status = err;
    print_time();
    fprintf(G_fp_logfile, "[%d] Main Thread. manage_stream.  FINISHED. status: %d\n", line_number++, status);
    fflush(G_fp_logfile);
    return status;
}

