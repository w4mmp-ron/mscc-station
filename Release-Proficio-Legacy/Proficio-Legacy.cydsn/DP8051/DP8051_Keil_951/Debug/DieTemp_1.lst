 258          /*******************************************************************************
 259          * Function Name: DieTemp_1_GetTemp
 260          ********************************************************************************
 261          *
 262          * Summary:
 263          *  Sends the command and parameters to the SPC to start a Die Temperature 
 264          *  reading and waits until it fails or completes. This is a blocking API.
 265          *  This function reads the Die Temperature twice and returns the second value
 266          *  to work around an issue in the silicon that causes the first value read 
 267          *  to be unreliable.
 268          *
 269          * Parameters:
 270          *  temperature: Address to store the two byte temperature value.
 271          *
 272          * Return:
 273          *  CYRET_SUCCESS if the command completes successfully.
 274          *  The Status code from DieTemp_1_Start or DieTemp_1_Query.
 275          *
 276          *******************************************************************************/
 277          cystatus DieTemp_1_GetTemp(int16 * temperature) 
 278          {
 279   1          cystatus status;
 280   1          uint8 count = 2u;
 281   1          while (count != 0u)
 282   1          {
 283   2              status = DieTemp_1_GetTempT(temperature);
 284   2              if (status != CYRET_SUCCESS)
 285   2              {
 286   3                  break;
 287   3              }
 288   2              count--;
 289   2          }
 290   1          return status;
 291   1      }
