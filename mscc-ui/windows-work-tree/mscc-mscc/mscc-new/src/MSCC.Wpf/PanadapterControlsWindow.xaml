<Window x:Class="MSCC.Wpf.PanadapterControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spectrum / Waterfall Controls (S/W)"
        Height="560" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FF1C1C1C" Foreground="White">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="SPECTRUM / WATERFALL CONTROLS" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#00FFAA" FontSize="14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Spectrum Section matching original -->
                <Border Background="#FF222222" BorderBrush="#444" BorderThickness="1" Padding="4" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="Spectrum" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- FILL -->
                            <StackPanel Margin="2">
                                <TextBlock Text="FILL" FontSize="10" Foreground="#D0D0D0"/>
                                <ListBox x:Name="FillList" Width="55" Height="110" FontSize="8" Background="#111" Foreground="White" SelectionChanged="OnFillSelectionChanged">
                                    <ListBoxItem Content="RED"/>
                                    <ListBoxItem Content="BLUE"/>
                                    <ListBoxItem Content="GREEN"/>
                                    <ListBoxItem Content="YELLOW"/>
                                    <ListBoxItem Content="WHITE"/>
                                    <ListBoxItem Content="BLACK"/>
                                    <ListBoxItem Content="SCOPE"/>
                                </ListBox>
                            </StackPanel>
                            <!-- BACKGROUND -->
                            <StackPanel Margin="2">
                                <TextBlock Text="BACKGROUND" FontSize="10" Foreground="#D0D0D0"/>
                                <ListBox x:Name="BackgroundList" Width="55" Height="120" FontSize="8" Background="#111" Foreground="White"
                                         SelectionChanged="OnBackgroundSelectionChanged"
                                         PreviewMouseLeftButtonDown="OnBackgroundListPreviewMouseDown"
                                         ToolTip="Spectrum pane background. CUSTOM opens color picker (soft dark matches waterfall). Click CUSTOM again to re-pick.">
                                    <ListBoxItem Content="RED"/>
                                    <ListBoxItem Content="BLUE"/>
                                    <ListBoxItem Content="GREEN"/>
                                    <ListBoxItem Content="YELLOW"/>
                                    <ListBoxItem Content="WHITE"/>
                                    <ListBoxItem Content="BLACK"/>
                                    <ListBoxItem Content="CUSTOM"/>
                                </ListBox>
                            </StackPanel>
                            <!-- CURSOR -->
                            <StackPanel Margin="2">
                                <TextBlock Text="CURSOR" FontSize="10" Foreground="#D0D0D0"/>
                                <ListBox x:Name="CursorList" Width="55" Height="110" FontSize="8" Background="#111" Foreground="White" SelectionChanged="OnCursorSelectionChanged">
                                    <ListBoxItem Content="RED"/>
                                    <ListBoxItem Content="BLUE"/>
                                    <ListBoxItem Content="GREEN"/>
                                    <ListBoxItem Content="YELLOW"/>
                                    <ListBoxItem Content="WHITE"/>
                                    <ListBoxItem Content="BLACK"/>
                                </ListBox>
                            </StackPanel>
                            <!-- LINE -->
                            <StackPanel Margin="2">
                                <TextBlock Text="LINE" FontSize="10" Foreground="#D0D0D0"/>
                                <ListBox x:Name="LineList" Width="55" Height="110" FontSize="8" Background="#111" Foreground="White" SelectionChanged="OnLineSelectionChanged">
                                    <ListBoxItem Content="RED"/>
                                    <ListBoxItem Content="BLUE"/>
                                    <ListBoxItem Content="GREEN"/>
                                    <ListBoxItem Content="YELLOW"/>
                                    <ListBoxItem Content="WHITE"/>
                                    <ListBoxItem Content="BLACK"/>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="BASELINE" FontSize="10" Foreground="#D0D0D0" Width="60" VerticalAlignment="Center"
                                       ToolTip="Fine-tunes GRID MIN only (dB). GRID MAX stays at top of pane — no blank strip above −20. Center 50 = use GRID MIN as set. Raise to drop grass; lower to lift it."/>
                            <Button Content="&lt;" Width="20" Height="18" Click="BaselineLeft_Click" FontSize="8"/>
                            <!-- ValueChanged attached in code AFTER Value restore (XAML wire clobberes INI on open). -->
                            <Slider x:Name="BaselineSlider" Width="100" Minimum="0" Maximum="100" Margin="2,0"
                                    SmallChange="1" LargeChange="5" Value="50"
                                    PreviewMouseWheel="OnSliderPreviewMouseWheel"
                                    ToolTip="Floor fine-tune only. 50 = neutral. Raise to sit grass lower (higher effective MIN). Does not shift GRID MAX off the top."/>
                            <Button Content="&gt;" Width="20" Height="18" Click="BaselineRight_Click" FontSize="8"/>
                        </StackPanel>
                        <!-- Phase-1 spectrum dB cal: one global offset for HF+LF (inject known level, align label) -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    ToolTip="Spectrum / waterfall dB cal trim. 0 = field center (−91.3 absolute after pan bias 40). ±20 dB fine adjust. Saved as SPECTRUM_DB_OFFSET in %LocalAppData%\MSCC-NET9\MSCC_Client.ini.">
                            <TextBlock Text="dB CAL" FontSize="10" Foreground="#D0D0D0" Width="60" VerticalAlignment="Center"
                                       ToolTip="Relative trim around center cal. 0 = spot-on center; − lowers display; + raises. Same for Proficio and Geminus."/>
                            <Button Content="&lt;" Width="20" Height="18" Click="DbCalLeft_Click" FontSize="8"
                                    ToolTip="−1 dB (lower the display)"/>
                            <!-- Relative −20…+20; ValueChanged attached in code after restore (avoid INI clobber). -->
                            <Slider x:Name="DbCalSlider" Width="120" Minimum="-20" Maximum="20" Margin="2,0"
                                    SmallChange="0.5" LargeChange="2" Value="0"
                                    TickFrequency="5" IsSnapToTickEnabled="False"
                                    PreviewMouseWheel="OnSliderPreviewMouseWheel"
                                    ToolTip="dB cal trim (±20). 0 = center (−91.3 absolute)."/>
                            <Button Content="&gt;" Width="20" Height="18" Click="DbCalRight_Click" FontSize="8"
                                    ToolTip="+1 dB (raise the display)"/>
                            <TextBlock x:Name="DbCalValueText" Text="0.0" FontSize="9" FontWeight="Bold"
                                       Foreground="#00FFAA" Width="44" Margin="6,0,0,0" VerticalAlignment="Center"
                                       ToolTip="Relative trim (0 = center). Absolute offset shown in tooltip when open."/>
                            <Button Content="RST" Width="28" Height="18" Margin="4,0,0,0" FontSize="8"
                                    Click="DbCalReset_Click" ToolTip="Reset dB cal trim to 0 (center −91.3)"/>
                        </StackPanel>
                        <!-- PowerSDR-style spectrum dBm window (view range; independent of dB CAL) -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    ToolTip="Spectrum view window in dBm (after dB CAL). Defaults −20…−125 so HF grass (~−116) fills the lower pane. Not the same as BASELINE.">
                            <TextBlock Text="GRID MAX" FontSize="10" Foreground="#D0D0D0" Width="60" VerticalAlignment="Center"
                                       ToolTip="Top of spectrum pane (dBm). Default −20; lower to zoom levels (e.g. −40)."/>
                            <!-- ValueChanged in code after restore — XAML wire wrote GRID MAX/MIN on open. -->
                            <Slider x:Name="GridMaxSlider" Width="90" Minimum="-80" Maximum="0" Margin="2,0"
                                    SmallChange="1" LargeChange="5" Value="-20"
                                    PreviewMouseWheel="OnSliderPreviewMouseWheel"
                                    ToolTip="Spectrum top dBm (−80…0). Default −20."/>
                            <TextBlock x:Name="GridMaxValueText" Text="-20" FontSize="9" FontWeight="Bold"
                                       Foreground="#00FFAA" Width="36" Margin="4,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MIN" FontSize="10" Foreground="#D0D0D0" Width="28" VerticalAlignment="Center"
                                       ToolTip="Bottom of spectrum pane (dBm). Default −125 shows full grass near −116."/>
                            <!-- Range −160…−90 so default −125 is valid. Old Max −100 made WPF clamp default 0 → −100 (lost −120 tick). -->
                            <Slider x:Name="GridMinSlider" Width="90" Minimum="-160" Maximum="-90" Margin="2,0"
                                    SmallChange="1" LargeChange="5" Value="-125"
                                    PreviewMouseWheel="OnSliderPreviewMouseWheel"
                                    ToolTip="Spectrum bottom dBm (−160…−90). Default −125 (full grass near −116)."/>
                            <TextBlock x:Name="GridMinValueText" Text="-125" FontSize="9" FontWeight="Bold"
                                       Foreground="#00FFAA" Width="40" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            <Button Content="RST" Width="28" Height="18" Margin="6,0,0,0" FontSize="8"
                                    Click="GridRangeReset_Click" ToolTip="Reset grid to −20 … −125"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="REFRESH" FontSize="10" Foreground="#D0D0D0" Width="60" VerticalAlignment="Center"/>
                            <ListBox x:Name="RefreshList" Width="55" Height="55" FontSize="8" Background="#111" Foreground="White" SelectionChanged="OnRefreshSelectionChanged">
                                <ListBoxItem Content="1"/>
                                <ListBoxItem Content="2"/>
                                <ListBoxItem Content="3"/>
                                <ListBoxItem Content="4"/>
                                <ListBoxItem Content="5"/>
                                <ListBoxItem Content="8"/>
                                <ListBoxItem Content="10"/>
                            </ListBox>
                            <!-- Pan resolution: bins across 72 kHz (UDP segments of 400). Display zoom is separate. -->
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Top">
                                <TextBlock Text="PAN RESOLUTION" FontSize="10" Foreground="#D0D0D0"
                                           ToolTip="Bins across 72 kHz. Higher = sharper spectrum/zoom, more network traffic. Use Normal if remote pan stutters."/>
                                <ListBox x:Name="PanResolutionList" Width="100" Height="55" FontSize="9" Margin="0,2,0,0"
                                         Background="#111" Foreground="White"
                                         SelectionChanged="OnPanResolutionSelectionChanged"
                                         ToolTip="Normal=800, High=1600, Max=3200 bins. Simple display zoom magnifies the selected resolution.">
                                    <ListBoxItem Content="Normal (800)" Tag="0"/>
                                    <ListBoxItem Content="High (1600)" Tag="1"/>
                                    <ListBoxItem Content="Max (3200)" Tag="2"/>
                                </ListBox>
                            </StackPanel>
                            <!-- AUTO SNAP (original panadapter listBox2 + checkbox) — click-to-tune only -->
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Top">
                                <CheckBox x:Name="AutoSnapCheckBox"
                                          Content="AUTO SNAP"
                                          FontSize="10" FontWeight="Bold" Foreground="White"
                                          Checked="OnAutoSnapCheckedChanged"
                                          Unchecked="OnAutoSnapCheckedChanged"
                                          ToolTip="When checked, spectrum click-to-tune snaps to the selected step (not applied in CW)."/>
                                <ListBox x:Name="AutoSnapFreqList" Width="72" Height="55" FontSize="10" Margin="0,4,0,0"
                                         Background="#111" Foreground="White"
                                         SelectionChanged="OnAutoSnapFreqSelectionChanged"
                                         ToolTip="Snap step for click-to-tune">
                                    <ListBoxItem Content="1KHz"/>
                                    <ListBoxItem Content="500Hz"/>
                                    <ListBoxItem Content="100Hz"/>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <CheckBox x:Name="ViewGridCheckBox"
                                      Content="VIEW GRID"
                                      FontSize="11" FontWeight="Bold" Foreground="White"
                                      VerticalAlignment="Center"
                                      Checked="OnViewGridCheckedChanged"
                                      Unchecked="OnViewGridCheckedChanged"
                                      ToolTip="Show horizontal dB grid lines on the spectrum display"/>
                            <CheckBox x:Name="ViewDbLabelsCheckBox"
                                      Content="dB LABELS"
                                      FontSize="11" FontWeight="Bold" Foreground="White"
                                      Margin="16,0,0,0" VerticalAlignment="Center"
                                      Checked="OnViewDbLabelsCheckedChanged"
                                      Unchecked="OnViewDbLabelsCheckedChanged"
                                      ToolTip="Show dB scale numbers on the left of the spectrum (independent of VIEW GRID)"/>
                            <CheckBox x:Name="PeakMarkerCheckBox"
                                      Content="PEAK MARKER"
                                      FontSize="11" FontWeight="Bold" Foreground="White"
                                      Margin="16,0,0,0" VerticalAlignment="Center"
                                      Checked="OnPeakMarkerCheckedChanged"
                                      Unchecked="OnPeakMarkerCheckedChanged"
                                      ToolTip="When on: right-click spectrum to place marker 1 on nearest peak (freq + level). Left-click still click-to-tune. Client-only."/>
                            <CheckBox x:Name="TimeDisplayCheckBox"
                                      Content="TIME DISPLAY"
                                      FontSize="11" FontWeight="Bold" Foreground="White"
                                      Margin="16,0,0,0" VerticalAlignment="Center"
                                      Checked="OnTimeDisplayCheckedChanged"
                                      Unchecked="OnTimeDisplayCheckedChanged"
                                      ToolTip="Show local / UTC time above the spectrum on the MAIN tab (saved in MSCC_Client.ini)"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- UI Appearance moved to Settings tab -->

                <!-- Waterfall Section (palette + gain/zero like original MSCC) -->
                <Border Background="#FF222222" BorderBrush="#444" BorderThickness="1" Padding="4" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Waterfall" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="2">
                                <TextBlock Text="PALETTE COLOR" FontSize="10" Foreground="#D0D0D0" HorizontalAlignment="Center"/>
                                <ListBox x:Name="WaterfallPaletteList" Width="100" Height="80" FontSize="10"
                                         Background="#111" Foreground="White"
                                         SelectionChanged="OnWaterfallPaletteSelectionChanged"
                                         ToolTip="Waterfall color scheme (matches original MSCC)">
                                    <ListBoxItem Content="Red/Yellow"/>
                                    <ListBoxItem Content="Enhanced"/>
                                    <ListBoxItem Content="Spectran"/>
                                    <ListBoxItem Content="BlackWhite"/>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Top" Width="260">
                                <!-- PowerSDR-style palette window (independent of spectrum GRID). Handlers in code. -->
                                <TextBlock Text="WF HIGH (hot)" FontSize="10" Foreground="#D0D0D0"
                                           ToolTip="Top of waterfall palette in dBm (after dB CAL). Default −50 so FT8 ~−80 is vibrant."/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                    <Slider x:Name="WaterfallHighSlider" Width="150" Minimum="-100" Maximum="-20"
                                            SmallChange="1" LargeChange="5" Value="-50"
                                            PreviewMouseWheel="OnSliderPreviewMouseWheel"
                                            ToolTip="Palette top dBm (−100…−20). Lower = more contrast on weak digital."/>
                                    <TextBlock x:Name="WaterfallHighValueText" Text="-50" FontSize="10" FontWeight="Bold"
                                               Foreground="#00FFAA" Width="36" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="WF LOW (cold)" FontSize="10" Foreground="#D0D0D0"
                                           ToolTip="Bottom of waterfall palette in dBm. Default −125 keeps grass dark."/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                    <Slider x:Name="WaterfallLowSlider" Width="150" Minimum="-160" Maximum="-90"
                                            SmallChange="1" LargeChange="5" Value="-125"
                                            PreviewMouseWheel="OnSliderPreviewMouseWheel"
                                            ToolTip="Palette floor dBm (−160…−90). Raise slightly if background is milky."/>
                                    <TextBlock x:Name="WaterfallLowValueText" Text="-125" FontSize="10" FontWeight="Bold"
                                               Foreground="#00FFAA" Width="40" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <Button Content="RST" Width="28" Height="18" Margin="6,0,0,0" FontSize="8"
                                            Click="WaterfallRangeReset_Click"
                                            ToolTip="Reset waterfall to High −50 / Low −125"/>
                                </StackPanel>
                                <TextBlock Text="High −50 / Low −125 = FT8 contrast defaults" FontSize="10" Foreground="#D0D0D0" Margin="0,0,0,8"/>
                                <TextBlock Text="GAIN (fine)" FontSize="10" Foreground="#D0D0D0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                    <Slider x:Name="WaterfallGainSlider" Width="150" Minimum="0" Maximum="100"
                                            SmallChange="1" LargeChange="5" Value="50"
                                            TickFrequency="10" IsSnapToTickEnabled="False"
                                            PreviewMouseWheel="OnSliderPreviewMouseWheel"
                                            ToolTip="Fine trim only. Prefer WF HIGH/LOW for contrast after dB cal."/>
                                    <TextBlock x:Name="WaterfallGainValueText" Text="50" FontSize="10"
                                               Foreground="#00FFAA" Width="28" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="ZERO (fine)" FontSize="10" Foreground="#D0D0D0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Slider x:Name="WaterfallZeroSlider" Width="150" Minimum="0" Maximum="100"
                                            SmallChange="1" LargeChange="5" Value="0"
                                            TickFrequency="10" IsSnapToTickEnabled="False"
                                            PreviewMouseWheel="OnSliderPreviewMouseWheel"
                                            ToolTip="Fine lift into palette. Prefer WF HIGH/LOW first."/>
                                    <TextBlock x:Name="WaterfallZeroValueText" Text="0" FontSize="10"
                                               Foreground="#00FFAA" Width="28" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Gain 50 / Zero 0 = neutral fine trim" FontSize="10" Foreground="#D0D0D0" Margin="0,6,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="TIME MARKER" FontSize="10" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,8,0"
                                               ToolTip="0=off; 1–5 = white time line every N seconds (UTC mm:ss)"/>
                                    <Button x:Name="WaterfallTimeMarkerButton" Content="0" Width="32" Height="26"
                                            FontSize="12" FontWeight="Bold"
                                            Background="#FFDDDDDD" Foreground="Black" BorderBrush="#FF888888"
                                            Click="OnWaterfallTimeMarkerClick"
                                            ToolTip="Click to cycle 0→1→2→3→4→5→0 (interval in seconds; 0=off)"/>
                                </StackPanel>

                                <CheckBox x:Name="WaterfallDirectionCheckBox"
                                          Content="Direction Normal"
                                          FontSize="10" Foreground="White" Margin="0,10,0,0"
                                          Checked="OnWaterfallDirectionChanged"
                                          Unchecked="OnWaterfallDirectionChanged"
                                          ToolTip="Checked = oldest at top / newest at bottom. Unchecked = reversed (newest at top)."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" Width="80" Click="CloseButton_Click" Margin="4,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
