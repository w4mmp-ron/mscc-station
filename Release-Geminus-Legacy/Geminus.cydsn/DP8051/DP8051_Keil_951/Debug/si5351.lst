  92          uint8 smooth_tuning(uint32 freq){
  93   1          static uint32 previous_freq = 0;
  94   1          uint8 smooth = TRUE;
  95   1          uint32 abs_freq;
  96   1          int32 freq_diff;
  97   1          volatile uint32 max_ppm_freq;
  98   1          
  99   1          freq_diff = (int32)(freq - previous_freq);   
 100   1          abs_freq = labs((freq_diff));
 101   1          if(abs_freq >= MAX_FREQ_DELTA){
 102   2              smooth = FALSE;
 103   2          } else {
 104   2              max_ppm_freq = freq / 1000000;
 105   2              max_ppm_freq *= TUNING_PPM;
 106   2              if (abs_freq > max_ppm_freq){
 107   3                  smooth = FALSE;
 108   3              }
 109   2          }
 110   1          previous_freq = freq;
 111   1          return smooth;
 112   1      }
