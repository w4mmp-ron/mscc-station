 639   3              }
 640   2      
 641   2              /* Wait until data byte has been received */
 642   2              while(I2C_DISPLAY_WAIT_BYTE_COMPLETE(I2C_DISPLAY_CSR_REG))
 643   2              {
 644   3              }
 645   2      
 646   2              theByte = I2C_DISPLAY_DATA_REG;
 647   2      
