  62   1              msg_buffer = buffer;
  63   1              write_status = I2C_DISPLAY_MasterWriteBuf(KEYER_SLAVE_ADDRESS,&msg_buffer,1u,I2C_DISPLAY_MODE_COMPLETE_XF
             -ER);
  64   1          while((I2C_DISPLAY_MasterStatus() & I2C_DISPLAY_MSTAT_WR_CMPLT) == 0u){};
  65   1          buffer_written = I2C_DISPLAY_MasterGetWriteBufSize();
  66   1          if(buffer_written != (1u)) {
  67   2              ret_status = 0;
  68   2          }
  69   1          return ret_status;
