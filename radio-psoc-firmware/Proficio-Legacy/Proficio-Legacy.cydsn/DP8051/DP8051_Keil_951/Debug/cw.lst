 359          /*
 360           * Legacy CW (relay T/R):
C51 COMPILER V9.51   CW                                                                    10/31/2026 18:53:24 PAGE 7   

 361           *  - CONTROL_RX / CONTROL_AMP: latched for the whole semi-break-in session
 362           *    (first key-down until CW hold timer expires). Avoids relay chatter.
 363           *  - CONTROL_DIN: element keying — enables audio/I/Q into PCM3060 (mark);
 364           *    clear blanks I/Q (space). Rig has no RF without I/Q.
 365           *  - CONTROL_DOUT: mute RX audio for the session (unchanged role).
 366           * PIN-diode MKII path keyed CONTROL_RX per element; that is wrong for relays.
 367           * Backup: cw.c.bak-pre-legacy-din-key
 368           */
 369          
 370          /* Manage_Paddles_Port state machine (legacy semi-break-in) */
 371          #define CW_ST_IDLE          0   /* track LO; wait to sample key */
 372          #define CW_ST_WAIT_KEY      1   /* sample key-down to start session */
 373          #define CW_ST_SESSION_START 2   /* mute DOUT, blank DIN, LO → TX */
 374          #define CW_ST_MARK          3   /* latch AMP+RX (if needed) + DIN on, restart hang */
 375          #define CW_ST_MARK_HOLD     5   /* stay in mark while key down */
 376          #define CW_ST_SPACE         6   /* DIN off only */
 377          #define CW_ST_HANG          7   /* key up: hang timer or re-key */
 378          #define CW_ST_HANG_POLL     10  /* hang active: poll key */
 379          #define CW_ST_DLY_KEYING    20  /* non-QSK: ISR keying DIN; wait key up and delayed RF done */
 380          #define CW_ST_DLY_HANG      21  /* non-QSK: hang timer running, DIN off, AMP+PA on */
 381          #define CW_ST_DLY_END       22  /* non-QSK: back to RX */
 382          
 383          /* Sample paddle status bits into E_key_0 / E_key_1. Returns TRUE if key down. */
 384          static uint8_t cw_keys_down(void)
 385          {
 386   1          uint8 key;
 387   1          uint8 section;
 388   1      
 389   1          section = CyEnterCriticalSection();
 390   1          key = Status_Read();
 391   1          CyExitCriticalSection(section);
 392   1          if (key & STATUS_KEY_0)
 393   1              E_key_0 = TRUE;
 394   1          else
 395   1              E_key_0 = FALSE;
 396   1          if (key & STATUS_KEY_1)
 397   1              E_key_1 = TRUE;
 398   1          else
 399   1              E_key_1 = FALSE;
 400   1          /* Either contact closed → key down (same test as before) */
 401   1          return (uint8_t)(!E_key_0 || !E_key_1);
 402   1      }
 403          
 404          /* Mute RX (DOUT), blank TX I/Q (DIN), LO → CW TX offset. Returns SI5351 status (0=ok). */
 405          static uint8 cw_session_start(void)
 406          {
 407   1          uint8_t c;
 408   1      
 409   1          c = Control_Read();
 410   1          c = c & ~CONTROL_DOUT;   /* PCM3060 RX out OFF */
 411   1          c = c & ~CONTROL_DIN;    /* I/Q blank until mark */
 412   1          Control_Write(c);
 413   1          return si5351aSetFrequency(CW_LO_Freq + E_cw_pitch_freq);
 414   1      }
 415          
 416          /*
 417           * Latch AMP+RX for hang (idempotent if already on) + DIN mark.
 418           * Hang timer starts on key-up (cw_mark_off), not here — so a long hold
 419           * does not burn TX_HOLD before release.
 420           */
 421          static void cw_mark_on(void)
 422          {
C51 COMPILER V9.51   CW                                                                    10/31/2026 18:53:24 PAGE 8   

 423   1          uint8_t c;
 424   1      
 425   1          c = Control_Read();
 426   1          c = c & ~CONTROL_AMP;    /* AMP ON (active low) */
 427   1          c = c & ~CONTROL_RX;     /* PA / T-R ON (active low) */
 428   1          c = c | CONTROL_DIN;     /* I/Q on → RF */
 429   1          Control_Write(c);
 430   1          /* Keep hold flag true while keying so we never "end session" mid-mark */
 431   1          E_cw_hold = TRUE;
 432   1      }
 433          
 434          /* Key-up space: blank I/Q; start/restart semi-break-in hang timer. */
 435          static void cw_mark_off(void)
 436          {
 437   1          Control_Write(Control_Read() & ~CONTROL_DIN);
 438   1          E_cw_hold = TRUE;
 439   1          CW_Hold_Control_Write(CW_CONTROL_RESET);
 440   1      }
