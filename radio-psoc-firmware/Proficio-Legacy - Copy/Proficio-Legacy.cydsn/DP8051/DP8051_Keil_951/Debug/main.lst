 255          void ERROR(char* msg) {
 256   1          uint8 i, beat;
 257   1          uint16 timer = 0;
 258   1          
 259   1          if(USBFS_initVar) USBFS_Stop();
 260   1          Control_Write(Control_Read() & CONTROL_LED | CONTROL_AMP | CONTROL_RX);
 261   1          Morse_Main(msg);
 262   1          
 263   1          for(;;) {
 264   2              i = Status_Read() & STATUS_BEAT;
 265   2              if (beat != i) {
 266   3                  beat = i;
 267   3                  if (!timer--) {
