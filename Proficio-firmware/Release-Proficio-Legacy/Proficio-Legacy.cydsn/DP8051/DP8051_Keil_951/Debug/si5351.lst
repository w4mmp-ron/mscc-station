 100          /*
 101           * Host-side soft-tune hint for E_smooth.
 102           *
 103           * Primary pop elimination is Multisynth-hold in si5351aSetFrequency()
 104           * (si5351a.c), which overrides E_smooth when the VCO can stay legal.
 105           * This function only biases large LO hops; MS-hold is authoritative.
 106           *
 107           * Math: max_ppm = ((freq/1000)*TUNING_PPM)/1000 + MIN_SMOOTH_HZ floor.
 108           * First LO after boot returns hard.
 109           */
 110          uint8 smooth_tuning(uint32 freq){
 111   1          static uint32 previous_freq = 0;
 112   1          uint8 smooth = TRUE;
 113   1          uint32 abs_freq;
 114   1          int32 freq_diff;
C51 COMPILER V9.51   SI5351                                                                08/22/2026 15:33:28 PAGE 3   

 115   1          uint32 max_ppm_freq;
 116   1      
 117   1          /* First LO after boot / unknown previous: force hard retune */
 118   1          if (previous_freq == 0) {
 119   2              previous_freq = freq;
 120   2              return FALSE;
 121   2          }
 122   1      
 123   1          freq_diff = (int32)(freq - previous_freq);
 124   1          abs_freq = labs(freq_diff);
 125   1          if (abs_freq >= MAX_FREQ_DELTA) {
 126   2              smooth = FALSE;
 127   2          } else {
 128   2              /* ppm window in Hz without uint64 (8051/Keil C51) */
 129   2              max_ppm_freq = ((freq / 1000u) * (uint32)TUNING_PPM) / 1000u;
 130   2              if (max_ppm_freq < MIN_SMOOTH_HZ) {
 131   3                  max_ppm_freq = MIN_SMOOTH_HZ;
 132   3              }
 133   2              if (abs_freq > max_ppm_freq) {
 134   3                  smooth = FALSE;
 135   3              }
 136   2          }
 137   1          previous_freq = freq;
 138   1          return smooth;
 139   1      }
