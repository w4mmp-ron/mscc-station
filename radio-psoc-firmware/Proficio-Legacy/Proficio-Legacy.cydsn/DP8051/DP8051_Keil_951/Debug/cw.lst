 170          uint8 keyer_write(uint8_t buffer)
 171          {
 172   1              uint8_t msg_buffer = 0;
 173   1              uint8_t ret_status = 0;
 174   1              uint8_t write_status = 0;
C51 COMPILER V9.51   CW                                                                    10/31/2026 18:53:24 PAGE 4   

 175   1          uint8 buffer_written = 0;
 176   1          uint8 attempt;
 177   1      
 178   1          /*
 179   1           * PIC may NACK while busy (e.g. EEPROM write on STORE_END). Retry a few
 180   1           * times so a following PLAY is not dropped and keyer not marked missing.
 181   1           */
 182   1          msg_buffer = buffer;
 183   1          for (attempt = 0; attempt < 8u; attempt++) {
 184   2              write_status = I2C_DISPLAY_MasterWriteBuf(KEYER_SLAVE_ADDRESS, &msg_buffer, 1u,
 185   2                  I2C_DISPLAY_MODE_COMPLETE_XFER);
 186   2              while ((I2C_DISPLAY_MasterStatus() & I2C_DISPLAY_MSTAT_WR_CMPLT) == 0u) {
 187   3              }
 188   2              buffer_written = I2C_DISPLAY_MasterGetWriteBufSize();
 189   2              if (buffer_written == 1u) {
 190   3                  ret_status = 1;
 191   3                  break;
 192   3              }
 193   2              CyDelay(5u);
 194   2          }
 195   1          return ret_status;
 196   1      }
