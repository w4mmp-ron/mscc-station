 403   1      
 404   1              if(0u == size)
 405   1              {
 406   2                  crc = ~crc;
 407   2              }
 408   1              else
 409   1              {
 410   2                  do
 411   2                  {
 412   3                      tmp = buffer[tmpIndex - size];
 413   3      
 414   3                      for (i = 0u; i < 8u; i++)
 415   3                      {
 416   4                          if (0u != ((crc & 0x0001u) ^ (tmp & 0x0001u)))
