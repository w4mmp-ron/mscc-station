  55   2              Pulse_Tuner = PULSE_TUNER_TIME;
  56   2          }
  57   1      
  58   1          switch(state) {
  59   2          case 0: // idle
  60   2              if (Status_Read() & STATUS_ATU_0) timer++;
  61   2              else {
  62   3                  if (timer >= 85 && timer <= 115) {
  63   4                      state = 1;
