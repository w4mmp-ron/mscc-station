 433   3                      if (CY_GET_REG8(USBFS_wIndexLo) > KB_MAX_RD || l_kb_len > KB_MAX_WR) break;
 434   3                      E_kb_rlen = CY_GET_REG8(USBFS_wIndexLo);
 435   3                      E_kb_wlen = (uint8)l_kb_len;
 436   3                      E_kb_state = KB_RECEIVING;
 437   3                      USBFS_currentTD.pData = (void *)E_kb_wbuf;
 438   3                      USBFS_currentTD.count = E_kb_wlen;
 439   3                      requestHandled = USBFS_InitControlWrite();
 440   3                      break;
 441   3                 
 442   3                
 443   3              }//End switch (reqCmd)
 444   2          }//End if ((reqType & USBFS_RQST_DIR_MASK) == USBFS_RQST_DIR_D2H)
 445   1          return(requestHandled);
