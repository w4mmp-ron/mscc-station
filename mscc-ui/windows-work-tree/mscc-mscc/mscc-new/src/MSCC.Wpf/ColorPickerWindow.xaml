<Window x:Class="MSCC.Wpf.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color"
        Height="280" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1C1C1C" Foreground="White"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pick a custom UI color" FontWeight="SemiBold" Foreground="#00FFAA" Margin="0,0,0,10"/>

        <Border Grid.Row="1" x:Name="PreviewSwatch" Height="48" BorderBrush="#888" BorderThickness="1" Margin="0,0,0,12" Background="#FFCC00"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="R" Width="20" VerticalAlignment="Center"/>
                <Slider x:Name="SliderR" Width="220" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="TextR" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#00FFAA"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="G" Width="20" VerticalAlignment="Center"/>
                <Slider x:Name="SliderG" Width="220" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="TextG" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#00FFAA"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="B" Width="20" VerticalAlignment="Center"/>
                <Slider x:Name="SliderB" Width="220" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="TextB" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#00FFAA"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,12">
            <TextBlock Text="Hex" Width="36" VerticalAlignment="Center"/>
            <TextBox x:Name="HexBox" Width="100" Background="#333" Foreground="White" BorderBrush="#666"
                     FontFamily="Consolas" LostFocus="OnHexLostFocus" KeyDown="OnHexKeyDown"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"
                    Background="#FFCC00" Foreground="Black" FontWeight="Bold"/>
            <Button Content="Cancel" Width="80" Height="28" IsCancel="True" Click="Cancel_Click"
                    Background="#555" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
