1634          static void Bootloader_HostLink(uint8 timeOut) CYLARGE 
1635                             
1636          #else
              void Bootloader_HostLink(uint8 timeOut) CYLARGE 
                                 
              #endif /*(CYDEV_PROJ_TYPE != CYDEV_PROJ_TYPE_LOADABLEANDBOOTLOADER)*/    
1640          {
