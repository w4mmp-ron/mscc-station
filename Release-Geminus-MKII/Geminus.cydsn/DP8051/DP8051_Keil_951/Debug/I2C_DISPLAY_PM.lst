  42          /*******************************************************************************
  43          * Function Name: I2C_DISPLAY_SaveConfig
  44          ********************************************************************************
  45          *
  46          * Summary:
  47          *  The Enable wakeup from Sleep Mode selection influences this function
  48          *  implementation:
  49          *   Unchecked: Stores the component non-retention configuration registers.
  50          *   Checked:   Disables the master, if it was enabled before, and enables
  51          *              backup regulator of the I2C hardware. If a transaction intended
  52          *              for component executes during this function call, it waits until
C51 COMPILER V9.51   I2C_DISPLAY_PM                                                        12/05/2024 09:17:04 PAGE 2   

  53          *              the current transaction is completed and I2C hardware is ready
  54          *              to enter sleep mode. All subsequent I2C traffic is NAKed until
  55          *              the device is put into sleep mode.
  56          *
  57          * Parameters:
  58          *  None.
  59          *
  60          * Return:
  61          *  None.
  62          *
  63          * Global Variables:
  64          *  I2C_DISPLAY_backup - The global variable used to save the component
  65          *                            configuration and non-retention registers before
  66          *                            entering the sleep mode.
  67          *
  68          * Reentrant:
  69          *  No.
  70          *
  71          *******************************************************************************/
  72          void I2C_DISPLAY_SaveConfig(void) 
  73          {
  74   1      #if (I2C_DISPLAY_FF_IMPLEMENTED)
  75   1          #if (I2C_DISPLAY_WAKEUP_ENABLED)
                      uint8 intState;
                  #endif /* (I2C_DISPLAY_WAKEUP_ENABLED) */
  78   1      
  79   1          /* Store registers before enter low power mode */
  80   1          I2C_DISPLAY_backup.cfg     = I2C_DISPLAY_CFG_REG;
  81   1          I2C_DISPLAY_backup.xcfg    = I2C_DISPLAY_XCFG_REG;
  82   1          I2C_DISPLAY_backup.addr    = I2C_DISPLAY_ADDR_REG;
  83   1          I2C_DISPLAY_backup.clkDiv1 = I2C_DISPLAY_CLKDIV1_REG;
  84   1          I2C_DISPLAY_backup.clkDiv2 = I2C_DISPLAY_CLKDIV2_REG;
  85   1      
  86   1      #if (I2C_DISPLAY_WAKEUP_ENABLED)
                  /* Disable master */
                  I2C_DISPLAY_CFG_REG &= (uint8) ~I2C_DISPLAY_ENABLE_MASTER;
              
                  /* Enable backup regulator to keep block powered in low power mode */
                  intState = CyEnterCriticalSection();
                  I2C_DISPLAY_PWRSYS_CR1_REG |= I2C_DISPLAY_PWRSYS_CR1_I2C_REG_BACKUP;
                  CyExitCriticalSection(intState);
              
                  /* 1) Set force NACK to ignore I2C transactions;
                  *  2) Wait unti I2C is ready go to Sleep; !!
                  *  3) These bits are cleared on wake up.
                  */
                  /* Wait when block is ready for sleep */
                  I2C_DISPLAY_XCFG_REG |= I2C_DISPLAY_XCFG_FORCE_NACK;
                  while (0u == (I2C_DISPLAY_XCFG_REG & I2C_DISPLAY_XCFG_RDY_TO_SLEEP))
                  {
                  }
              
                  /* Setup wakeup interrupt */
                  I2C_DISPLAY_DisableInt();
                  (void) CyIntSetVector(I2C_DISPLAY_ISR_NUMBER, &I2C_DISPLAY_WAKEUP_ISR);
                  I2C_DISPLAY_wakeupSource = 0u;
                  I2C_DISPLAY_EnableInt();
              #endif /* (I2C_DISPLAY_WAKEUP_ENABLED) */
 111   1      
 112   1      #else
                  /* Store only address match bit */
                  I2C_DISPLAY_backup.control = (I2C_DISPLAY_CFG_REG & I2C_DISPLAY_CTRL_ANY_ADDRESS_MASK);
