  55          /*
  56           * Non-QSK amp keying delay. AMP + PA (T/R relays) go on at first key down; the key lines are
  57           * sampled every 1 ms into key_delay_buf and played to DIN (TX I/Q gate) key_delay_ms late,
  58           * so the radio and amp relays settle before RF. Element lengths are unchanged.
  59           * key_delay_ms is latched from E_key_delay_ms (set from E_TX_Hold in main.c) at the start
  60           * of each over, so a change never alters an element mid-over.
  61           * Key_Delay_Timer: fixed-function, CW_Clock (10 kHz), period 10 -> 1 ms tc.
  62           * ISR uses the register macros, not Status_Read()/Control_Read()/Control_Write():
  63           * Keil 8051 functions are not reentrant and the main loop calls those.
  64           * Main loop Control_Write() read-modify-writes may briefly undo CONTROL_DIN;
  65           * the ISR rewrites it every tick, so worst case is a 1 ms edge error.
  66           *
  67           * Key click shaping: the PCM3060 DAC soft mute (reg 0x44, MUT21/MUT22) ramps the I/Q level
  68           * 0.5 dB per 8/fs, i.e. 6 dB/ms at 96 kHz, 16.7 ms from full to mute. The DAC is kept muted
  69           * in CW. For each element DIN opens and the DAC unmutes DAC_RISE_LEAD_MS before the delayed
  70           * key down (so the -6 dB point lands on the edge); at the delayed key up the DAC mutes and
  71           * DIN closes DAC_RAMP_MS later. The ISR only asks for the mute / unmute (dac_req); the main
  72           * loop does the I2C write. Spaces shorter than DAC_RISE_LEAD_MS merge (above about 80 WPM).
  73           */
  74          #define DAC_RAMP_MS 18u        /* soft mute full ramp 16.7 ms at 96 kHz, rounded up */
  75          #define DAC_RISE_LEAD_MS 14u   /* < KEY_DELAY_MIN_MS. Unmute this early: -6 dB after about 15 ms */
  76          #define DAC_REQ_NONE 0u
  77          #define DAC_REQ_MUTE 1u
  78          #define DAC_REQ_UNMUTE 2u
  79          #define PCM3060_REG_DAC_MUTE 0x44u
  80          #define PCM3060_DAC_MUTE_ON 0x03u      /* MUT22 + MUT21 */
  81          #define PCM3060_DAC_MUTE_OFF 0x00u
  82          #define KEY_DELAY_BUF_SIZE 64u       /* ms of key history, power of 2, > KEY_DELAY_MAX_MS */
  83          static uint8 key_delay_buf[KEY_DELAY_BUF_SIZE];
  84          static volatile uint8 key_delay_idx = 0;
  85          static volatile uint8 key_delay_ms = 0;        /* delay for this over */
  86          static volatile uint8 key_up_ms = 0;           /* ms since last key down, stops at 255 */
  87          static volatile uint8 key_delay_active = FALSE;
  88          static volatile uint8 key_delay_busy = FALSE;   /* TRUE until delayed RF of last key down is done */
  89          static volatile uint8 key_delay_lo_ready = FALSE; /* LO on TX freq. DIN held off until TRUE */
  90          volatile uint8 E_ms_tick = 0;                   /* free running 1 ms count, used by TX_Main() amp delay */
  91          static volatile uint8 dac_req = DAC_REQ_NONE;   /* ISR -> main loop: PCM3060 soft mute request */
  92          static volatile uint8 rf_on = FALSE;            /* DIN open and DAC unmuted for an element */
  93          static volatile uint8 rf_off_ms = 255;          /* ms since DAC mute started, stops at 255 */
  94          static uint8 dac_muted = FALSE;                 /* main loop copy of the PCM3060 mute bits */
  95          
  96          CY_ISR(KEY_DELAY_interrupt){
  97   1          uint8 reg;
  98   1          uint8 key;
  99   1          uint8 on;
 100   1      
 101   1          E_ms_tick++;
 102   1          if(!key_delay_active) return;
 103   1          if(TX_Inhibit || (E_host_mode != 'C')){ //Left CW or inhibited mid-over: blank I/Q, stop playing
 104   2              Control_Control &= ~CONTROL_DIN;
 105   2              rf_on = FALSE;
 106   2              dac_req = DAC_REQ_MUTE;
 107   2              key_delay_busy = FALSE;
 108   2              key_delay_active = FALSE;
 109   2              return;
 110   2          }
 111   1          reg = Status_Status;
 112   1          key = (!(reg & STATUS_KEY_0) || !(reg & STATUS_KEY_1));
 113   1          key_delay_buf[key_delay_idx] = key;
 114   1          if(key){
C51 COMPILER V9.51   CW                                                                    10/26/2026 10:09:12 PAGE 3   

 115   2              key_up_ms = 0;
 116   2          }else if(key_up_ms < 255u){
 117   2              key_up_ms++;
 118   2          }
 119   1          on = FALSE;
 120   1          if(key_delay_lo_ready){ //RF from DAC_RISE_LEAD_MS before the delayed key down to the delayed key up
 121   2              on = key_delay_buf[(uint8)(key_delay_idx - key_delay_ms) & (KEY_DELAY_BUF_SIZE - 1u)]
 122   2                || key_delay_buf[(uint8)(key_delay_idx - (key_delay_ms - DAC_RISE_LEAD_MS)) & (KEY_DELAY_BUF_SIZ
             -E - 1u)];
 123   2          }
 124   1          if(on && !rf_on){
 125   2              Control_Control |= CONTROL_DIN;     //I/Q on, DAC ramps up
 126   2              dac_req = DAC_REQ_UNMUTE;
 127   2              rf_on = TRUE;
 128   2          }else if(!on && rf_on){
 129   2              dac_req = DAC_REQ_MUTE;             //DAC ramps down, DIN closes when done
 130   2              rf_on = FALSE;
 131   2              rf_off_ms = 0;
 132   2          }else if(!rf_on){
 133   2              if(rf_off_ms < 255u) rf_off_ms++;
 134   2              if(rf_off_ms >= DAC_RAMP_MS){
 135   3                  Control_Control &= ~CONTROL_DIN;    //I/Q blanked
 136   3              }else{
 137   3                  Control_Control |= CONTROL_DIN;     //Ramping down: DIN stays open (rewrite every tick)
 138   3              }
 139   2          }else{
 140   2              Control_Control |= CONTROL_DIN;         //Rewrite every tick: a main loop Control_Write() may undo
             - it
 141   2          }
 142   1          key_delay_idx = (key_delay_idx + 1u) & (KEY_DELAY_BUF_SIZE - 1u);
 143   1          key_delay_busy = (key_up_ms <= key_delay_ms) || rf_on || (rf_off_ms < DAC_RAMP_MS);
 144   1      }
