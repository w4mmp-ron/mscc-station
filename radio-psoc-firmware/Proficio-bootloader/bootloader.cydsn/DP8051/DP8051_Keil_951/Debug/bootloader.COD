002279 E0                MOVX     A,@DPTR
00227A 5420              ANL      A,#020H
00227C 60F8              JZ       ?C0070?CYFLASH
  624:     {
  625:         /* Non-zero status denotes that the EEPROM/Flash is awake & powered. */
  626:     }
00227E         ?C0071?CYFLASH:
