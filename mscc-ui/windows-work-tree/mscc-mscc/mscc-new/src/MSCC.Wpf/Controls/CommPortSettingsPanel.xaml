<UserControl x:Class="MSCC.Wpf.Controls.CommPortSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="160" d:DesignWidth="520">
    <Border Background="#FF1A1A1A" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel>
            <TextBlock Text="COM Port" FontWeight="Bold" Foreground="#00FFAA" FontSize="13" Margin="0,0,0,4"/>
            <TextBlock Text="Serial port used by ms-sdr (CAT / keyer hardware). Writes %LocalAppData%\MSCC-NET9\comm-port.ini. After changing port: press Stop then Start (green button) so ms-sdr reloads the COM port."
                       Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Port:" Width="70" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                <ComboBox x:Name="PortCombo" Width="120" Height="26" FontSize="12"
                          Background="#111" Foreground="Black"
                          SelectionChanged="OnPortSelectionChanged"
                          ToolTip="Available COM ports on this PC"/>
                <Button Content="Refresh" Width="72" Height="26" Margin="8,0,0,0" FontSize="11"
                        Click="OnRefreshClick"
                        ToolTip="Re-scan serial ports"/>
                <Button Content="Apply" Width="72" Height="26" Margin="6,0,0,0" FontSize="11" FontWeight="Bold"
                        Click="OnApplyClick"
                        ToolTip="Save selection to comm-port.ini now"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Baud:" Width="70" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                <ComboBox x:Name="BaudCombo" Width="100" Height="26" FontSize="12"
                          Background="#111" Foreground="Black"
                          SelectionChanged="OnBaudSelectionChanged"
                          ToolTip="Baud rate (default 9600 = Multus keyer/CAT)"/>
                <CheckBox x:Name="PinCheck" Content="PTT via serial pin (PIN=1)"
                          Margin="16,0,0,0" VerticalAlignment="Center"
                          FontSize="11" Foreground="#CCC"
                          Checked="OnPinChanged" Unchecked="OnPinChanged"
                          ToolTip="Matches historic PIN=1 in comm-port.ini (RTS/CTS style PTT path)"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#00FFAA" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
