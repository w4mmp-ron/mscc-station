            if (out_ch > 0) {
                build_output_devices((PaDeviceIndex)j);
                build_digital_output_devices((PaDeviceIndex)j);
            }
#else
            if (lpInfo->hostApi == apiTypeId) {
                build_output_devices((PaDeviceIndex)j);
                build_digital_output_devices((PaDeviceIndex)j);
            }
#endif
            if (in_ch < 1)
                continue;

            /* Digi / virtual cables / operator path — never I/Q */
            is_virtual =
                (strstr(n, "Loopback") != NULL || strstr(n, "aloop") != NULL ||
                 strstr(n, "MSCC_Cable") != NULL || strstr(n, "MSCC Cable") != NULL ||
                 strstr(n, "mscc_out") != NULL || strstr(n, "mscc_in") != NULL ||
                 strstr(n, "VB-Audio") != NULL || strstr(n, "CABLE") != NULL ||
                 strstr(n, "Null") != NULL ||
                 strstr(n, "audioinjector") != NULL || strstr(n, "AudioInjector") != NULL ||
                 (strncmp(n, "mscc", 4) == 0 || strncmp(n, "MSCC", 4) == 0));
            is_wrapper =
                (strstr(n, "sysdefault") != NULL || strstr(n, "dmix") != NULL ||
                 strstr(n, "dsnoop") != NULL || strstr(n, "front:") != NULL ||
                 strstr(n, "surround") != NULL || strstr(n, "iec958") != NULL ||
                 strstr(n, "hdmi") != NULL || strstr(n, "HDMI") != NULL ||
                 strcmp(n, "default") == 0 || strstr(n, "pulse") != NULL ||
                 strstr(n, "speex") != NULL || strstr(n, "upmix") != NULL ||
                 strstr(n, "vdownmix") != NULL);
            if (is_virtual || is_wrapper || in_ch > 8)
                continue;

            /* Transceiver I/Q only: Multus / Proficio product name */
            is_rig = (strstr(n, "Multus") != NULL || strstr(n, "multus") != NULL ||
                      strstr(n, "Proficio") != NULL || strstr(n, "proficio") != NULL ||
                      strstr(n, "PROFICIO") != NULL);
            /* Fallback: USB Audio hw: (Proficio when product string missing) */
            is_usb_hw =
                ((strstr(n, "USB") != NULL || strstr(n, "usb") != NULL) &&
                 strstr(n, "hw:") != NULL &&
                 (strstr(n, "Audio") != NULL || strstr(n, "CODEC") != NULL ||
                  strstr(n, "Codec") != NULL));

            /* Fixed priority — never scale by channel count (loopback 32/128) */
            score = 0;
            if (is_rig)
                score = 10000;
            else if (is_usb_hw && in_ch >= 2)
                score = 2000;
            else if (is_usb_hw && in_ch >= 1)
                score = 1500;
            if (score <= 0)
                continue;
            if (lpInfo->hostApi == apiTypeId)
                score += 50;
            if (in_ch >= 2)
                score += 20;
            if (out_ch >= 1 && out_ch <= 8)
                score += 5;

            print_time();
            fprintf(G_fp_logfile,
                "[%d] I/Q candidate score=%d in=%d out=%d api=%d name='%s'%s%s\n",
                line_number++, score, in_ch, out_ch, lpInfo->hostApi, n,
                is_rig ? " [rig]" : "", is_usb_hw ? " [usb]" : "");

            if (score > best_score) {
                best_score = score;
                recordDevice = (PaDeviceIndex)j;
                sel_reason = is_rig ? "Proficio/Multus I/Q radio" : "USB audio I/Q fallback";
                print_time();
                fprintf(G_fp_logfile,
                    "[%d] I/Q capture BEST so far: index=%d score=%d reason=%s name='%s'\n",
                    line_number++, j, score, sel_reason, n);
            }
        }
        if (recordDevice != paNoDevice && sel_reason != NULL) {
            print_time();
            fprintf(G_fp_logfile,
                "[%d] *** I/Q CAPTURE SELECTED: PaIndex=%d reason=%s ***\n",
                line_number++, (int)recordDevice, sel_reason);
        }
    }

    /* Fallbacks if ini names did not match any speaker */
    if (G_output_device_index == NO_OUTPUT_DEVICE) {
        PaDeviceIndex def_out = Pa_GetDefaultOutputDevice();
        if (def_out != paNoDevice) {
            for (j = 0; j < num_output_devices_found; j++) {
                if (G_output_devices[j].device_index == (int)def_out) {
                    G_output_device_index = j;
                    break;
                }
            }
            if (G_output_device_index == NO_OUTPUT_DEVICE && num_output_devices_found > 0)
                G_output_device_index = 0;
            print_time();
            fprintf(G_fp_logfile,
                "[%d] main. operator-speaker.ini unmatched (Windows name?) — "
                "using output slot %d name='%s'\n",
                line_number++, G_output_device_index,
                G_output_device_index != NO_OUTPUT_DEVICE &&
                    G_output_device_index < num_output_devices_found
                    ? G_output_devices[G_output_device_index].name
                    : "?");
        }
    }
    /* Do NOT fall back to digital slot 0 (often HDMI / first ALSA out).
     * D mode requires a real match to digital-speaker.ini (e.g. MSCC_Cable_Out). */
    if (G_digital_output_device_index == NO_OUTPUT_DEVICE) {
        print_time();
        fprintf(G_fp_logfile,
            "[%d] main. digital speaker NOT matched (ini='%s'). "
            "D mode will fail until MSCC_Cable_Out is visible to PortAudio.\n",
            line_number++,
            G_digital_audio_device[0] ? G_digital_audio_device : "(empty)");
        fflush(G_fp_logfile);
    } else {
        print_time();
        fprintf(G_fp_logfile,
            "[%d] main. digital speaker: slot=%d pa=%d ch=%d name='%s'\n",
            line_number++,
            G_digital_output_device_index,
            G_digital_output_devices[G_digital_output_device_index].device_index,
            G_digital_output_devices[G_digital_output_device_index].num_channels,
            G_digital_output_devices[G_digital_output_device_index].name);
        fflush(G_fp_logfile);
    }

    if (recordDevice == paNoDevice) {
        print_time();
        fprintf(G_fp_logfile,
            "[%d] No Proficio/Multus I/Q capture device found.\n"
            "     Need PortAudio name containing Proficio/Multus (radio I/Q), not operator mic or MSCC cable.\n"
            "     Check: arecord -l ; device list above must include 'Proficio: USB Audio (hw:...)'\n",
            line_number++);
        fflush(G_fp_logfile);
        Audio_Device_Error(err);
    }

    inputParameters.device = recordDevice;
    if (inputParameters.device == paNoDevice ||
        Pa_GetDeviceInfo(inputParameters.device) == NULL) {
        print_time();
        fprintf(G_fp_logfile, "[%d] Error: I/Q capture device not usable.\n", line_number++);
        Audio_Device_Error(err);
    }
    {
        const PaDeviceInfo *cap = Pa_GetDeviceInfo(inputParameters.device);
        /* Proficio I/Q is always stereo */
        inputParameters.channelCount = 2;
        inputParameters.sampleFormat = PA_SAMPLE_TYPE;
        inputParameters.suggestedLatency =
            cap ? cap->defaultLowInputLatency : 0.025f;
        inputParameters.hostApiSpecificStreamInfo = NULL;
        print_time();
        fprintf(G_fp_logfile,
            "[%d] main. I/Q CAPTURE open: PaIndex=%d ch=%d name='%s' rate=%d\n",
            line_number++, (int)recordDevice, inputParameters.channelCount,
            cap->name ? cap->name : "?", (int)mystate.samplerate);
        fflush(G_fp_logfile);
    }

    if (G_digital_output_device_index == NO_OUTPUT_DEVICE) {
        print_time();
        fprintf(G_fp_logfile, "[%d] main. Warning: no digital output device matched\n",
            line_number++);
    }
    if (G_output_device_index == NO_OUTPUT_DEVICE) {
        print_time();
        fprintf(G_fp_logfile, "[%d] main. Error: no operator speaker / output device\n",
            line_number++);
        Audio_Device_Error(err);
    } else {
        print_time();
        fprintf(G_fp_logfile,
            "[%d] main. Opening FULL-DUPLEX stream:\n"
            "     CAPTURE  PaIndex=%d ch=%d name='%s'\n"
            "     PLAYBACK PaIndex=%d ch=%d name='%s'\n",
            line_number++,
            (int)inputParameters.device,
            inputParameters.channelCount,
            Pa_GetDeviceInfo(inputParameters.device)->name,
            G_output_devices[G_output_device_index].device_index,
            G_output_devices[G_output_device_index].num_channels,
            G_output_devices[G_output_device_index].name);
        fflush(G_fp_logfile);
        status = manage_stream(1, G_output_devices[G_output_device_index].device_index,
                G_output_devices[G_output_device_index].num_channels);
        if (status) {
            err = status;
            print_time();
            fprintf(G_fp_logfile, "[%d] main. manage_stream FAILED status=%d\n",
                line_number++, status);
            Audio_Device_Error(err);
        } else {
            print_time();
            fprintf(G_fp_logfile, "[%d] main. Audio stream STARTED OK (I/Q + speaker)\n",
                line_number++);
            fflush(G_fp_logfile);
        }
    }

    while (G_all_threads_run) {
        Sleep(100);
    }
    if (stream != NULL) {
        err = Pa_CloseStream(stream);
        if (err != paNoError)
            Audio_Device_Error(err);
    }
    Sleep(100);
    Pa_Terminate();
    exit(0);
}

