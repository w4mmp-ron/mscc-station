 764   1              {
 765   2                      regValue |= 0x00u;
 766   2              }
 767   1              else
 768   1              {
 769   2                      regValue &= (uint8)~0x00u;
 770   2              }
 771   1              CY_SET_REG8((void CYXDATA *)CYREG_PUMP_CR0, regValue);
 772   1      }
