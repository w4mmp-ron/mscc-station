 514          /*
 515           * si5351_output_enable(enum si5351_clock clk, uint8_t enable)
 516           *
 517           * Enable or disable a chosen clock
 518           * clk - Clock output
 519           *   (use the si5351_clock enum)
 520           * enable - Set to 1 to enable, 0 to disable
 521           */
 522          void si5351_output_enable(enum si5351_clock clk, uint8_t enable)
 523          {
 524   1              uint8_t reg_val;
 525   1      
 526   1              if(si5351_read(SI5351_OUTPUT_ENABLE_CTRL, &reg_val) != 0)
 527   1              {
 528   2                      return;
 529   2              }
 530   1      
 531   1              if(enable == 1)
 532   1              {
 533   2                      reg_val &= ~(1<<(uint8_t)clk);
 534   2              }
 535   1              else
 536   1              {
 537   2                      reg_val |= (1<<(uint8_t)clk);
