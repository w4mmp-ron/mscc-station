  80   3              } else { 
  81   3                  Band_Control_Write(CONTROL_BAND_160); // 160M LPF - This does not set a relay. All relays off
  82   3              }
  83   2              //Inhibit transmitter as necessary
  84   2              //Allow TX only on the ham bands to keep the FCC happy
  85   2              //Also Set the Band Indicator and PCM3060 Output Volume
  86   2              TX_Inhibit = 1;//Default to disable TX
