              !\I2S:bI2S:rx_overflow_sticky\ * \I2S:bI2S:rxenable\
            + \I2S:bI2S:ctrl_reg_out_2\ * \I2S:bI2S:count_1\ * 
              !\I2S:bI2S:rx_overflow_sticky\ * \I2S:bI2S:rxenable\
        );
        Output = \I2S:bI2S:rxenable\ (fanout=4)

