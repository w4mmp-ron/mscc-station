 197   1          uint8 multi_status;
 198   1          static int8 l_ppm_int;
 199   1          static int8 l_ppm_dec;
 200   1           
 201   1          switch(state){
 202   2              case 0:
 203   2                  switch(E_PPM_needs_set){  //When the PPM has changed the LO needs bumped for it to take immedi
             -ate effect
 204   3                      case 0:
 205   3                          E_l_freq_temp = LO_freq;
 206   3                          break;
 207   3                      case E_PPM_NEEDS_SET_STEP_1:
 208   3                          E_l_freq_temp = LO_freq + 100;
 209   3                          E_PPM_needs_set = E_PPM_NEEDS_SET_STEP_2;
 210   3                          break;
 211   3                      case E_PPM_NEEDS_SET_STEP_2:
 212   3                          E_l_freq_temp = LO_freq;
 213   3                          E_PPM_needs_set = 0;
 214   3                          break;
 215   3                  }
 216   2                  if(!TX_Request){
 217   3                      if(freq_previous != (E_l_freq_temp + E_current_rit_freq)){
 218   4                          //E_l_freq = (LO_freq + E_current_rit_freq);
 219   4                          E_l_freq = (E_l_freq_temp + E_current_rit_freq);
 220   4                          freq_previous = E_l_freq;
 221   4                          state++;
 222   4                      }
 223   3                  }else{
 224   3                      if(freq_previous != E_l_freq_temp){
 225   4                          E_l_freq = E_l_freq_temp;
 226   4                          freq_previous = E_l_freq_temp;
 227   4                          state++;
 228   4                      }
 229   3                  }
 230   2                  break;
 231   2              case 1:
 232   2                  //This applies both the main PPM adjustment and drift frequency and then calculates the freque
             -ncy adjustment 
 233   2                  l_ppm_int = ee_ppm_int;
 234   2                  l_ppm_dec = ee_ppm_dec;
 235   2                  ppm = (float)((float)l_ppm_dec / 100);
C51 COMPILER V9.51   SI5351A                                                               11/29/2024 11:36:25 PAGE 5   

 236   2                  ppm = ppm + (float) l_ppm_int;
 237   2                  delta_freq = (float)E_l_freq / 1000000; 
 238   2                  delta_freq = ((delta_freq * ppm) * 4) * -1;
 239   2                  delta_freq_int = (int32)delta_freq;
 240   2                  //Frequencies must always multiples of 4
 241   2                  //while((delta_freq_int%4) != 0){
 242   2                  //    delta_freq_int++;
 243   2                  //}
 244   2                  if(delta_freq_int < 0){
 245   3                      while((delta_freq_int%4) !=0){
 246   4                          delta_freq_int++;
 247   4                      }
 248   3                  }else {
 249   3                      if(delta_freq_int > 0){
 250   4                          while((delta_freq_int%4) != 0){
 251   5                              delta_freq_int--;
 252   5                          }
 253   4                      }
 254   3                  }
 255   2                  //Now set the frequency for the Si5351 which four (4) times the LO sent by the host
 256   2                  E_l_freq = E_l_freq * 4;
 257   2                  //Now add the PPM correction
 258   2                  E_l_freq = E_l_freq + delta_freq_int;  
 259   2                      divider = 900000000 / E_l_freq;   // Calculate the division ratio. 900,000,000 is the maximum int
             -ernal 
 260   2                                                                                      // PLL frequency: 900MHz
 261   2                      if (divider % 2) divider--;             // Ensure an even integer division ratio
 262   2                                                  // Calculate the pllFrequency: the divider * desired output fr
             -equency
 263   2         
 264   2                      pllFreq = divider * E_l_freq; 
 265   2      
 266   2                      mult = pllFreq / xtalFreq;              // Determine the multiplier to get to the required pllFrequency
 267   2                      l = pllFreq % xtalFreq;                 // It has three parts:
 268   2                      f = l;                                                  // mult is an integer that must be in the range 15..90
 269   2                      f *= 1048575;                                   // num and denom are the fractional parts, the numerator and denominator
 270   2                      f /= xtalFreq;                                  // each is 20 bits (range 0..1048575)
