                      I2C_DISPLAY_COUNTER_AUX_CTL_REG |= I2C_DISPLAY_CNT7_ENABLE;
                      CyExitCriticalSection(intState);
                  #endif /* (I2C_DISPLAY_MODE_SLAVE_ENABLED) */
              
                  /* Enable slave or master bits */
                  I2C_DISPLAY_CFG_REG |= I2C_DISPLAY_ENABLE_MS;
              #endif /* (I2C_DISPLAY_FF_IMPLEMENTED) */
 154   1      
 155   1      #if (I2C_DISPLAY_TIMEOUT_ENABLED)
                  I2C_DISPLAY_TimeoutEnable();
              #endif /* (I2C_DISPLAY_TIMEOUT_ENABLED) */
