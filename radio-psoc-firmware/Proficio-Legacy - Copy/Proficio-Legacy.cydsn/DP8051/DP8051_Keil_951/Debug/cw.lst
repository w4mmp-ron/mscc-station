 163          uint8 keyer_write(uint8_t buffer)
 164          {
 165   1              uint8_t msg_buffer = 0;
 166   1              uint8_t ret_status = 0;
 167   1              uint8_t write_status = 0;
 168   1          uint8 buffer_written = 0;
 169   1          uint8 attempt;
 170   1      
 171   1          /*
 172   1           * PIC may NACK while busy (e.g. EEPROM write on STORE_END). Retry a few
 173   1           * times so a following PLAY is not dropped and keyer not marked missing.
 174   1           */
C51 COMPILER V9.51   CW                                                                    10/26/2026 10:09:12 PAGE 4   

 175   1          msg_buffer = buffer;
 176   1          for (attempt = 0; attempt < 8u; attempt++) {
 177   2              write_status = I2C_DISPLAY_MasterWriteBuf(KEYER_SLAVE_ADDRESS, &msg_buffer, 1u,
 178   2                  I2C_DISPLAY_MODE_COMPLETE_XFER);
 179   2              while ((I2C_DISPLAY_MasterStatus() & I2C_DISPLAY_MSTAT_WR_CMPLT) == 0u) {
 180   3              }
 181   2              buffer_written = I2C_DISPLAY_MasterGetWriteBufSize();
 182   2              if (buffer_written == 1u) {
 183   3                  ret_status = 1;
 184   3                  break;
 185   3              }
 186   2              CyDelay(5u);
 187   2          }
 188   1          return ret_status;
 189   1      }
