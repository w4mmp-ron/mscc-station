008D7F 9043BC            MOV      DPTR,#043BCH
008D82 E0                MOVX     A,@DPTR
008D83 4410              ORL      A,#010H
008D85 F0                MOVX     @DPTR,A
008D86         ?C0085?CYFLASH:
  695: 
  696:     while(0u == (CY_FLASH_SPC_FM_EE_CR_REG & CY_FLASH_EE_EE_AWAKE))
008D86 904700            MOV      DPTR,#04700H
008D89 E0                MOVX     A,@DPTR
008D8A 5420              ANL      A,#020H
008D8C 60F8              JZ       ?C0085?CYFLASH
  697:     {
  698:         /* Non-zero status denotes that the EEPROM/Flash is awake & powered. */
  699:     }
008D8E         ?C0086?CYFLASH:
