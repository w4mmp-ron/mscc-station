  57   2                      P1 = (uint32)(128 * (uint32)(mult) + P1 - 512);
  58   2                      P2 = (uint32)(128 * ((float)num / (float)denom));
  59   2                      P2 = (uint32)(128 * num - denom * P2);
  60   2                      P3 = denom;
  61   2                  si5351_write_init(pll + 0, (P3 & 0x0000FF00) >> 8);
