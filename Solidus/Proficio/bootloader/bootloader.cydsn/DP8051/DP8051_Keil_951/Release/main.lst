  63          CY_ISR(morse_interrupt)
  64          {
  65   1          static uint8 pos = 0, state = 0, codes, len, timer;
  66   1      
  67   1          switch (state) {
  68   2          case 0:
  69   2              codes = message[pos++];
  70   2              len = codes & 0x07;
  71   2              if (!codes) {
  72   3                  pos = 0;
  73   3                  timer = MORSE_WORD - MORSE_CHAR - 2;
  74   3                  len = 0;
  75   3                  state = 3;
  76   3                  break;
  77   3              }
  78   2          case 1:
  79   2              if (codes & 0x80) timer = MORSE_DASH;
  80   2              else timer = MORSE_DOT;
  81   2              codes <<= 1;
  82   2              len--;
  83   2              Control_Write(Control_Read() & ~CONTROL_LED);
  84   2              state = 2;
  85   2          case 2:
  86   2              if (!timer) {
  87   3                  state = 3;
  88   3                  if (!len) timer = MORSE_CHAR - 1;
  89   3                  else timer = MORSE_DOT - 1;
  90   3                  Control_Write(Control_Read() | CONTROL_LED);
  91   3              }
  92   2              else {
  93   3                  timer--;
  94   3                  break;
  95   3              }
  96   2          case 3:
  97   2              if (!timer) {
  98   3                  if (!len) state = 0;
  99   3                  else state = 1;
 100   3              }
 101   2              else timer--;
 102   2          }
 103   1      }
 104              
 105          void main()
