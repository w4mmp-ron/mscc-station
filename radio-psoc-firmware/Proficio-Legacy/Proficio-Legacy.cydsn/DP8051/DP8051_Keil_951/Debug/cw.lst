 146          /* Main loop only (I2C): PCM3060 DAC soft mute on / off */
 147          static void cw_dac_mute(uint8 mute)
 148          {
 149   1          PCM3060_SetRegister(PCM3060_REG_DAC_MUTE, mute ? PCM3060_DAC_MUTE_ON : PCM3060_DAC_MUTE_OFF);
 150   1          dac_muted = mute;
 151   1      }
 152          
 153          /* Main loop, on leaving CW: stop the ISR before DIN is reopened; DAC back to full for SSB */
 154          void CW_Key_Delay_Stop(void)
 155          {
 156   1          key_delay_active = FALSE;
 157   1          key_delay_busy = FALSE;
 158   1          rf_on = FALSE;
 159   1          dac_req = DAC_REQ_NONE;
 160   1          if(dac_muted) cw_dac_mute(FALSE);
 161   1      }
 162          
 163          /* Main loop only (I2C): DAC soft mute for the PTT / TUNE path in tx.c (1.236, as MKII 3.241).
 164           * Shares dac_muted with CW so both paths agree on the PCM3060 state. */
 165          void TX_DAC_Mute(uint8 mute)
 166          {
 167   1          if(dac_muted != mute) cw_dac_mute(mute);
 168   1      }
