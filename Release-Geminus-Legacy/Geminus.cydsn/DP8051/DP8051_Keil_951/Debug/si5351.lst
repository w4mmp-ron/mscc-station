 579          /*
 580           * si5351_set_correction(int32_t corr)
 581           *
 582           * Use this to set the oscillator correction factor to
 583           * EEPROM. This value is a signed 32-bit integer of the
 584           * parts-per-10 million value that the actual oscillation
 585           * frequency deviates from the specified frequency.
 586           *
 587           * The frequency calibration is done as a one-time procedure.
 588           * Any desired test frequency within the normal range of the
 589           * Si5351 should be set, then the actual output frequency
 590           * should be measured as accurately as possible. The
 591           * difference between the measured and specified frequencies
 592           * should be calculated in Hertz, then multiplied by 10 in
 593           * order to get the parts-per-10 million value.
 594           *
 595           * Since the Si5351 itself has an intrinsic 0 PPM error, this
 596           * correction factor is good across the entire tuning range of
 597           * the Si5351. Once this calibration is done accurately, it
 598           * should not have to be done again for the same Si5351 and
 599           * crystal.
 600           */
 601          /*void si5351_set_correction(int32 corr)
 602          {
 603                  //xtal_freq = (uint32)(xtal_freq + (corr * (xtal_freq / 10000000UL)));
 604                  ee_ppm_int = (int16)corr;
 605          }*/
