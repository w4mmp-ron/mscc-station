008C95 9043BC            MOV      DPTR,#043BCH
008C98 E0                MOVX     A,@DPTR
008C99 4410              ORL      A,#010H
008C9B F0                MOVX     @DPTR,A
008C9C         ?C0085?CYFLASH:
  695: 
  696:     while(0u == (CY_FLASH_SPC_FM_EE_CR_REG & CY_FLASH_EE_EE_AWAKE))
008C9C 904700            MOV      DPTR,#04700H
008C9F E0                MOVX     A,@DPTR
008CA0 5420              ANL      A,#020H
008CA2 60F8              JZ       ?C0085?CYFLASH
  697:     {
  698:         /* Non-zero status denotes that the EEPROM/Flash is awake & powered. */
  699:     }
008CA4         ?C0086?CYFLASH:
