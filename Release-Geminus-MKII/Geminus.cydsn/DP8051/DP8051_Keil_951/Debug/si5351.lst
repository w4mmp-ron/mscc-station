 511          /*
 512           * si5351_output_enable(enum si5351_clock clk, uint8_t enable)
 513           *
 514           * Enable or disable a chosen clock
 515           * clk - Clock output
 516           *   (use the si5351_clock enum)
 517           * enable - Set to 1 to enable, 0 to disable
 518           */
 519          void si5351_output_enable(enum si5351_clock clk, uint8_t enable)
 520          {
 521   1              uint8_t reg_val;
 522   1      
 523   1              if(si5351_read(SI5351_OUTPUT_ENABLE_CTRL, &reg_val) != 0)
 524   1              {
 525   2                      return;
 526   2              }
 527   1      
 528   1              if(enable == 1)
 529   1              {
 530   2                      reg_val &= ~(1<<(uint8_t)clk);
 531   2              }
 532   1              else
 533   1              {
 534   2                      reg_val |= (1<<(uint8_t)clk);
 535   2              }
