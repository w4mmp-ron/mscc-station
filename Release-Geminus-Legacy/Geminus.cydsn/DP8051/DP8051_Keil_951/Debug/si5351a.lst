 174          // 
 175          // Set CLK0 output ON and to the specified frequency
C51 COMPILER V9.51   SI5351A                                                               11/29/2024 11:36:25 PAGE 4   

 176          // Frequency is in the range 1MHz to 150MHz
 177          // Example: si5351aSetFrequency(10000000);
 178          // will set output CLK0 to 10MHz
 179          //
 180          // This example sets up PLL A
 181          // and MultiSynth 0
 182          // and produces the output on CLK0
 183          //
 184          //void si5351aSetFrequency(uint32 frequency,int8_t ppm_int,int8_t ppm_dec, uint8_t smooth)
 185          uint8 si5351aSetFrequency(uint32 LO_freq)
 186          {
 187   1              static uint32 pllFreq;
 188   1              uint32 xtalFreq = SI5351_XTAL_FREQ;
 189   1              static uint32 l;
 190   1              static uint8_t mult;
 191   1              static uint32 num,denom,divider;
