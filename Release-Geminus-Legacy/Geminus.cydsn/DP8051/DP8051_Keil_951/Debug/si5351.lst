 909          void si5351_update_sys_status(struct Si5351Status *status)
 910          {
 911   1              uint8_t reg_val = 0;
 912   1      
 913   1              if(si5351_read(SI5351_DEVICE_STATUS, &reg_val) != 0)
 914   1              {
 915   2                      return;
 916   2              }
 917   1      
 918   1              /* Parse the register */
C51 COMPILER V9.51   SI5351                                                                11/29/2024 11:36:26 PAGE 16  

 919   1              status->SYS_INIT = (reg_val >> 7) & 0x01;
 920   1              status->LOL_B = (reg_val >> 6) & 0x01;
 921   1              status->LOL_A = (reg_val >> 5) & 0x01;
 922   1              status->LOS = (reg_val >> 4) & 0x01;
 923   1              status->REVID = reg_val & 0x03;
 924   1      }
