 140          /* Main loop only (I2C): PCM3060 DAC soft mute on / off */
 141          static void cw_dac_mute(uint8 mute)
 142          {
 143   1          PCM3060_SetRegister(PCM3060_REG_DAC_MUTE, mute ? PCM3060_DAC_MUTE_ON : PCM3060_DAC_MUTE_OFF);
 144   1          dac_muted = mute;
 145   1      }
 146          
 147          /* Main loop, on leaving CW: stop the ISR before DIN is reopened; DAC back to full for SSB */
 148          void CW_Key_Delay_Stop(void)
 149          {
 150   1          key_delay_active = FALSE;
 151   1          key_delay_busy = FALSE;
 152   1          rf_on = FALSE;
 153   1          dac_req = DAC_REQ_NONE;
 154   1          if(dac_muted) cw_dac_mute(FALSE);
 155   1      }
