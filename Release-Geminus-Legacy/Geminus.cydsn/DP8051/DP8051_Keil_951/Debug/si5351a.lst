 163          //
 164          // Switches off Si5351a output
 165          // Example: si5351aOutputOff(SI_CLK0_CONTROL);
 166          // will switch off output CLK0
 167          //
 168          void si5351aOutputOff(uint8_t clk)
 169          {
 170   1              //si5351_write_queue(clk, 0x80);                // Refer to SiLabs AN619 to see bit values - 0x80 turns off the output 
             -stage
 171   1          si5351_write_init(clk, 0x80);
 172   1      }
