 267          uint32 swap32(uint32 original) CYREENTRANT {
 268   1          uint8 *r, *o;
 269   1          uint32 ret;
 270   1          r = (void*)&ret;
 271   1          o = (void*)&original;
 272   1          r[0] = o[3];
