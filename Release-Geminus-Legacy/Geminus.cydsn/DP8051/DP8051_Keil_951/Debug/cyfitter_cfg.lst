 577          /*******************************************************************************
 578          * Function Name: ClockSetup
 579          ********************************************************************************
 580          *
 581          * Summary:
 582          *  Performs the initialization of all of the clocks in the device based on the
 583          *  settings in the Clock tab of the DWR.  This includes enabling the requested
 584          *  clocks and setting the necessary dividers to produce the desired frequency. 
 585          *
C51 COMPILER V9.51   CYFITTER_CFG                                                          09/03/2026 15:23:32 PAGE 13  

 586          * Parameters:
 587          *  void
 588          *
 589          * Return:
 590          *  void
 591          *
 592          *******************************************************************************/
 593          static void ClockSetup(void);
