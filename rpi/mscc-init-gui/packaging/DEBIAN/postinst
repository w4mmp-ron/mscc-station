#!/bin/bash
set -e

resolve_user() {
  local u=""
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    u="$SUDO_USER"
  elif [[ -n "${PKEXEC_UID:-}" ]]; then
    u="$(getent passwd "$PKEXEC_UID" | cut -d: -f1 || true)"
  fi
  if [[ -z "$u" || "$u" == "root" ]]; then
    u="$(logname 2>/dev/null || true)"
  fi
  if [[ -z "$u" || "$u" == "root" ]]; then
    return 1
  fi
  echo "$u"
}

case "$1" in
configure)
  chmod 755 /usr/bin/mscc-init-gui 2>/dev/null || true
  find /usr/share/mscc-init-gui -type d -exec chmod 755 {} \; 2>/dev/null || true

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
  fi

  # Volume GUI dropped in 1.0.15: remove the copy older versions seeded in $HOME
  if REAL_USER="$(resolve_user)"; then
    HOME_DIR="$(getent passwd "$REAL_USER" | cut -d: -f6)"
    if [[ -n "$HOME_DIR" && -d "$HOME_DIR/mscc/mscc-volume-gui" ]]; then
      rm -rf "$HOME_DIR/mscc/mscc-volume-gui"
      echo "mscc-init-gui: removed old $HOME_DIR/mscc/mscc-volume-gui"
    fi
  fi

  echo
  echo "================================================================"
  echo "  mscc-init-gui $1"
  echo "================================================================"
  echo "  Desktop user (not root):"
  echo "    • Menu:  MSCC Init"
  echo "    • CLI:   mscc-init-gui"
  echo "  Config:  \$HOME/.local/mscc"
  echo "================================================================"
  echo
  ;;
esac
exit 0
