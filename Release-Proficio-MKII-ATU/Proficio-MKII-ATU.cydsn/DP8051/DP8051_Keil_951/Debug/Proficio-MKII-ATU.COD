00D1B2         ?C0044?CYSPC:
  461:         else
  462:         {
  463:             status = CYRET_CANCELED;
00D1B2 7D09              MOV      R5,#09H
  464:         }
  465:     }
00D1B4 8002              SJMP     ?C0046?CYSPC
00D1B6         ?C0043?CYSPC:
  466:     else
  467:     {
  468:         status = CYRET_LOCKED;
00D1B6 7D04              MOV      R5,#04H
  469:     }
00D1B8         ?C0046?CYSPC:
  470: 
  471:     return(status);
00D1B8 AF05              MOV      R7,AR5
  472: }
00D1BA 22                RET      
----- FUNCTION _CySpcWriteRow (END) -------


