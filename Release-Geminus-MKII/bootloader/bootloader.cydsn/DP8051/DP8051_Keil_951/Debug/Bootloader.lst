1321          /*******************************************************************************
1322          * Function Name: Bootloader_ValidateBootloadable
1323          ****************************************************************************//**
1324          * \brief
1325          *  Performs the Bootloadable application validation by calculating the
1326          *  application image checksum and comparing it with the checksum value stored
1327          *  in the Bootloadable Application Checksum field of the metadata section.
1328          *
1329          *  If the "Fast bootloadable application validation" option is enabled in the
1330          *  component customizer and Bootloadable application successfully passes
1331          *  validation, the Bootloadable Application Verification Status field of the
1332          *  metadata section is updated. Refer to the "Metadata Layout" section for the
1333          *  details.
1334          *
1335          *  If the "Fast bootloadable application validation" option is enabled and
1336          *  the Bootloadable Application Verification Status field of the metadata section
1337          *  claims that the Bootloadable application is valid, the function returns
1338          *  CYRET_SUCCESS without further checksum calculation.
1339          *
1340          *  \param appId
1341          *  The number of the Bootloadable application should be 0 for the normal
1342          *  bootloader and 0 or 1 for the dual-application bootloader.
1343          *
1344          * \return
1345          *  CYRET_SUCCESS - If the specified the Bootloadable application is valid.
1346          *  CYRET_BAD_DATA is returned if the input parameter is out of the specified range
1347          *      or the calculated checksum does not match the stored checksum.
1348          *******************************************************************************/
1349          cystatus Bootloader_ValidateBootloadable(uint8 appId) CYSMALL \
1350          
1351              {
1352   1              uint32 CYDATA idx;
1353   1      
1354   1              uint32 CYDATA end   = Bootloader_FIRST_APP_BYTE(appId) +
1355   1                                    Bootloader_GetMetadata(Bootloader_GET_BTLDB_LENGTH, appId);
1356   1      
1357   1              CYBIT  valid = 0u; /* Assume bad flash image */
1358   1              uint8  CYDATA calcedChecksum = 0u;
1359   1      
1360   1      
1361   1              #if(0u != Bootloader_DUAL_APP_BOOTLOADER)
              
                          if(appId > 1u)
                          {
                              return(CYRET_BAD_DATA);
                          }
              
                      #endif  /* (0u != Bootloader_DUAL_APP_BOOTLOADER) */
1369   1      
C51 COMPILER V9.51   BOOTLOADER                                                            12/15/2017 11:38:02 PAGE 24  

1370   1      
1371   1              #if(0u != Bootloader_FAST_APP_VALIDATION)
                          if(Bootloader_GetMetadata(Bootloader_GET_BTLDB_STATUS, appId) ==
                             Bootloader_MD_BTLDB_IS_VERIFIED)
                          {
                              return(CYRET_SUCCESS);
                          }
                      #endif  /* (0u != Bootloader_FAST_APP_VALIDATION) */
1378   1      
1379   1      
1380   1              /* Calculate checksum of bootloadable image */
1381   1              for(idx = Bootloader_FIRST_APP_BYTE(appId); idx < end; ++idx)
1382   1              {
1383   2                  uint8 CYDATA curByte = Bootloader_GET_CODE_BYTE(idx);
1384   2      
1385   2                  if((curByte != 0u) && (curByte != 0xFFu))
1386   2                  {
1387   3                      valid = 1u;
1388   3                  }
1389   2      
1390   2                  calcedChecksum += curByte;
1391   2              }
1392   1      
1393   1      
1394   1              /***************************************************************************
1395   1              * We do not compute a checksum over the meta data section, so no need to
1396   1              * subtract App Verified or App Active information here like we do when
1397   1              * verifying a row.
1398   1              ***************************************************************************/
1399   1      
1400   1              #if((!CY_PSOC4) && (CYDEV_ECC_ENABLE == 0u))
1401   1      
1402   1                  /* Add ECC data to checksum */
1403   1                  idx = ((Bootloader_FIRST_APP_BYTE(appId)) >> 3u);
1404   1      
1405   1                  /* Flash may run into meta data, so ECC does not use full row */
1406   1                  end = (end == (CY_FLASH_SIZE - Bootloader_MD_SIZEOF))
1407   1                      ? (CY_FLASH_SIZE >> 3u)
1408   1                      : (end >> 3u);
1409   1      
1410   1                  for (; idx < end; ++idx)
1411   1                  {
1412   2                      calcedChecksum += CY_GET_XTND_REG8((volatile uint8 *)(CYDEV_ECC_BASE + idx));
1413   2                  }
1414   1      
1415   1              #endif  /* ((!CY_PSOC4) && (CYDEV_ECC_ENABLE == 0u)) */
1416   1      
1417   1              calcedChecksum = ( uint8 )1u + ( uint8 )(~calcedChecksum);
1418   1      
1419   1              if((calcedChecksum != Bootloader_GetMetadata(Bootloader_GET_BTLDB_CHECKSUM, appId)) ||
1420   1                 (0u == valid))
1421   1              {
1422   2                  return(CYRET_BAD_DATA);
1423   2              }
1424   1      
1425   1      
1426   1              #if(0u != Bootloader_FAST_APP_VALIDATION)
                          Bootloader_SetFlashByte((uint32) Bootloader_MD_BTLDB_VERIFIED_OFFSET(appId),
                                                        Bootloader_MD_BTLDB_IS_VERIFIED);
                      #endif  /* (0u != Bootloader_FAST_APP_VALIDATION) */
1430   1      
1431   1      
C51 COMPILER V9.51   BOOTLOADER                                                            12/15/2017 11:38:02 PAGE 25  

1432   1              return(CYRET_SUCCESS);
1433   1      }
