<UserControl x:Class="MSCC.Wpf.Controls.AudioSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="640">
    <Border Background="#FF1A1A1A" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel>
            <TextBlock Text="Audio" FontWeight="Bold" Foreground="#00FFAA" FontSize="13" Margin="0,0,0,4"/>
            <TextBlock Text="Operator = phones path (P). Digital = digi path (D / VAC). Blank = not set — pick each device, then Apply (or change a dropdown to auto-save). Writes operator-*.ini / digital-*.ini under %LocalAppData%\MSCC-NET9\. After changes: Stop then Start. Operator Out + Mic are required before Start; digital is optional unless you use digi/VAC."
                       Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Operator (phones) -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Operator (phones)" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Out:" Width="36" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                        <ComboBox x:Name="OpSpeakerCombo" Width="220" Height="26" FontSize="11"
                                  Background="#111" Foreground="Black"
                                  SelectionChanged="OnSelectionChanged"
                                  ToolTip="operator-speaker.ini"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mic:" Width="36" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                        <ComboBox x:Name="OpMicCombo" Width="220" Height="26" FontSize="11"
                                  Background="#111" Foreground="Black"
                                  SelectionChanged="OnSelectionChanged"
                                  ToolTip="operator-microphone.ini — required by TX path even for some digi setups"/>
                    </StackPanel>
                </StackPanel>

                <!-- Digital -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Digital (VAC / digi)" FontSize="11" FontWeight="Bold" Foreground="#00FFAA" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Out:" Width="36" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                        <ComboBox x:Name="DigSpeakerCombo" Width="220" Height="26" FontSize="11"
                                  Background="#111" Foreground="Black"
                                  SelectionChanged="OnSelectionChanged"
                                  ToolTip="digital-speaker.ini (e.g. VB-Cable Input)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mic:" Width="36" VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                        <ComboBox x:Name="DigMicCombo" Width="220" Height="26" FontSize="11"
                                  Background="#111" Foreground="Black"
                                  SelectionChanged="OnSelectionChanged"
                                  ToolTip="digital-microphone.ini (e.g. VB-Cable Output)"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Refresh" Width="80" Height="26" FontSize="11" Click="OnRefreshClick"
                        ToolTip="Re-scan MME audio devices"/>
                <Button Content="Apply" Width="80" Height="26" Margin="8,0,0,0" FontSize="11" FontWeight="Bold"
                        Click="OnApplyClick"
                        ToolTip="Save all four audio INI files now"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#00FFAA" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
